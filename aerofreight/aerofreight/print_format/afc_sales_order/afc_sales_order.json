{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-10-14 19:54:07.376662",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<meta name=\"pdfkit-margin-top\" content=\"5mm\">\r\n<meta name=\"pdfkit-margin-bottom\" content=\"15mm\">\r\n<meta name=\"pdfkit-margin-left\" content=\"1mm\">\r\n<meta name=\"pdfkit-margin-right\" content=\"1mm\">\r\n<style>\r\n/* =========================================================\r\n   A4 COMPACT SALES ORDER\r\n   ========================================================= */\r\n@page {\r\n    size: A4;\r\n    margin: 0;\r\n}\r\n\r\nhtml,\r\nbody {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    width: 100% !important;\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 11px !important;\r\n    color: #222;\r\n    line-height: 1.3;\r\n}\r\n\r\n.print-format {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    max-width: 100% !important;\r\n}\r\n\r\n.so-page {\r\n    width: 100%;\r\n    margin: 0;\r\n    font-size: 11px !important;\r\n}\r\n\r\n/* ONE place that controls the side space */\r\n.so-page,\r\n#footer-html {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    padding-left: 20px !important;\r\n    padding-right: 20px !important;\r\n}\r\n/* =========================================================\r\n   GENERAL\r\n   ========================================================= */\r\n\r\n.so-page table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border-spacing: 0;\r\n    font-size: 11px !important;\r\n}\r\n\r\n.so-page td,\r\n.so-page th {\r\n    vertical-align: top;\r\n    font-size: 10.5px;\r\n}\r\n\r\n.text-left { text-align: left; }\r\n.text-center { text-align: center; }\r\n.text-right { text-align: right; }\r\n\r\np { margin: 0 0 2px 0; }\r\nimg { max-width: 100%; }\r\n\r\n/* =========================================================\r\n   LETTER HEAD / LOGO\r\n   ========================================================= */\r\n\r\n.letter-head {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    width: 100% !important;\r\n    height: auto !important;\r\n    margin: 0 !important;\r\n    padding: 30px 20px 0 20px !important;   /* top | right | bottom | left */\r\n}\r\n\r\n.letter-head img {\r\n    display: block;\r\n    width: 100% !important;\r\n    height: 130px !important;   /* use \"auto\" to keep the original proportions */\r\n}\r\n\r\n/* =========================================================\r\n   DOCUMENT INFORMATION\r\n   ========================================================= */\r\n\r\n.info-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin: 2px 0 4px 0;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.info-table td {\r\n    border: 1px solid #555;\r\n    padding: 3px 5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.info-label {\r\n    width: 15%;\r\n    font-weight: 700;\r\n    background: #f3f3f3;\r\n    font-size: 10px;\r\n    white-space: nowrap;\r\n}\r\n\r\n.info-value {\r\n    width: 35%;\r\n    font-size: 10.5px;\r\n}\r\n\r\n/* =========================================================\r\n   INTRODUCTION\r\n   ========================================================= */\r\n\r\n.intro-text {\r\n    margin: 3px 0 4px 0;\r\n    font-size: 11px;\r\n    font-weight: 600;\r\n    line-height: 1.15;\r\n}\r\n\r\n/* =========================================================\r\n   ITEMS\r\n   ========================================================= */\r\n\r\n.items-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin: 0;\r\n    page-break-inside: auto;\r\n}\r\n\r\n.items-table thead {\r\n    display: table-header-group;\r\n}\r\n\r\n.items-table tr {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.items-table th {\r\n    background: #f3f3f3;\r\n    border: 1px solid #555;\r\n    padding: 3px 4px;\r\n    font-size: 10px;\r\n    font-weight: 700;\r\n    line-height: 1.05;\r\n    color:#000;\r\n}\r\n\r\n.items-table td {\r\n    border: 1px solid #000;\r\n    padding: 3px 4px;\r\n    font-size: 10.5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n/* =========================================================\r\n   TOTALS\r\n   ========================================================= */\r\n.totals-wrapper {\r\n    margin-top: 3px;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.totals-table {\r\n    width: 42%;                      /* line length; change this to resize the line */\r\n    margin-left: auto;\r\n    border-collapse: collapse;\r\n}\r\n\r\n.totals-table td {\r\n    padding: 2px 5px;\r\n    font-size: 11px;\r\n    line-height: 1.05;\r\n    white-space: nowrap;\r\n}\r\n\r\n.total-label {\r\n    text-align: right;\r\n    color: #555;\r\n    padding-right: 10px !important;  /* gap between label and value */\r\n}\r\n\r\n.totals-table td.text-right {\r\n    width: 1%;                       /* value column only as wide as its content */\r\n    text-align: right;\r\n}\r\n\r\n.grand-total {\r\n    font-weight: 700;\r\n    font-size: 12px !important;\r\n    border-top: 1px solid #555;\r\n}\r\n\r\n/* =========================================================\r\n   AMOUNT IN WORDS\r\n   ========================================================= */\r\n\r\n.words-table {\r\n    margin-top: 3px;\r\n    border: 1px solid #ccc;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.words-table td {\r\n    padding: 3px 5px;\r\n    font-size: 10.5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.words-label {\r\n    width: 15%;\r\n    font-weight: 700;\r\n    white-space: nowrap;\r\n}\r\n\r\n/* =========================================================\r\n   EXCHANGE RATE\r\n   ========================================================= */\r\n\r\n.exchange-rate {\r\n    margin-top: 3px;\r\n    padding: 3px 4px;\r\n    border-top: 1px solid #555;\r\n    border-bottom: 1px solid #555;\r\n    font-size: 10.5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.exchange-title {\r\n    font-weight: 700;\r\n}\r\n\r\n/* =========================================================\r\n   ADDITIONAL INFORMATION\r\n   ========================================================= */\r\n\r\n.details-table {\r\n    margin-top: 3px;\r\n    border: 1px solid #ccc;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.details-table td {\r\n    border: 1px solid #ccc;\r\n    padding: 3px 5px;\r\n    font-size: 10px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.details-label {\r\n    width: 18%;\r\n    font-weight: 700;\r\n    background: #f7f7f7;\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n.details-value {\r\n    width: 32%;\r\n}\r\n\r\n/* =========================================================\r\n   TERMS AND CONDITIONS\r\n   ========================================================= */\r\n\r\n.terms {\r\n    margin-top: 4px;\r\n    font-size: 10px;\r\n    line-height: 1.1;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.terms-title {\r\n    font-weight: 700;\r\n    font-size: 11px;\r\n    margin-bottom: 2px;\r\n}\r\n\r\n/* =========================================================\r\n   APPROVAL / SIGNATURE\r\n   ========================================================= */\r\n\r\n.approval {\r\n    width: 100%;\r\n    margin-top: 4px;\r\n    border-top: 1px solid #555;\r\n    padding-top: 3px;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures {\r\n    width: 100% !important;\r\n    border-collapse: collapse !important;\r\n    border-spacing: 0 !important;\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    table-layout: auto !important;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures tr,\r\n.approval-signatures td {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures td {\r\n    text-align: center !important;\r\n    vertical-align: bottom !important;\r\n    border: none !important;\r\n    padding: 0 8px !important;\r\n}\r\n\r\n.approval-signature-image {\r\n    height: 32px;\r\n    width: 100%;\r\n    text-align: center;\r\n    vertical-align: bottom;\r\n    margin-bottom: 2px;\r\n    overflow: hidden;\r\n    scrollbar-width: none;\r\n    -ms-overflow-style: none;\r\n}\r\n\r\n.approval-signature-image::-webkit-scrollbar {\r\n    display: none;\r\n}\r\n\r\n.approval-signature-image img {\r\n    display: inline-block;\r\n    max-width: 105px !important;\r\n    max-height: 30px !important;\r\n    width: auto !important;\r\n    height: auto !important;\r\n    object-fit: contain;\r\n}\r\n\r\n.approval-user-name {\r\n    font-size: 10px;\r\n    font-weight: 700;\r\n    color: #222;\r\n    border-top: 1px solid #777;\r\n    padding-top: 2px;\r\n    line-height: 1.05;\r\n    white-space: normal;\r\n    word-wrap: break-word;\r\n}\r\n\r\n.approval-user-email {\r\n    font-size: 9px;\r\n    color: #666;\r\n    margin-top: 1px;\r\n    line-height: 1;\r\n    word-break: break-all;\r\n    white-space: normal;\r\n}\r\n\r\n/* =========================================================\r\n   PRINT / PDF SAFETY\r\n   ========================================================= */\r\n\r\ntable, tr, td, th {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.approval,\r\n.approval-signatures,\r\n.approval-signatures tr,\r\n.approval-signatures td,\r\n.details-table,\r\n.words-table,\r\n.totals-wrapper,\r\n.terms {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n</style>\r\n\r\n<!-- =======================================================\r\n     LETTER HEAD / LOGO\r\n     ======================================================= -->\r\n\r\n    <div id=\"header-html\" class=\"hidden-pdf\">\r\n        {% if letter_head and not no_letterhead %}\r\n            {{ letter_head }}\r\n        {% endif %}\r\n    </div>\r\n\r\n<!-- =======================================================\r\n     MAIN SALES ORDER\r\n     ======================================================= -->\r\n\r\n<div class=\"so-page\">\r\n\r\n    <!-- ===================================================\r\n         STATUS\r\n         =================================================== -->\r\n    <div class=\"text-center\">\r\n        <b style=\"font-size: 14px;\">Sales Order</b><br>\r\n        <b>{{ doc.status }}</b>\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         CUSTOMER / SO DETAILS (EXACT PO GRID MIRROR)\r\n         =================================================== -->\r\n\r\n    <table class=\"info-table\">\r\n        <tr>\r\n            <td class=\"info-label\">\r\n                {{ _(\"Customer\") }}\r\n            </td>\r\n            <td class=\"info-value\">\r\n                <b>{{ doc.customer_name or '' }}</b>\r\n            </td>\r\n            <td class=\"info-label\">\r\n                {{ _(\"Sales Order\") }}\r\n            </td>\r\n            <td class=\"info-value\">\r\n                <b>{{ doc.name or '' }}</b>\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"info-label\">\r\n                {{ _(\"Attention To\") }}\r\n            </td>\r\n            <td class=\"info-value\">\r\n                {{ doc.address_display or '' }}\r\n            </td>\r\n            <td class=\"info-label\">\r\n                {{ _(\"Order Date\") }}\r\n            </td>\r\n            <td class=\"info-value\">\r\n                {{ frappe.utils.format_date(doc.transaction_date) }}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"info-label\">\r\n                {{ _(\"Project Name\") }}\r\n            </td>\r\n            <td class=\"info-value\">\r\n                {% set project_name = frappe.db.get_value(\"Project\", doc.project, \"project_name\") if doc.project else None %}\r\n                {{ doc.project or '' }}{% if doc.project and project_name %} - {{ project_name }}{% endif %}\r\n            </td>\r\n            <td class=\"info-label\">\r\n                {{ _(\"Customer PO No\") }}\r\n            </td>\r\n            <td class=\"info-value\">\r\n                {{ doc.po_no or '' }}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"info-label\">\r\n                {{ _(\"Incoterms\") }}\r\n            </td>\r\n            <td class=\"info-value\">\r\n                {{ doc.incoterm or '' }}\r\n            </td>\r\n            <td class=\"info-label\">\r\n                {{ _(\"Delivery Date\") }}\r\n            </td>\r\n            <td class=\"info-value\">\r\n                {{ frappe.utils.format_date(doc.delivery_date) if doc.delivery_date else '' }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         INTRODUCTION\r\n         =================================================== -->\r\n\r\n    <div class=\"intro-text\">\r\n        <br>\r\n        This Sales Order is issued in confirmation of your order requirements for supply and delivery as detailed below:\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         ITEMS\r\n         =================================================== -->\r\n\r\n    <table class=\"items-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width:6%;\" class=\"text-center\">\r\n                    {{ _(\"No\") }}\r\n                </th>\r\n                <th style=\"width:18%;\" class=\"text-left\">\r\n                    {{ _(\"Item Code\") }}\r\n                </th>\r\n                <th style=\"width:18%;\" class=\"text-left\">\r\n                    {{ _(\"Item Name\") }}\r\n                </th>\r\n                <th style=\"width:21%;\" class=\"text-left\">\r\n                    {{ _(\"Description\") }}\r\n                </th>\r\n                <th style=\"width:2%;\" class=\"text-right\">\r\n                    {{ _(\"Qty\") }}\r\n                </th>\r\n                <th style=\"width:5%;\" class=\"text-right\">\r\n                    {{ _(\"UOM\") }}\r\n                </th>\r\n                <th style=\"width:15%;\" class=\"text-right\">\r\n                    {{ _(\"Rate\") }}\r\n                </th>\r\n                <th style=\"width:15%;\" class=\"text-right\">\r\n                    {{ _(\"Amount\") }}\r\n                </th>\r\n            </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n            {% for item in doc.items %}\r\n            <tr>\r\n                <td class=\"text-center\">\r\n                    {{ loop.index }}\r\n                </td>\r\n                <td>\r\n                    {{ item.item_code or '' }}\r\n                </td>\r\n                <td>\r\n                    {{ item.item_name or '' }}\r\n                </td>\r\n                <td>\r\n                    {{ item.description or '' }}\r\n                </td>\r\n                <td class=\"text-right\">\r\n                    {{ item.get_formatted(\"qty\", 0) }}\r\n                </td>\r\n                <td class=\"text-right\">\r\n                    {{ item.uom or '' }}\r\n                </td>\r\n                <td class=\"text-right\">\r\n                    {{ item.get_formatted(\"net_rate\", doc) }}\r\n                </td>\r\n                <td class=\"text-right\">\r\n                    {{ item.get_formatted(\"net_amount\", doc) }}\r\n                </td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         TOTALS\r\n         =================================================== -->\r\n\r\n    <div class=\"totals-wrapper\">\r\n        <table class=\"totals-table\">\r\n            <tr>\r\n                <td class=\"total-label\">\r\n                    {{ _(\"Sub Total\") }}\r\n                </td>\r\n                <td class=\"text-right\">\r\n                    {{ doc.get_formatted(\"total\", doc) }}\r\n                </td>\r\n            </tr>\r\n\r\n            {% if doc.apply_discount_on == \"Net Total\" and doc.discount_amount %}\r\n            <tr>\r\n                <td class=\"total-label\">\r\n                    {{ _(\"Discount\") }} ({{ doc.additional_discount_percentage }}%)\r\n                </td>\r\n                <td class=\"text-right\">\r\n                    {{ doc.get_formatted(\"discount_amount\", doc) }}\r\n                </td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% for tax in doc.taxes %}\r\n                {% if (tax.tax_amount or (print_settings and print_settings.print_taxes_with_zero_amount))\r\n                      and (not tax.included_in_print_rate or (doc.flags and doc.flags.show_inclusive_tax_in_print)) %}\r\n                <tr>\r\n                    <td class=\"total-label\">\r\n                        {{ tax.get_formatted(\"description\") }} ({{ tax.get_formatted(\"rate\") }}%)\r\n                    </td>\r\n                    <td class=\"text-right\">\r\n                        {{ tax.get_formatted(\"tax_amount\") }}\r\n                    </td>\r\n                </tr>\r\n                {% endif %}\r\n            {% endfor %}\r\n\r\n            {% if doc.apply_discount_on == \"Grand Total\" and doc.discount_amount %}\r\n            <tr>\r\n                <td class=\"total-label\">\r\n                    {{ _(\"Discount\") }} ({{ doc.additional_discount_percentage }}%)\r\n                </td>\r\n                <td class=\"text-right\">\r\n                    {{ doc.get_formatted(\"discount_amount\", doc) }}\r\n                </td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            <tr>\r\n                <td class=\"total-label grand-total\">\r\n                    {{ _(\"Grand Total\") }}\r\n                </td>\r\n                <td class=\"text-right grand-total\">\r\n                    {{ doc.get_formatted(\"grand_total\", doc) }}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         AMOUNT IN WORDS\r\n         =================================================== -->\r\n\r\n    <table class=\"words-table\">\r\n        <tr>\r\n            <td class=\"words-label\">\r\n                {{ _(\"Amount in Words\") }}\r\n            </td>\r\n            <td>\r\n                {{ doc.in_words or '' }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         EXCHANGE RATE\r\n         =================================================== -->\r\n\r\n    <div class=\"exchange-rate\">\r\n        <span class=\"exchange-title\">\r\n            {{ _(\"Applied Rates of Exchange\") }}:\r\n        </span>\r\n        <span>\r\n            {{ doc.currency }} @ {{ doc.conversion_rate or 1.0000 }}\r\n        </span>\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         ADDITIONAL INFORMATION / SHIPPING / COMMERCIAL\r\n         =================================================== -->\r\n\r\n    <table class=\"details-table\">\r\n        <tr>\r\n            <td class=\"details-label\">\r\n                {{ _(\"Shipping Address\") }}\r\n            </td>\r\n            <td class=\"details-value\">\r\n                {{ doc.shipping_address_name or '' }}\r\n                <br>\r\n                {{ doc.shipping_address or '' }}\r\n            </td>\r\n            <td class=\"details-label\">\r\n                {{ _(\"Payment Terms\") }}\r\n            </td>\r\n            <td class=\"details-value\">\r\n                {{ doc.payment_terms_template or '' }}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"details-label\">\r\n                {{ _(\"Origin Country\") }}\r\n            </td>\r\n            <td class=\"details-value\">\r\n                {{ doc.custom_origin_country or '' }}\r\n            </td>\r\n            <td class=\"details-label\">\r\n                {{ _(\"Export Documentation\") }}\r\n            </td>\r\n            <td class=\"details-value\">\r\n                {{ doc.custom_export_documentation or '' }}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"details-label\">\r\n                {{ _(\"Technical Documentation\") }}\r\n            </td>\r\n            <td class=\"details-value\">\r\n                {{ doc.custom_technical_documentation or '' }}\r\n            </td>\r\n            <td class=\"details-label\">\r\n                {{ _(\"Insurance\") }}\r\n            </td>\r\n            <td class=\"details-value\">\r\n                {{ doc.custom_insurance or '' }}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"details-label\">\r\n                {{ _(\"Country of Origin Documentation\") }}\r\n            </td>\r\n            <td class=\"details-value\">\r\n                {{ doc.custom_country_of_origin_documentation or '' }}\r\n            </td>\r\n            <td class=\"details-label\">\r\n                {{ _(\"Shipping Marks\") }}\r\n            </td>\r\n            <td class=\"details-value\">\r\n                {{ doc.custom_shipping_marks or '' }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         TERMS AND CONDITIONS\r\n         =================================================== -->\r\n\r\n    {% if doc.terms %}\r\n    <div class=\"terms\">\r\n        <div class=\"terms-title\">\r\n            {{ _(\"Terms and Conditions\") }}\r\n        </div>\r\n        <div>\r\n            {{ doc.terms }}\r\n        </div>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ===================================================\r\n         APPROVAL / SIGNATURE (WORKFLOW LOG TRACKER)\r\n         =================================================== -->\r\n\r\n    <div class=\"approval\">\r\n        {% set all_approval = frappe.get_all(\r\n            \"Comment\",\r\n            filters={\r\n                \"comment_type\": \"Workflow\",\r\n                \"reference_doctype\": \"Sales Order\",\r\n                \"reference_name\": doc.name\r\n            },\r\n            fields=[\"comment_email\", \"creation\"],\r\n            order_by=\"creation asc\"\r\n        ) %}\r\n\r\n        <table class=\"approval-signatures\">\r\n            <tr>\r\n                {% for approval in all_approval %}\r\n                    {% if approval.comment_email %}\r\n                        {% set user_data = frappe.db.get_value(\r\n                            \"User\",\r\n                            approval.comment_email,\r\n                            [\"full_name\", \"email\", \"email_signature\"],\r\n                            as_dict=True\r\n                        ) %}\r\n\r\n                        {% if user_data and user_data.email_signature %}\r\n                        <td>\r\n                            <div class=\"approval-signature-image\">\r\n                                {{ user_data.email_signature | safe }}\r\n                            </div>\r\n                            <div class=\"approval-user-name\">\r\n                                {{ user_data.full_name or approval.comment_email }}\r\n                            </div>\r\n                            <div class=\"approval-user-email\">\r\n                                {{ user_data.email or approval.comment_email }}\r\n                            </div>\r\n                        </td>\r\n                        {% endif %}\r\n                    {% endif %}\r\n                {% endfor %}\r\n            </tr>\r\n        </table>\r\n    </div>\r\n</div>\r\n<div id=\"footer-html\" class=\"visible-pdf\">\r\n    <table style=\"width:100%; border-top:1px solid #999; border-collapse:collapse;\r\n                  font-family:Arial, Helvetica, sans-serif; font-size:9px; color:#111;\">\r\n        <tr>\r\n            <td style=\"width:50%; text-align:left; padding-top:3px;\">\r\n                Page <span class=\"page\"></span> of <span class=\"topage\"></span>\r\n            </td>\r\n            <td style=\"width:50%; text-align:right; padding-top:3px;\">\r\n                Generated By {{ doc.owner }}\r\n                &nbsp;&nbsp;\r\n                {{ frappe.utils.format_datetime(doc.creation, \"dd-mm-yyyy HH:mm:ss\") }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</div>",
