{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-10-14 19:51:49.284040",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<meta name=\"pdfkit-margin-top\" content=\"5mm\">\r\n<meta name=\"pdfkit-margin-bottom\" content=\"15mm\">\r\n<meta name=\"pdfkit-margin-left\" content=\"1mm\">\r\n<meta name=\"pdfkit-margin-right\" content=\"1mm\">\r\n<style>\r\n/* =========================================================\r\n   A4 COMPACT SALES RETURN (CREDIT NOTE)\r\n   ========================================================= */\r\n@page {\r\n    size: A4;\r\n    margin: 0;\r\n}\r\n\r\nhtml,\r\nbody {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    width: 100% !important;\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 9.5px;\r\n    color: #222;\r\n    line-height: 1.2;\r\n}\r\n\r\n.print-format {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    max-width: 100% !important;\r\n}\r\n\r\n.sr-page {\r\n    width: 100%;\r\n    margin: 0;\r\n}\r\n\r\n/* ONE place that controls the side space */\r\n.sr-page,\r\n#footer-html {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    padding-left: 20px !important;\r\n    padding-right: 20px !important;\r\n}\r\n/* =========================================================\r\n   GENERAL\r\n   ========================================================= */\r\n\r\n.sr-page table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border-spacing: 0;\r\n}\r\n\r\n.sr-page td,\r\n.sr-page th {\r\n    vertical-align: top;\r\n}\r\n\r\n.text-left { text-align: left; }\r\n.text-center { text-align: center; }\r\n.text-right { text-align: right; }\r\n\r\np { margin: 0 0 2px 0; }\r\nimg { max-width: 100%; }\r\n\r\n/* =========================================================\r\n   LETTER HEAD / LOGO\r\n   ========================================================= */\r\n\r\n.letter-head {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    width: 100% !important;\r\n    height: auto !important;\r\n    margin: 0 !important;\r\n    padding: 30px 20px 0 20px !important;   /* top | right | bottom | left */\r\n}\r\n\r\n.letter-head img {\r\n    display: block;\r\n    width: 100% !important;\r\n    height: 130px !important;\r\n}\r\n/* =========================================================\r\n   DOCUMENT INFORMATION\r\n   ========================================================= */\r\n\r\n.info-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin: 2px 0 4px 0;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.info-table td {\r\n    border: 1px solid #555;\r\n    padding: 3px 5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.info-label {\r\n    width: 16%;\r\n    font-weight: 700;\r\n    background: #f3f3f3;\r\n    font-size: 8.5px;\r\n    white-space: nowrap;\r\n}\r\n\r\n.info-value {\r\n    width: 34%;\r\n    font-size: 9px;\r\n}\r\n\r\n/* =========================================================\r\n   INTRODUCTION\r\n   ========================================================= */\r\n\r\n.intro-text {\r\n    margin: 3px 0 4px 0;\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    line-height: 1.15;\r\n}\r\n\r\n/* =========================================================\r\n   ITEMS\r\n   ========================================================= */\r\n\r\n.items-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin: 0;\r\n    page-break-inside: auto;\r\n}\r\n\r\n.items-table thead {\r\n    display: table-header-group;\r\n}\r\n\r\n.items-table tr {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.items-table th {\r\n    background: #f3f3f3;\r\n    border: 1px solid #555;\r\n    padding: 3px 4px;\r\n    font-size: 8.5px;\r\n    font-weight: 700;\r\n    line-height: 1.05;\r\n}\r\n\r\n.items-table td {\r\n    border: 1px solid #ccc;\r\n    padding: 3px 4px;\r\n    font-size: 9px;\r\n    line-height: 1.1;\r\n}\r\n\r\n/* =========================================================\r\n   TOTALS\r\n   ========================================================= */\r\n\r\n.totals-wrapper {\r\n    margin-top: 3px;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.totals-table {\r\n    width: 44%;\r\n    margin-left: auto;\r\n    border-collapse: collapse;\r\n    table-layout: fixed;\r\n}\r\n\r\n.totals-table td {\r\n    padding: 1px 5px;          /* reduced from 2px \u2014 tighter rows */\r\n    font-size: 9px;\r\n    line-height: 1;            /* reduced from 1.05 */\r\n    vertical-align: top;\r\n}\r\n\r\n.totals-table td:first-child {\r\n    width: 100%;                /* was 85% \u2014 fixed over-100% bug */\r\n    text-align: right;\r\n    padding-right: 4px;\r\n}\r\n\r\n.totals-table td:last-child {\r\n    width: 25%;                /* was 75% \u2014 fixed over-100% bug */\r\n    text-align: right;\r\n    white-space: nowrap;\r\n}\r\n\r\n.total-label {\r\n    text-align: right;\r\n    color: #555;\r\n}\r\n\r\n.grand-total {\r\n    font-weight: 700;\r\n    font-size: 10px !important;\r\n    border-top: 1px solid #555;\r\n    padding-top: 2px !important;   /* space above the border line */\r\n}\r\n\r\n/* =========================================================\r\n   AMOUNT IN WORDS\r\n   ========================================================= */\r\n\r\n.words-table {\r\n    margin-top: 3px;\r\n    border: 1px solid #ccc;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.words-table td {\r\n    padding: 3px 5px;\r\n    font-size: 9px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.words-label {\r\n    width: 16%;\r\n    font-weight: 700;\r\n    white-space: nowrap;\r\n}\r\n\r\n/* =========================================================\r\n   EXCHANGE RATE\r\n   ========================================================= */\r\n\r\n.exchange-rate {\r\n    margin-top: 3px;\r\n    padding: 3px 4px;\r\n    border-top: 1px solid #555;\r\n    border-bottom: 1px solid #555;\r\n    font-size: 9px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.exchange-title {\r\n    font-weight: 700;\r\n}\r\n\r\n/* =========================================================\r\n   ADDITIONAL INFORMATION\r\n   ========================================================= */\r\n\r\n.details-table {\r\n    margin-top: 3px;\r\n    border: 1px solid #ccc;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.details-table td {\r\n    border: 1px solid #ccc;\r\n    padding: 3px 5px;\r\n    font-size: 8.5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.details-label {\r\n    width: 18%;\r\n    font-weight: 700;\r\n    background: #f7f7f7;\r\n    font-size: 8px !important;\r\n}\r\n\r\n.details-value {\r\n    width: 32%;\r\n}\r\n\r\n/* =========================================================\r\n   TERMS AND CONDITIONS\r\n   ========================================================= */\r\n\r\n.terms {\r\n    margin-top: 4px;\r\n    font-size: 8.5px;\r\n    line-height: 1.1;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.terms-title {\r\n    font-weight: 700;\r\n    font-size: 9px;\r\n    margin-bottom: 2px;\r\n}\r\n\r\n/* =========================================================\r\n   APPROVAL / SIGNATURE\r\n   ========================================================= */\r\n\r\n.approval {\r\n    width: 100%;\r\n    margin-top: 6px;\r\n    border-top: 1px solid #555;\r\n    padding-top: 3px;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures {\r\n    width: 100% !important;\r\n    border-collapse: collapse !important;\r\n    border-spacing: 0 !important;\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    table-layout: fixed !important;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures tr,\r\n.approval-signatures td {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures td {\r\n    text-align: center !important;\r\n    vertical-align: bottom !important;\r\n    border: none !important;\r\n    padding: 0 12px !important;\r\n}\r\n\r\n.approval-signature-image {\r\n    height: 35px;\r\n    min-height: 35px;\r\n    width: 100%;\r\n    text-align: center;\r\n    vertical-align: bottom;\r\n    margin-bottom: 2px;\r\n    overflow: hidden;\r\n}\r\n\r\n.approval-signature-image img {\r\n    display: inline-block;\r\n    max-width: 110px !important;\r\n    max-height: 32px !important;\r\n    width: auto !important;\r\n    height: auto !important;\r\n    object-fit: contain;\r\n}\r\n\r\n.approval-user-name {\r\n    font-size: 8.5px;\r\n    font-weight: 700;\r\n    color: #222;\r\n    border-top: 1px solid #777;\r\n    padding-top: 2px;\r\n    line-height: 1.05;\r\n    white-space: normal;\r\n    word-wrap: break-word;\r\n}\r\n\r\n.approval-user-role {\r\n    font-size: 7.5px;\r\n    font-weight: 600;\r\n    color: #555;\r\n    line-height: 1;\r\n    margin-top: 1px;\r\n}\r\n\r\n.approval-user-email {\r\n    font-size: 7.5px;\r\n    color: #777;\r\n    margin-top: 1px;\r\n    line-height: 1;\r\n    word-break: break-all;\r\n    white-space: normal;\r\n}\r\n\r\n/* =========================================================\r\n   PRINT / PDF SAFETY\r\n   ========================================================= */\r\n\r\ntable, tr, td, th {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.approval,\r\n.approval-signatures,\r\n.approval-signatures tr,\r\n.approval-signatures td,\r\n.details-table,\r\n.words-table,\r\n.totals-wrapper,\r\n.terms {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n</style>\r\n\r\n<!-- =======================================================\r\n     LETTER HEAD / LOGO\r\n     ======================================================= -->\r\n\r\n{% if letter_head and not no_letterhead %}\r\n<div>\r\n    {{ letter_head }}\r\n</div>\r\n{% endif %}\r\n\r\n<!-- =======================================================\r\n     MAIN SALES RETURN\r\n     ======================================================= -->\r\n\r\n<div class=\"sr-page\">\r\n\r\n    <!-- ===================================================\r\n         STATUS\r\n         =================================================== -->\r\n        \r\n        \r\n        \r\n        {# ================= DOCTYPE ================= #}\r\n        <br>\r\n        <div class=\"text-center\" style=\"font-size: 14px; font-weight: 500; margin-top: 2px; margin-bottom: 4px;\">\r\n            \u0645\u0631\u062f\u0648\u062f\u0627\u062a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a / SALES RETURN\r\n            <br>{{doc.status}}\r\n        </div>\r\n\r\n    <!-- ===================================================\r\n         CUSTOMER / DOCUMENT DETAILS\r\n         =================================================== -->\r\n\r\n    {# Dynamic Address Resolution #}\r\n    {% set customer_addr = doc.address_display %}\r\n    {% if not customer_addr and doc.customer_address %}\r\n        {% set customer_addr = frappe.db.get_value(\"Address\", doc.customer_address, \"display\") %}\r\n    {% endif %}\r\n\r\n    <table class=\"info-table\">\r\n        <tr>\r\n            <td class=\"info-label\">{{ _(\"Customer\") }}</td>\r\n            <td class=\"info-value\"><b>{{ doc.customer_name or '' }}</b></td>\r\n            <td class=\"info-label\">{{ _(\"Return Note No\") }}</td>\r\n            <td class=\"info-value\"><b>{{ doc.name or '' }}</b></td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"info-label\">{{ _(\"Attention To\") }}</td>\r\n            <td class=\"info-value\">\r\n                {% if doc.contact_display %}\r\n                    <b>{{ doc.contact_display }}</b><br>\r\n                {% endif %}\r\n                {{ customer_addr | safe if customer_addr else '' }}\r\n            </td>\r\n            <td class=\"info-label\">{{ _(\"Return Date\") }}</td>\r\n            <td class=\"info-value\">\r\n                {{ frappe.utils.format_date(doc.posting_date) }}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"info-label\">{{ _(\"Against Invoice\") }}</td>\r\n            <td class=\"info-value\">\r\n                <b>{{ doc.return_against or '' }}</b>\r\n            </td>\r\n            <td class=\"info-label\">{{ _(\"Customer PO No\") }}</td>\r\n            <td class=\"info-value\">{{ doc.po_no or '' }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"info-label\">{{ _(\"Project Name\") }}</td>\r\n            <td class=\"info-value\">\r\n                {% set project_name = frappe.db.get_value(\"Project\", doc.project, \"project_name\") if doc.project else None %}\r\n                {{ doc.project or '' }}{% if doc.project and project_name %} - {{ project_name }}{% endif %}\r\n            </td>\r\n            <td class=\"info-label\">{{ _(\"Debit Note No & Date\") }}</td>\r\n            <td class=\"info-value\">\r\n                {{ doc.bill_no or '' }}\r\n                {% if doc.bill_date %} (dt. {{ frappe.utils.format_date(doc.bill_date) }}){% endif %}\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"info-label\">{{ _(\"Remarks\") }}</td>\r\n            <td class=\"info-value\">\r\n                \r\n            </td>\r\n            <td class=\"info-label\">{{ _(\"Sales Person\") }}</td>\r\n            <td class=\"info-value\">\r\n                {{doc.sales_team[0].sales_person or ''}}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         INTRODUCTION\r\n         =================================================== -->\r\n\r\n    <div class=\"intro-text\">\r\n        Credit Note acknowledging inward return and financial adjustment for items listed below:\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         ITEMS\r\n         =================================================== -->\r\n\r\n    <table class=\"items-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width:6%;\" class=\"text-center\">{{ _(\"No\") }}</th>\r\n                <th style=\"width:18%;\" class=\"text-left\">{{ _(\"Item Code\") }}</th>\r\n                <th style=\"width:30%;\" class=\"text-left\">{{ _(\"Item Name\") }}</th>\r\n                <th style=\"width:14%;\" class=\"text-left\">{{ _(\"Target Whse\") }}</th>\r\n                <th style=\"width:10%;\" class=\"text-right\">{{ _(\"Returned Qty\") }}</th>\r\n                <th style=\"width:11%;\" class=\"text-right\">{{ _(\"Rate\") }}</th>\r\n                <th style=\"width:11%;\" class=\"text-right\">{{ _(\"Credit Amount\") }}</th>\r\n            </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n            {% for item in doc.items %}\r\n            <tr>\r\n                <td class=\"text-center\">{{ loop.index }}</td>\r\n                <td>\r\n                    <b>{{ item.item_code or '' }}</b>\r\n                    {% if item.batch_no or item.serial_no %}\r\n                        <div style=\"font-size: 7.5px; color: #555;\">\r\n                            {% if item.batch_no %}Batch: {{ item.batch_no }} {% endif %}\r\n                        </div>\r\n                    {% endif %}\r\n                </td>\r\n                <td>\r\n                    {{ item.item_name or '' }}\r\n                    {% if item.description and item.description != item.item_name %}\r\n                        <div style=\"font-size: 8px; color: #666;\">{{ item.description | striptags }}</div>\r\n                    {% endif %}\r\n                </td>\r\n                <td>{{ item.warehouse or '' }}</td>\r\n                <td class=\"text-right\">\r\n                    {# Format quantity positively for clean return receipt presentation #}\r\n                    <b>{{ (item.qty | abs) }}</b> {{ item.uom or '' }}\r\n                </td>\r\n                <td class=\"text-right\">{{ item.get_formatted(\"net_rate\", doc) or item.get_formatted(\"rate\", doc) }}</td>\r\n                <td class=\"text-right\">\r\n                    {# Format net amount positively for credit display #}\r\n                    {{ item.get_formatted(\"net_amount\", doc) or item.get_formatted(\"amount\", doc) }}\r\n                </td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         TOTALS\r\n         =================================================== -->\r\n\r\n    <div class=\"totals-wrapper\">\r\n        <table class=\"totals-table\">\r\n            <tr>\r\n                <td class=\"total-label\">{{ _(\"Total Returned Qty\") }}</td>\r\n                <td class=\"text-right\">{{ (doc.total_qty | abs) }}</td>\r\n            </tr>\r\n\r\n            <tr>\r\n                <td class=\"total-label\">{{ _(\"Sub Total\") }}</td>\r\n                <td class=\"text-right\">{{ doc.get_formatted(\"net_total\", doc) or doc.get_formatted(\"total\", doc) }}</td>\r\n            </tr>\r\n\r\n            {% for tax in doc.taxes %}\r\n                {% if (tax.tax_amount or (print_settings and print_settings.print_taxes_with_zero_amount))\r\n                      and (not tax.included_in_print_rate or (doc.flags and doc.flags.show_inclusive_tax_in_print)) %}\r\n                <tr>\r\n                    <td class=\"total-label\">\r\n                        {{ tax.get_formatted(\"description\") }} ({{ tax.get_formatted(\"rate\") }}%)\r\n                    </td>\r\n                    <td class=\"text-right\">{{ tax.get_formatted(\"tax_amount\") }}</td>\r\n                </tr>\r\n                {% endif %}\r\n            {% endfor %}\r\n\r\n            <tr>\r\n                <td class=\"total-label grand-total\">{{ _(\"Total Credit Value\") }}</td>\r\n                <td class=\"text-right grand-total\">{{ doc.get_formatted(\"grand_total\", doc) }}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         AMOUNT IN WORDS\r\n         =================================================== -->\r\n\r\n    <table class=\"words-table\">\r\n        <tr>\r\n            <td class=\"words-label\">{{ _(\"Amount in Words\") }}</td>\r\n            <td>{{ doc.in_words or '' }}</td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         EXCHANGE RATE\r\n         =================================================== -->\r\n\r\n    {% set comp_currency = frappe.db.get_value('Company', doc.company, 'default_currency') %}\r\n    {% if doc.currency != comp_currency %}\r\n    <div class=\"exchange-rate\">\r\n        <span class=\"exchange-title\">{{ _(\"Applied Rates of Exchange\") }}:</span>\r\n        <span>{{ doc.currency }} @ {{ doc.conversion_rate or 1.0000 }}</span>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ===================================================\r\n         ADDITIONAL INFORMATION / AUDIT DETAILS\r\n         =================================================== -->\r\n\r\n    <table class=\"details-table\">\r\n        <tr>\r\n            <td class=\"details-label\">{{ _(\"Shipping Address\") }}</td>\r\n            <td class=\"details-value\">\r\n                {{ doc.shipping_address_display or doc.shipping_address or customer_addr or '' }}\r\n            </td>\r\n            <td class=\"details-label\">{{ _(\"Return Reason\") }}</td>\r\n            <td class=\"details-value\">\r\n                {# Dynamically pulls from custom_return_reason or standard remarks #}\r\n                {{ doc.custom_return_reason or doc.remarks or 'Goods Returned as per Credit Note' }}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"details-label\">{{ _(\"Debit To Account\") }}</td>\r\n            <td class=\"details-value\">{{ doc.debit_to or '' }}</td>\r\n            <td class=\"details-label\">{{ _(\"Cost Center\") }}</td>\r\n            <td class=\"details-value\">{{ doc.cost_center or '' }}</td>\r\n        </tr>\r\n\r\n        {% if doc.custom_origin_country or doc.custom_export_documentation or doc.custom_technical_documentation or doc.custom_shipping_marks %}\r\n        <tr>\r\n            <td class=\"details-label\">{{ _(\"Origin Country\") }}</td>\r\n            <td class=\"details-value\">{{ doc.custom_origin_country or '' }}</td>\r\n            <td class=\"details-label\">{{ _(\"Shipping Marks\") }}</td>\r\n            <td class=\"details-value\">{{ doc.custom_shipping_marks or '' }}</td>\r\n        </tr>\r\n        {% endif %}\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         TERMS AND CONDITIONS\r\n         =================================================== -->\r\n\r\n    {% if doc.terms %}\r\n    <div class=\"terms\">\r\n        <div class=\"terms-title\">{{ _(\"Terms and Conditions\") }}</div>\r\n        <div>{{ doc.terms }}</div>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ===================================================\r\n         APPROVAL / SIGNATURE SECTION\r\n         =================================================== -->\r\n\r\n    <div class=\"approval\">\r\n\r\n        {# 1. Check for Workflow log comments #}\r\n        {% set all_approval = frappe.get_all(\r\n            \"Comment\",\r\n            filters={\r\n                \"comment_type\": \"Workflow\",\r\n                \"reference_doctype\": doc.doctype,\r\n                \"reference_name\": doc.name\r\n            },\r\n            fields=[\"comment_email\", \"creation\"],\r\n            order_by=\"creation asc\"\r\n        ) %}\r\n\r\n        <table class=\"approval-signatures\">\r\n            <tr>\r\n                {% if all_approval and all_approval | length > 0 %}\r\n                    {# Workflow history approvals #}\r\n                    {% for approval in all_approval %}\r\n                        {% if approval.comment_email %}\r\n                            {% set user_data = frappe.db.get_value(\r\n                                \"User\",\r\n                                approval.comment_email,\r\n                                [\"full_name\", \"email\", \"email_signature\"],\r\n                                as_dict=True\r\n                            ) %}\r\n                            <td>\r\n                                <div class=\"approval-signature-image\">\r\n                                    {% if user_data and user_data.email_signature %}\r\n                                        {{ user_data.email_signature | safe }}\r\n                                    {% endif %}\r\n                                </div>\r\n                                <div class=\"approval-user-name\">\r\n                                    {{ (user_data.full_name if user_data else '') or approval.comment_email }}\r\n                                </div>\r\n                                <div class=\"approval-user-role\">{{ _(\"Authorized Signatory\") }}</div>\r\n                                <div class=\"approval-user-email\">\r\n                                    {{ (user_data.email if user_data else '') or approval.comment_email }}\r\n                                </div>\r\n                            </td>\r\n                        {% endif %}\r\n                    {% endfor %}\r\n\r\n                {% else %}\r\n                    {# 2. Fallback: Prepared By & Approved By from document history #}\r\n                    {% set creator_data = frappe.db.get_value(\"User\", doc.owner, [\"full_name\", \"email\", \"email_signature\"], as_dict=True) %}\r\n                    {% set approver_data = frappe.db.get_value(\"User\", doc.modified_by, [\"full_name\", \"email\", \"email_signature\"], as_dict=True) if doc.docstatus >= 1 else None %}\r\n\r\n                    <td>\r\n                        <div class=\"approval-signature-image\">\r\n                            {% if creator_data and creator_data.email_signature %}\r\n                                {{ creator_data.email_signature | safe }}\r\n                            {% endif %}\r\n                        </div>\r\n                        <div class=\"approval-user-name\">\r\n                            {{ creator_data.full_name if creator_data else doc.owner }}\r\n                        </div>\r\n                        <div class=\"approval-user-role\">{{ _(\"Prepared By\") }}</div>\r\n                        <div class=\"approval-user-email\">\r\n                            {{ creator_data.email if creator_data else doc.owner }}\r\n                        </div>\r\n                    </td>\r\n\r\n                    {% if approver_data and doc.docstatus >= 1 %}\r\n                    <td>\r\n                        <div class=\"approval-signature-image\">\r\n                            {% if approver_data.email_signature %}\r\n                                {{ approver_data.email_signature | safe }}\r\n                            {% endif %}\r\n                        </div>\r\n                        <div class=\"approval-user-name\">\r\n                            {{ approver_data.full_name or doc.modified_by }}\r\n                        </div>\r\n                        <div class=\"approval-user-role\">{{ _(\"Approved By\") }}</div>\r\n                        <div class=\"approval-user-email\">\r\n                            {{ approver_data.email or doc.modified_by }}\r\n                        </div>\r\n                    </td>\r\n                    {% endif %}\r\n                {% endif %}\r\n            </tr>\r\n        </table>\r\n    </div>\r\n</div>\r\n<div id=\"footer-html\" class=\"visible-pdf\">\r\n    <table style=\"width:100%; border-top:1px solid #999; border-collapse:collapse;\r\n                  font-family:Arial, Helvetica, sans-serif; font-size:9px; color:#111;\">\r\n        <tr>\r\n            <td style=\"width:50%; text-align:left; padding-top:3px;\">\r\n                Page <span class=\"page\"></span> of <span class=\"topage\"></span>\r\n            </td>\r\n            <td style=\"width:50%; text-align:right; padding-top:3px;\">\r\n                Generated By {{ doc.owner }}\r\n                &nbsp;&nbsp;\r\n                {{ frappe.utils.format_datetime(doc.creation, \"dd-mm-yyyy HH:mm:ss\") }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</div>",
