 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<title>Sales Return - {{doc.name}}</title>\r\n<style>\r\n  @page { size: A4 portrait; margin: 8mm; }\r\n  * { box-sizing: border-box; }\r\n  html, body { margin: 0; padding: 0; background: #fff; }\r\n  body {\r\n    font-family: \"Times New Roman\", Times, serif;\r\n    font-size: 13px;\r\n    color: #000;\r\n  }\r\n\r\n  /* ---------- Page frame (renamed: must NOT be \".page\") ---------- */\r\n  .sr-page {\r\n    width: 170mm;\r\n    height: 262mm;\r\n    margin: 0 auto;\r\n    border: 1px solid #000;\r\n    position: relative;\r\n    overflow: hidden;\r\n    page-break-inside: avoid;\r\n  }\r\n\r\n  /* ---------- Letterhead (do NOT use id header-html) ---------- */\r\n  #lh-wrap { display: block; width: 100%; }\r\n  .letterhead {\r\n    position: relative;\r\n    height: 112px;\r\n    overflow: hidden;\r\n    border-bottom: 1px solid #555;\r\n  }\r\n  .lh-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }\r\n  .lh-content { position: absolute; right: 12px; top: 4px; width: 470px; text-align: right; }\r\n  .logo-en {\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    color: #0a7a1e; font-size: 40px; letter-spacing: 1px;\r\n    line-height: 38px; font-weight: 400;\r\n  }\r\n  .logo-sub {\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    color: #e6c800; font-size: 8.5px; letter-spacing: .3px;\r\n    line-height: 10px; margin-top: -2px;\r\n  }\r\n  .ar-name {\r\n    font-family: \"Arial\", \"Tahoma\", sans-serif;\r\n    font-weight: 700; color: #0a5a14; font-size: 26px;\r\n    line-height: 30px; direction: rtl; margin-top: 2px;\r\n  }\r\n  .contact {\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 8.5px; line-height: 13px; text-align: right;\r\n    color: #000; white-space: nowrap;\r\n  }\r\n  .contact.ar { direction: rtl; }\r\n\r\n  /* ---------- Title ---------- */\r\n  .title {\r\n    border-top: 1px solid #000;\r\n    text-align: center;\r\n    font-size: 24px;\r\n    font-weight: 700;\r\n    padding: 4px 0 5px;\r\n    border-bottom: 1px solid #555;\r\n    letter-spacing: .3px;\r\n  }\r\n\r\n  /* ---------- Header info (table layout instead of flex) ---------- */\r\n  .info {\r\n    display: table;\r\n    width: 100%;\r\n    table-layout: fixed;\r\n    border-bottom: 1px solid #555;\r\n  }\r\n  .info-left {\r\n    display: table-cell;\r\n    vertical-align: top;\r\n    position: relative;\r\n    height: 205px;\r\n    border-right: 1px solid #555;\r\n  }\r\n  .info-right {\r\n    display: table-cell;\r\n    width: 336px;\r\n    vertical-align: top;\r\n  }\r\n\r\n  .info-left .to {\r\n    height: 23px; line-height: 22px; padding-left: 22px;\r\n    border-bottom: 1px solid #555;\r\n  }\r\n  .info-left .addr { padding: 6px 0 0 46px; }\r\n  .info-left .addr .co { font-weight: 700; margin-bottom: 5px; line-height: 20px; }\r\n  .info-left .addr div { line-height: 22px; }\r\n\r\n  .info-left .remarks {\r\n    position: absolute;\r\n    left: 0; right: 0; bottom: 0;\r\n    height: 39px; line-height: 39px;\r\n    padding-left: 22px;\r\n    font-weight: 700;\r\n    border-top: 1px solid #555;\r\n    margin: 0;\r\n  }\r\n\r\n  table.meta { width: 100%; border-collapse: collapse; }\r\n  table.meta td {\r\n    height: 23px; padding: 0 5px; border-bottom: 1px solid #555;\r\n    font-family: Arial, Helvetica, sans-serif; font-size: 12.5px;\r\n    vertical-align: middle;\r\n  }\r\n  table.meta tr:last-child td { border-bottom: none; }\r\n  table.meta td.lbl { width: 138px; border-right: 1px solid #555; }\r\n  table.meta td.val { font-family: \"Times New Roman\", Times, serif; font-size: 13px; }\r\n  table.meta td.val.b { font-weight: 700; }\r\n  table.meta td.val.blue { font-weight: 700; color: #00008b; }\r\n\r\n  .spacer-line { height: 22px; border-bottom: 1px solid #888; }\r\n  .gap { height: 6px; }\r\n\r\n  /* ---------- Items table ---------- */\r\n  .items-wrap { padding-bottom: 205px; }\r\n  table.items { width: 100%; border-collapse: collapse; font-size: 12px; }\r\n\r\n  table.items th {\r\n    background: #d3d3d3; text-align: left; font-weight: 700; color: #000;\r\n    padding: 4px 4px; height: 24px;\r\n    border: 1px solid #777;\r\n    border-top: 1px solid #555;\r\n  }\r\n  table.items td {\r\n    padding: 3px 4px; height: 22px;\r\n    border-left: 1px solid #777;\r\n    border-right: 1px solid #777;\r\n    border-bottom: 1px solid #bbb;\r\n  }\r\n  table.items .num { text-align: right; }\r\n  table.items th.num { text-align: left; padding-left: 8px; }\r\n  table.items td.num { padding-right: 8px; }\r\n  table.items td.rate { padding-right: 12px; }\r\n  table.items tr.total td {\r\n    background: #f1f1f1; font-weight: 700;\r\n    border-left: none;\r\n    border-right: none;\r\n    border-top: 1px solid #555;\r\n    border-bottom: 1px solid #555;\r\n    height: 24px;\r\n  }\r\n  table.items tr.total td.t1 {\r\n    font-family: Arial, Helvetica, sans-serif; font-size: 10.5px;\r\n    white-space: nowrap;\r\n  }\r\n\r\n  /* ---------- Footer pinned to bottom of frame ---------- */\r\n  .footer {\r\n    position: absolute;\r\n    left: 0; right: 0; bottom: 0;\r\n    height: 205px;\r\n    border-top: 2px solid #000;\r\n    padding: 6px 16px 10px;\r\n    font-weight: 700; font-size: 12.5px;\r\n    background: #fff;\r\n  }\r\n  .footer .sign { margin-top: 62px; font-size: 11.5px; }\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<div class=\"sr-page\">\r\n\r\n  <!-- ===== LETTERHEAD ===== -->\r\n  <div id=\"lh-wrap\" class=\"visible-pdf\">\r\n    {{ letter_head or '' }}\r\n  </div>\r\n\r\n  <!-- ===== TITLE ===== -->\r\n  <div class=\"title\">SALES RETURN</div>\r\n\r\n  {# Dynamic Address Resolution #}\r\n  {% set customer_addr = doc.address_display %}\r\n  {% if not customer_addr and doc.customer_address %}\r\n    {% set customer_addr = frappe.db.get_value(\"Address\", doc.customer_address, \"display\") %}\r\n  {% endif %}\r\n\r\n  {% set so = '' %}\r\n  {% if doc.items and doc.items[0].sales_order %}\r\n    {% set so = frappe.db.get_value(\"Sales Order\", doc.items[0].sales_order, \"set_warehouse\") %}\r\n  {% endif %}\r\n\r\n  <!-- ===== HEADER INFO ===== -->\r\n  <div class=\"info\">\r\n    <div class=\"info-left\">\r\n      <div class=\"to\">To</div>\r\n      <div class=\"addr\">\r\n        <div class=\"co\">{{ customer_addr | safe if customer_addr else '' }}</div>\r\n      </div>\r\n      <div class=\"remarks\">Remarks</div>\r\n    </div>\r\n\r\n    <div class=\"info-right\">\r\n      <table class=\"meta\">\r\n        <tr><td class=\"lbl\">SALES RETURN ID</td><td class=\"val b\">{{ doc.name }}</td></tr>\r\n        <tr><td class=\"lbl\">CREDIT NOTE NO</td><td class=\"val blue\">{{ doc.return_against or '' }}</td></tr>\r\n        <tr><td class=\"lbl\">DATE</td><td class=\"val\">{{ frappe.utils.formatdate(doc.posting_date, \"dd-MM-yyyy\") if doc.posting_date else '' }}</td></tr>\r\n        <tr><td class=\"lbl\">SALES ID</td><td class=\"val b\"></td></tr>\r\n        <tr><td class=\"lbl\">SALES INVOICE</td><td class=\"val blue\"></td></tr>\r\n        <tr><td class=\"lbl\">INVOICE DATE</td><td class=\"val\"></td></tr>\r\n        <tr><td class=\"lbl\">SALES PERSON</td><td class=\"val\">{{ doc.sales_partner or '' }}</td></tr>\r\n        <tr><td class=\"lbl\">WAREHOUSE</td><td class=\"val\">{{ so or '' }}</td></tr>\r\n      </table>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"spacer-line\"></div>\r\n  <div class=\"gap\"></div>\r\n\r\n  <!-- ===== ITEMS ===== -->\r\n  <div class=\"items-wrap\">\r\n    <table class=\"items\">\r\n      <colgroup>\r\n        <col style=\"width:5%\">\r\n        <col style=\"width:8%\">\r\n        <col style=\"width:37%\">\r\n        <col style=\"width:7%\">\r\n        <col style=\"width:12%\">\r\n        <col style=\"width:12%\">\r\n        <col style=\"width:19%\">\r\n      </colgroup>\r\n      <thead>\r\n        <tr>\r\n          <th>Sl No</th>\r\n          <th>Code</th>\r\n          <th>Name</th>\r\n          <th>Unit</th>\r\n          <th class=\"num\">Qty</th>\r\n          <th class=\"num\">Rate</th>\r\n          <th class=\"num\">Amount(QAR)</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        {% for item in doc.items %}\r\n        <tr>\r\n          <td>{{ loop.index }}</td>\r\n          <td>{{ item.item_code }}</td>\r\n          <td>{{ item.item_name }}</td>\r\n          <td>{{ item.uom }}</td>\r\n          <td class=\"num\">{{ \"%.2f\"|format(item.qty|abs) }}</td>\r\n          <td class=\"num rate\">{{ \"%.2f\"|format(item.rate) }}</td>\r\n          <td class=\"num\">{{ \"%.2f\"|format(item.amount|abs) }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n        <tr class=\"total\">\r\n          <td class=\"t1\" colspan=\"2\">Total In QAR</td>\r\n          <td class=\"t1\" colspan=\"2\">ROE : {{ \"%.4f\"|format(doc.conversion_rate or 1) }}</td>\r\n          <td class=\"num\">{{ \"%.2f\"|format(doc.total_qty|abs) }}</td>\r\n          <td></td>\r\n          <td class=\"num\">{{ \"%.2f\"|format(doc.grand_total|abs) }}</td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n\r\n  <!-- ===== FOOTER ===== -->\r\n  <div class=\"footer\">\r\n    <div>For/&nbsp;&nbsp;&nbsp; {{ doc.company }}</div>\r\n    <div class=\"sign\">Authorized Signatory</div>\r\n  </div>\r\n\r\n</div>\r\n\r\n<!-- ===== PDF PAGE FOOTER (page numbers; PDF only) ===== -->\r\n<div id=\"footer-html\" class=\"visible-pdf\">\r\n  <table style=\"width:100%; border-top:1px solid #999; border-collapse:collapse;\r\n                font-family:Arial, Helvetica, sans-serif; font-size:9px; color:#111;\">\r\n    <tr>\r\n      <td style=\"width:50%; text-align:left; padding-top:3px;\">\r\n        Page <span class=\"page\"></span> of <span class=\"topage\"></span>\r\n      </td>\r\n      <td style=\"width:50%; text-align:right; padding-top:3px;\">\r\n        Generated By {{ doc.owner }}\r\n        &nbsp;&nbsp;\r\n        {{ frappe.utils.format_datetime(doc.creation, \"dd-MM-yyyy HH:mm:ss\") }}\r\n      </td>\r\n    </tr>\r\n  </table>\r\n</div>\r\n\r\n</body>\r\n</html>",
