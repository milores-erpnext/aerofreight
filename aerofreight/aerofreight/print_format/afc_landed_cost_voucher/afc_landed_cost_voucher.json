 "doc_type": "Landed Cost Voucher",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<meta name=\"pdfkit-margin-top\" content=\"5mm\">\r\n<meta name=\"pdfkit-margin-bottom\" content=\"15mm\">\r\n<meta name=\"pdfkit-margin-left\" content=\"1mm\">\r\n<meta name=\"pdfkit-margin-right\" content=\"1mm\">\r\n<style>\r\n/* =========================================================\r\n   A4 COMPACT LANDED COST VOUCHER (LCV)\r\n   ========================================================= */\r\n@page {\r\n    size: A4;\r\n    margin: 0;\r\n}\r\n\r\nhtml,\r\nbody {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    width: 100% !important;\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 9px;\r\n    color: #222;\r\n    line-height: 1.2;\r\n}\r\n\r\n.print-format {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    max-width: 100% !important;\r\n}\r\n\r\n.lcv-page {\r\n    width: 100%;\r\n    margin: 0;\r\n}\r\n\r\n/* ONE place that controls the side space */\r\n.lcv-page,\r\n#footer-html {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    padding-left: 20px !important;\r\n    padding-right: 20px !important;\r\n}\r\n/* =========================================================\r\n   GENERAL\r\n   ========================================================= */\r\n\r\n.lcv-page table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border-spacing: 0;\r\n}\r\n\r\n.lcv-page td,\r\n.lcv-page th {\r\n    vertical-align: top;\r\n}\r\n\r\n.text-left { text-align: left; }\r\n.text-center { text-align: center; }\r\n.text-right { text-align: right; }\r\n\r\np { margin: 0 0 2px 0; }\r\nimg { max-width: 100%; }\r\n\r\n/* =========================================================\r\n   LETTER HEAD / LOGO\r\n   ========================================================= */\r\n\r\n.letter-head {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    width: 100% !important;\r\n    height: auto !important;\r\n    margin: 0 !important;\r\n    padding: 30px 20px 0 20px !important;   /* top | right | bottom | left */\r\n}\r\n\r\n.letter-head img {\r\n    display: block;\r\n    width: 100% !important;\r\n    height: 130px !important;   /* use \"auto\" to keep the original proportions */\r\n}\r\n\r\n/* =========================================================\r\n   DOCUMENT INFORMATION\r\n   ========================================================= */\r\n\r\n.info-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin: 2px 0 4px 0;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.info-table td {\r\n    border: 1px solid #555;\r\n    padding: 3px 5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.info-label {\r\n    width: 16%;\r\n    font-weight: 700;\r\n    background: #f3f3f3;\r\n    font-size: 8.5px;\r\n    white-space: nowrap;\r\n}\r\n\r\n.info-value {\r\n    width: 34%;\r\n    font-size: 9px;\r\n}\r\n\r\n/* =========================================================\r\n   SECTION HEADINGS & INTRO\r\n   ========================================================= */\r\n\r\n.section-title {\r\n    font-size: 9px;\r\n    font-weight: 700;\r\n    margin: 4px 0 2px 0;\r\n    text-transform: uppercase;\r\n    color: #333;\r\n    letter-spacing: 0.3px;\r\n}\r\n\r\n/* =========================================================\r\n   TABLES (RECEIPTS, TAXES, ITEMS)\r\n   ========================================================= */\r\n\r\n.data-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin-bottom: 4px;\r\n    page-break-inside: auto;\r\n}\r\n\r\n.data-table thead {\r\n    display: table-header-group;\r\n}\r\n\r\n.data-table tr {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.data-table th {\r\n    background: #f3f3f3;\r\n    border: 1px solid #555;\r\n    padding: 3px 4px;\r\n    font-size: 8px;\r\n    font-weight: 700;\r\n    line-height: 1.05;\r\n}\r\n\r\n.data-table td {\r\n    border: 1px solid #ccc;\r\n    padding: 2.5px 4px;\r\n    font-size: 8.5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n/* =========================================================\r\n   TOTALS\r\n   ========================================================= */\r\n.totals-wrapper {\r\n    margin-top: 2px;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.totals-table {\r\n    width: 48%;                      /* line length; change this to resize the line */\r\n    margin-left: auto;\r\n    border-collapse: collapse;\r\n}\r\n\r\n.totals-table td {\r\n    padding: 2px 5px;\r\n    font-size: 8.5px;\r\n    line-height: 1.1;\r\n    white-space: nowrap;             /* stops labels wrapping */\r\n}\r\n\r\n.total-label {\r\n    text-align: right;\r\n    color: #555;\r\n    padding-right: 10px !important;  /* gap between label and value */\r\n}\r\n\r\n.totals-table td.text-right {\r\n    width: 1%;                       /* value column only as wide as its content */\r\n    text-align: right;\r\n}\r\n\r\n.grand-total {\r\n    font-weight: 700;\r\n    font-size: 9.5px !important;\r\n    border-top: 1px solid #555;\r\n}\r\n/* =========================================================\r\n   APPROVAL / SIGNATURE\r\n   ========================================================= */\r\n\r\n.approval {\r\n    width: 100%;\r\n    margin-top: 6px;\r\n    border-top: 1px solid #555;\r\n    padding-top: 3px;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures {\r\n    width: 100% !important;\r\n    border-collapse: collapse !important;\r\n    border-spacing: 0 !important;\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    table-layout: fixed !important;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures tr,\r\n.approval-signatures td {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures td {\r\n    text-align: center !important;\r\n    vertical-align: bottom !important;\r\n    border: none !important;\r\n    padding: 0 12px !important;\r\n}\r\n\r\n.approval-signature-image {\r\n    height: 32px;\r\n    min-height: 32px;\r\n    width: 100%;\r\n    text-align: center;\r\n    vertical-align: bottom;\r\n    margin-bottom: 2px;\r\n    overflow: hidden;\r\n}\r\n\r\n.approval-signature-image img {\r\n    display: inline-block;\r\n    max-width: 110px !important;\r\n    max-height: 30px !important;\r\n    width: auto !important;\r\n    height: auto !important;\r\n    object-fit: contain;\r\n}\r\n\r\n.approval-user-name {\r\n    font-size: 8.5px;\r\n    font-weight: 700;\r\n    color: #222;\r\n    border-top: 1px solid #777;\r\n    padding-top: 2px;\r\n    line-height: 1.05;\r\n    white-space: normal;\r\n    word-wrap: break-word;\r\n}\r\n\r\n.approval-user-role {\r\n    font-size: 7.5px;\r\n    font-weight: 600;\r\n    color: #555;\r\n    line-height: 1;\r\n    margin-top: 1px;\r\n}\r\n\r\n.approval-user-email {\r\n    font-size: 7.5px;\r\n    color: #777;\r\n    margin-top: 1px;\r\n    line-height: 1;\r\n    word-break: break-all;\r\n    white-space: normal;\r\n}\r\n\r\n/* =========================================================\r\n   PRINT / PDF SAFETY\r\n   ========================================================= */\r\n\r\ntable, tr, td, th {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.approval,\r\n.approval-signatures,\r\n.approval-signatures tr,\r\n.approval-signatures td,\r\n.totals-wrapper {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n</style>\r\n\r\n<!-- =======================================================\r\n     LETTER HEAD / LOGO\r\n     ======================================================= -->\r\n\r\n{% if letter_head and not no_letterhead %}\r\n<!--<div class=\"letter-head\">-->\r\n<div>\r\n    {{ letter_head }}\r\n</div>\r\n{% endif %}\r\n\r\n<!-- =======================================================\r\n     MAIN LANDED COST VOUCHER\r\n     ======================================================= -->\r\n\r\n<div class=\"lcv-page\">\r\n\r\n    <!-- ===================================================\r\n         STATUS\r\n         =================================================== -->\r\n    <div class=\"text-center\">\r\n        <b>{{ _(\"LANDED COST VOUCHER\") }}</b><br>\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         DOCUMENT HEADER DETAILS\r\n         =================================================== -->\r\n\r\n    {% set comp_currency = doc.company_currency or frappe.db.get_value('Company', doc.company, 'default_currency') %}\r\n\r\n    <table class=\"info-table\">\r\n        <tr>\r\n            <td class=\"info-label\">{{ _(\"Voucher No\") }}</td>\r\n            <td class=\"info-value\"><b>{{ doc.name or '' }}</b></td>\r\n            <td class=\"info-label\">{{ _(\"Posting Date\") }}</td>\r\n            <td class=\"info-value\">\r\n                {{ frappe.utils.format_date(doc.posting_date) }}\r\n                {% if doc.posting_time %} {{ doc.posting_time }} {% endif %}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"info-label\">{{ _(\"Company\") }}</td>\r\n            <td class=\"info-value\"><b>{{ doc.company or '' }}</b></td>\r\n            <td class=\"info-label\">{{ _(\"Distribution Basis\") }}</td>\r\n            <td class=\"info-value\"><b>{{ _(doc.distribute_charges_based_on) or 'Qty' }}</b></td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         APPLICABLE RECEIPTS / INVOICES (purchase_receipts child table)\r\n         =================================================== -->\r\n\r\n    <div class=\"section-title\">{{ _(\"1. Applicable Inward Documents\") }}</div>\r\n    <table class=\"data-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width: 6%;\" class=\"text-center\">{{ _(\"No\") }}</th>\r\n                <th style=\"width: 24%;\" class=\"text-left\">{{ _(\"Receipt Document Type\") }}</th>\r\n                <th style=\"width: 30%;\" class=\"text-left\">{{ _(\"Receipt / Invoice No\") }}</th>\r\n                <th style=\"width: 22%;\" class=\"text-left\">{{ _(\"Supplier\") }}</th>\r\n                <th style=\"width: 18%;\" class=\"text-right\">{{ _(\"Grand Total\") }} ({{ comp_currency }})</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for pr in doc.purchase_receipts %}\r\n            <tr>\r\n                <td class=\"text-center\">{{ loop.index }}</td>\r\n                <td>{{ _(pr.receipt_document_type) or '' }}</td>\r\n                <td><b>{{ pr.receipt_document or '' }}</b></td>\r\n                <td>{{ pr.supplier or frappe.db.get_value(pr.receipt_document_type, pr.receipt_document, \"supplier\") or '' }}</td>\r\n                <td class=\"text-right\">{{ pr.get_formatted(\"grand_total\", doc) }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         TAXES & CHARGES (taxes child table)\r\n         =================================================== -->\r\n\r\n    <div class=\"section-title\">{{ _(\"2. Landed Cost Taxes & Charges\") }}</div>\r\n    <table class=\"data-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width: 6%;\" class=\"text-center\">{{ _(\"No\") }}</th>\r\n                <th style=\"width: 32%;\" class=\"text-left\">{{ _(\"Expense / Liability Account\") }}</th>\r\n                <th style=\"width: 34%;\" class=\"text-left\">{{ _(\"Description\") }}</th>\r\n                <th style=\"width: 28%;\" class=\"text-right\">{{ _(\"Amount\") }} ({{ comp_currency }})</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for tax in doc.taxes %}\r\n            <tr>\r\n                <td class=\"text-center\">{{ loop.index }}</td>\r\n                <td><b>{{ tax.expense_account or '' }}</b></td>\r\n                <td>{{ tax.description or '' }}</td>\r\n                <td class=\"text-right\">{{ tax.get_formatted(\"amount\", doc) }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         APPORTIONED ITEMS BREAKDOWN (items child table)\r\n         =================================================== -->\r\n\r\n    <div class=\"section-title\">{{ _(\"3. Landed Cost Apportionment Breakdown\") }}</div>\r\n    <table class=\"data-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width: 5%;\" class=\"text-center\">{{ _(\"No\") }}</th>\r\n                <th style=\"width: 20%;\" class=\"text-left\">{{ _(\"Item Code / Name\") }}</th>\r\n                <th style=\"width: 18%;\" class=\"text-left\">{{ _(\"Receipt Reference\") }}</th>\r\n                <th style=\"width: 11%;\" class=\"text-right\">{{ _(\"Qty\") }}</th>\r\n                <th style=\"width: 15%;\" class=\"text-right\">{{ _(\"Base Amount\") }}</th>\r\n                <th style=\"width: 15%;\" class=\"text-right\">{{ _(\"Added Charges\") }}</th>\r\n                <th style=\"width: 16%;\" class=\"text-right\">{{ _(\"Final Amount\") }}</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% set total_base_amt = [0.0] %}\r\n            {% set total_applicable_charges = [0.0] %}\r\n            {% for row in doc.items %}\r\n                {% if total_base_amt.append(total_base_amt.pop() + (row.amount or 0.0)) %}{% endif %}\r\n                {% if total_applicable_charges.append(total_applicable_charges.pop() + (row.applicable_charges or 0.0)) %}{% endif %}\r\n            <tr>\r\n                <td class=\"text-center\">{{ loop.index }}</td>\r\n                <td>\r\n                    <b>{{ row.item_code or '' }}</b>\r\n                    {% if row.item_name and row.item_name != row.item_code %}\r\n                        <div style=\"font-size: 7.5px; color: #555;\">{{ row.item_name }}</div>\r\n                    {% endif %}\r\n                </td>\r\n                <td>\r\n                    {{ row.receipt_document or '' }}\r\n                    {% if row.warehouse %}\r\n                        <div style=\"font-size: 7.5px; color: #555;\">Whse: {{ row.warehouse }}</div>\r\n                    {% endif %}\r\n                </td>\r\n                <td class=\"text-right\"><b>{{ row.qty }}</b></td>\r\n                <td class=\"text-right\">{{ row.get_formatted(\"amount\", doc) }}</td>\r\n                <td class=\"text-right\">{{ row.get_formatted(\"applicable_charges\", doc) }}</td>\r\n                <td class=\"text-right\"><b>{{ frappe.format_value((row.amount or 0.0) + (row.applicable_charges or 0.0), {\"fieldtype\": \"Currency\", \"currency\": comp_currency}) }}</b></td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         TOTALS\r\n         =================================================== -->\r\n\r\n    <div class=\"totals-wrapper\">\r\n        <table class=\"totals-table\">\r\n            <tr>\r\n                <td class=\"total-label\">{{ _(\"Total Original Valuation\") }}:</td>\r\n                <td class=\"text-right\">{{ frappe.format_value(total_base_amt[0], {\"fieldtype\": \"Currency\", \"currency\": comp_currency}) }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"total-label\">{{ _(\"Total Landed Charges Distributed\") }}:</td>\r\n                <td class=\"text-right\">{{ doc.get_formatted(\"total_taxes_and_charges\", doc) or frappe.format_value(total_applicable_charges[0], {\"fieldtype\": \"Currency\", \"currency\": comp_currency}) }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"total-label grand-total\">{{ _(\"Updated Net Stock Valuation\") }}:</td>\r\n                <td class=\"text-right grand-total\">{{ frappe.format_value(total_base_amt[0] + (doc.total_taxes_and_charges or total_applicable_charges[0]), {\"fieldtype\": \"Currency\", \"currency\": comp_currency}) }}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         APPROVAL / SIGNATURE SECTION\r\n         =================================================== -->\r\n\r\n    <div class=\"approval\">\r\n\r\n        {# Check for Workflow log comments #}\r\n        {% set all_approval = frappe.get_all(\r\n            \"Comment\",\r\n            filters={\r\n                \"comment_type\": \"Workflow\",\r\n                \"reference_doctype\": doc.doctype,\r\n                \"reference_name\": doc.name\r\n            },\r\n            fields=[\"comment_email\", \"creation\"],\r\n            order_by=\"creation asc\"\r\n        ) %}\r\n\r\n        <table class=\"approval-signatures\">\r\n            <tr>\r\n                {% if all_approval and all_approval | length > 0 %}\r\n                    {% for approval in all_approval %}\r\n                        {% if approval.comment_email %}\r\n                            {% set user_data = frappe.db.get_value(\r\n                                \"User\",\r\n                                approval.comment_email,\r\n                                [\"full_name\", \"email\", \"email_signature\"],\r\n                                as_dict=True\r\n                            ) %}\r\n                            <td>\r\n                                <div class=\"approval-signature-image\">\r\n                                    {% if user_data and user_data.email_signature %}\r\n                                        {{ user_data.email_signature | safe }}\r\n                                    {% endif %}\r\n                                </div>\r\n                                <div class=\"approval-user-name\">\r\n                                    {{ (user_data.full_name if user_data else '') or approval.comment_email }}\r\n                                </div>\r\n                                <div class=\"approval-user-role\">{{ _(\"Authorized Signatory\") }}</div>\r\n                                <div class=\"approval-user-email\">\r\n                                    {{ (user_data.email if user_data else '') or approval.comment_email }}\r\n                                </div>\r\n                            </td>\r\n                        {% endif %}\r\n                    {% endfor %}\r\n\r\n                {% else %}\r\n                    {# Fallback: Prepared By & Approved By from document history #}\r\n                    {% set creator_data = frappe.db.get_value(\"User\", doc.owner, [\"full_name\", \"email\", \"email_signature\"], as_dict=True) %}\r\n                    {% set approver_data = frappe.db.get_value(\"User\", doc.modified_by, [\"full_name\", \"email\", \"email_signature\"], as_dict=True) if doc.docstatus >= 1 else None %}\r\n\r\n                    <td>\r\n                        <div class=\"approval-signature-image\">\r\n                            {% if creator_data and creator_data.email_signature %}\r\n                                {{ creator_data.email_signature | safe }}\r\n                            {% endif %}\r\n                        </div>\r\n                        <div class=\"approval-user-name\">\r\n                            {{ creator_data.full_name if creator_data else doc.owner }}\r\n                        </div>\r\n                        <div class=\"approval-user-role\">{{ _(\"Prepared By\") }}</div>\r\n                        <div class=\"approval-user-email\">\r\n                            {{ creator_data.email if creator_data else doc.owner }}\r\n                        </div>\r\n                    </td>\r\n\r\n                    {% if approver_data and doc.docstatus >= 1 %}\r\n                    <td>\r\n                        <div class=\"approval-signature-image\">\r\n                            {% if approver_data.email_signature %}\r\n                                {{ approver_data.email_signature | safe }}\r\n                            {% endif %}\r\n                        </div>\r\n                        <div class=\"approval-user-name\">\r\n                            {{ approver_data.full_name or doc.modified_by }}\r\n                        </div>\r\n                        <div class=\"approval-user-role\">{{ _(\"Approved By\") }}</div>\r\n                        <div class=\"approval-user-email\">\r\n                            {{ approver_data.email or doc.modified_by }}\r\n                        </div>\r\n                    </td>\r\n                    {% endif %}\r\n                {% endif %}\r\n                <td>\r\n                    <div class=\"approval-signature-image\"></div>\r\n                    <div class=\"approval-user-name\">&nbsp;</div>\r\n                    <div class=\"approval-user-role\">\r\n                    Received By \r\n                    </div>\r\n                    <div class=\"approval-user-email\">{{ _(\"Date: _______\") }}</div>\r\n                </td>\r\n            </tr>\r\n        </table>\r\n\r\n    </div>\r\n\r\n</div>\r\n<div id=\"footer-html\" class=\"visible-pdf\">\r\n    <table style=\"width:100%; border-top:1px solid #999; border-collapse:collapse;\r\n                  font-family:Arial, Helvetica, sans-serif; font-size:9px; color:#111;\">\r\n        <tr>\r\n            <td style=\"width:50%; text-align:left; padding-top:3px;\">\r\n                Page <span class=\"page\"></span> of <span class=\"topage\"></span>\r\n            </td>\r\n            <td style=\"width:50%; text-align:right; padding-top:3px;\">\r\n                Generated By {{ doc.owner }}\r\n                &nbsp;&nbsp;\r\n                {{ frappe.utils.format_datetime(doc.creation, \"dd-mm-yyyy HH:mm:ss\") }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</div>",
