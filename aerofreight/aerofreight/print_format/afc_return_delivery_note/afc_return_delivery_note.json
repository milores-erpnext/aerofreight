 "doctype": "Print Format",
 "font_size": 14,
 "html": "<meta name=\"pdfkit-margin-top\" content=\"5mm\">\r\n<meta name=\"pdfkit-margin-bottom\" content=\"15mm\">\r\n<meta name=\"pdfkit-margin-left\" content=\"1mm\">\r\n<meta name=\"pdfkit-margin-right\" content=\"1mm\">\r\n<style>\r\n/* =========================================================\r\n   DELIVERY NOTE (A4 COMPACT)\r\n   ========================================================= */\r\n\r\n@page {\r\n    size: A4;\r\n    margin: 0;\r\n}\r\n\r\nhtml,\r\nbody {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    width: 100% !important;\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 9.5px;\r\n    color: #111;\r\n    line-height: 1.2;\r\n}\r\n\r\n.print-format {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    max-width: 100% !important;\r\n}\r\n\r\n.dn-page {\r\n    width: 100%;\r\n    margin: 0;\r\n}\r\n\r\n/* ONE place that controls the side space */\r\n.dn-page,\r\n#footer-html {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    padding-left: 20px !important;\r\n    padding-right: 20px !important;\r\n}\r\n/* =========================================================\r\n   GENERAL & TABLES\r\n   ========================================================= */\r\n\r\n.dn-page table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border-spacing: 0;\r\n}\r\n\r\n.dn-page td,\r\n.dn-page th {\r\n    vertical-align: top;\r\n}\r\n\r\n.text-left { text-align: left; }\r\n.text-center { text-align: center; }\r\n.text-right { text-align: right; }\r\n\r\np { margin: 0 0 2px 0; }\r\nimg { max-width: 100%; }\r\n\r\n/* =========================================================\r\n   LETTER HEAD & DOCUMENT TITLE\r\n   ========================================================= */\r\n\r\n.letter-head {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    width: 100% !important;\r\n    height: auto !important;\r\n    margin: 0 !important;\r\n    padding: 30px 20px 0 20px !important;   /* top | right | bottom | left */\r\n}\r\n\r\n.letter-head img {\r\n    display: block;\r\n    width: 100% !important;\r\n    height: 130px !important;   /* use \"auto\" to keep the original proportions */\r\n}\r\n.dn-title-wrapper {\r\n    width: 100%;\r\n    border-bottom: 1.5px solid #2855a6;\r\n    margin: 4px 0 6px 0;\r\n    text-align: center;\r\n    padding-bottom: 2px;\r\n}\r\n\r\n.dn-title {\r\n    font-size: 14px;\r\n    font-weight: 500;\r\n    letter-spacing: 0.8px;\r\n    \r\n    text-transform: uppercase;\r\n}\r\n\r\n/* =========================================================\r\n   TOP HEADER TABLE\r\n   ========================================================= */\r\n\r\n.header-table {\r\n    width: 100%;\r\n    border: 1px solid #333;\r\n    margin-bottom: 6px;\r\n}\r\n\r\n.header-table td {\r\n    border: 1px solid #333;\r\n    padding: 3px 5px;\r\n    font-size: 9px;\r\n    line-height: 1.2;\r\n}\r\n\r\n.header-label {\r\n    font-weight: 600;\r\n    color: #111;\r\n    white-space: nowrap;\r\n}\r\n\r\n.header-val {\r\n    color: #000;\r\n}\r\n\r\n/* =========================================================\r\n   ITEMS TABLE (GROUPED BY WAREHOUSE)\r\n   ========================================================= */\r\n\r\n.items-table {\r\n    width: 100%;\r\n    border: 1px solid #333;\r\n    margin: 0;\r\n    page-break-inside: auto;\r\n}\r\n\r\n.items-table thead {\r\n    display: table-header-group;\r\n}\r\n\r\n.items-table tr {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.items-table th {\r\n    background-color: #abbcd4;\r\n    color: #111;\r\n    border: 1px solid #333;\r\n    padding: 3px 4px;\r\n    font-size: 8.5px;\r\n    font-weight: 700;\r\n    line-height: 1.05;\r\n}\r\n\r\n.warehouse-header-row td {\r\n    background-color: #fff;\r\n    font-weight: 700;\r\n    font-size: 9px;\r\n    padding: 3px 5px;\r\n    border: 1px solid #333;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.items-table td {\r\n    border: 1px solid #333;\r\n    padding: 3px 4px;\r\n    font-size: 8.5px;\r\n    line-height: 1.15;\r\n}\r\n\r\n/* =========================================================\r\n   TOTALS BAR\r\n   ========================================================= */\r\n\r\n.total-strip {\r\n    width: 100%;\r\n    border: 1px solid #333;\r\n    border-top: none;\r\n    background-color: #8daed9;\r\n    font-weight: 700;\r\n    font-size: 9px;\r\n}\r\n\r\n.total-strip td {\r\n    padding: 3px 5px;\r\n    border: 1px solid #333;\r\n}\r\n\r\n/* =========================================================\r\n   REMARKS & NOTICE\r\n   ========================================================= */\r\n\r\n.remarks-container {\r\n    margin-top: 10px;\r\n    font-size: 8.5px;\r\n    color: #111;\r\n    line-height: 1.35;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.remarks-title {\r\n    font-weight: 700;\r\n    margin-bottom: 4px;\r\n}\r\n/* =========================================================\r\n   APPROVAL / SIGNATURE\r\n   PDF-SAFE HORIZONTAL TABLE\r\n   ========================================================= */\r\n\r\n.approval {\r\n    width: 100%;\r\n\r\n    margin-top: 4px;\r\n\r\n    border-top: 1px solid #555;\r\n\r\n    padding-top: 3px;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n\r\n/*\r\n * IMPORTANT:\r\n * Do NOT use display:flex here.\r\n * wkhtmltopdf handles normal HTML tables much\r\n * more reliably than flexbox.\r\n */\r\n\r\n.approval-signatures {\r\n    width: 100% !important;\r\n\r\n    border-collapse: collapse !important;\r\n    border-spacing: 0 !important;\r\n\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n\r\n    table-layout: auto !important;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures tr {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures td {\r\n    text-align: center !important;\r\n\r\n    vertical-align: bottom !important;\r\n\r\n    border: none !important;\r\n\r\n    padding: 0 8px 0 8px !important;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   SIGNATURE IMAGE\r\n   ========================================================= */\r\n\r\n.approval-signature-image {\r\n    height: 32px;\r\n\r\n    width: 100%;\r\n\r\n    text-align: center;\r\n\r\n    vertical-align: bottom;\r\n\r\n    margin-bottom: 2px;\r\n\r\n    overflow: hidden;\r\n}\r\n\r\n.approval-signature-image img {\r\n    display: inline-block;\r\n\r\n    max-width: 105px !important;\r\n\r\n    max-height: 30px !important;\r\n\r\n    width: auto !important;\r\n\r\n    height: auto !important;\r\n\r\n    object-fit: contain;\r\n}\r\n.approval-signature-image,\r\n.approval-signature-image * {\r\n    overflow: hidden !important;\r\n    max-height: 30px !important;\r\n}\r\n\r\n.approval-signature-image {\r\n    scrollbar-width: none;       /* Firefox */\r\n    -ms-overflow-style: none;    /* old Edge/IE */\r\n}\r\n\r\n.approval-signature-image::-webkit-scrollbar {\r\n    display: none;               /* WebKit / wkhtmltopdf */\r\n}\r\n\r\n\r\n/* =========================================================\r\n   APPROVER NAME\r\n   ========================================================= */\r\n\r\n.approval-user-name {\r\n    font-size: 8.5px;\r\n\r\n    font-weight: 700;\r\n\r\n    color: #222;\r\n\r\n    border-top: 1px solid #777;\r\n\r\n    padding-top: 2px;\r\n\r\n    line-height: 1.05;\r\n\r\n    white-space: normal;\r\n\r\n    word-wrap: break-word;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   APPROVER EMAIL\r\n   ========================================================= */\r\n\r\n.approval-user-email {\r\n    font-size: 7.5px;\r\n\r\n    color: #666;\r\n\r\n    margin-top: 1px;\r\n\r\n    line-height: 1;\r\n\r\n    word-break: break-all;\r\n\r\n    white-space: normal;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   PRINT / PDF SAFETY\r\n   ========================================================= */\r\n\r\ntable,\r\ntr,\r\ntd,\r\nth {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.approval,\r\n.approval-signatures,\r\n.approval-signatures tr,\r\n.approval-signatures td,\r\n.details-table,\r\n.words-table,\r\n.totals-wrapper,\r\n.terms {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n/* =========================================================\r\n   PRINT / PDF SAFETY\r\n   ========================================================= */\r\n\r\ntable, tr, td, th {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.header-table,\r\n.items-table,\r\n.total-strip,\r\n.signature-box-table {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n</style>\r\n\r\n<!-- =======================================================\r\n     LETTER HEAD / LOGO\r\n     ======================================================= -->\r\n\r\n{% if letter_head and not no_letterhead %}\r\n<!--<div class=\"letter-head\">-->\r\n<div>\r\n    {{ letter_head }}\r\n</div>\r\n{% endif %}\r\n\r\n<div class=\"dn-page\">\r\n\r\n    <!-- ===================================================\r\n         TITLE: DELIVERY NOTE\r\n         =================================================== -->\r\n\r\n    <div class=\"dn-title-wrapper\">\r\n        <span class=\"dn-title\">DELIVERY NOTE<br>{{doc.status}}</span>\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         HEADER TABLE\r\n         =================================================== -->\r\n\r\n    {# Dynamic Address Resolution #}\r\n    {% set customer_addr = doc.address_display %}\r\n    {% if not customer_addr and doc.customer_address %}\r\n        {% set customer_addr = frappe.db.get_value(\"Address\", doc.customer_address, \"display\") %}\r\n    {% endif %}\r\n    {% if not customer_addr %}\r\n        {% set customer_addr = doc.shipping_address_display or doc.shipping_address or '' %}\r\n    {% endif %}\r\n\r\n    {# Fetch PO Date from linked Sales Order if missing on Delivery Note #}\r\n    {% set po_date = doc.po_date %}\r\n    {% if not po_date %}\r\n        {% for item in doc.items %}\r\n            {% if item.against_sales_order and not po_date %}\r\n                {% set po_date = frappe.db.get_value(\"Sales Order\", item.against_sales_order, \"po_date\") %}\r\n            {% endif %}\r\n        {% endfor %}\r\n    {% endif %}\r\n\r\n    <table class=\"header-table\">\r\n        <tr>\r\n            <td style=\"width: 16%;\" class=\"header-label\">Delivery Note No</td>\r\n            <td style=\"width: 48%;\" class=\"header-val\"><b>{{ doc.name }}</b></td>\r\n            <td style=\"width: 14%;\" class=\"header-label\">Date</td>\r\n            <td style=\"width: 22%;\" class=\"header-val\"><b>{{ frappe.utils.format_date(doc.posting_date) }}</b></td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"header-label\">Delivered To</td>\r\n            <td class=\"header-val\"><b>{{ doc.customer_name or '' }}</b></td>\r\n            <td class=\"header-label\">Ref / LPO No</td>\r\n            <td class=\"header-val\"><b>{{ doc.po_no or '' }}</b></td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"header-label\">Address</td>\r\n            <td class=\"header-val\">\r\n                {{ customer_addr | safe if customer_addr else '' }}\r\n            </td>\r\n            <td class=\"header-label\">Ref / LPO Date</td>\r\n            <td class=\"header-val\">\r\n                <b>{{ frappe.utils.format_date(po_date) if po_date else '' }}</b>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         ITEMS TABLE (WITH WAREHOUSE SEPARATORS)\r\n         =================================================== -->\r\n\r\n    <table class=\"items-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width: 5%;\" class=\"text-center\">Sl No</th>\r\n                <th style=\"width: 26%;\" class=\"text-left\">Code</th>\r\n                <th style=\"width: 47%;\" class=\"text-left\">Item Description</th>\r\n                <th style=\"width: 10%;\" class=\"text-center\">Item Unit</th>\r\n                <th style=\"width: 12%;\" class=\"text-right\">Qty</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n    \r\n            {% for item in doc.items %}\r\n                <tr>\r\n                    <td><b>{{ item.idx or '' }}</b></td>\r\n                    <td><b>{{ item.item_code or '' }}</b></td>\r\n                    <td>\r\n                        {{ item.item_name or '' }}\r\n                        {% if item.description and item.description != item.item_name %}\r\n                            <div style=\"font-size: 7.5px; color: #444;\">{{ item.description | striptags }}</div>\r\n                        {% endif %}\r\n                        {% if item.batch_no %}\r\n                            <div style=\"font-size: 7px; color: #555;\">Batch: {{ item.batch_no }}</div>\r\n                        {% endif %}\r\n                    </td>\r\n                    <td class=\"text-center\">{{ item.uom or '' }}</td>\r\n                    <td class=\"text-right\">\r\n                        {{ \"%.3f\"|format(item.qty or 0) }}\r\n                    </td>\r\n                </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         TOTALS STRIP\r\n         =================================================== -->\r\n        <table class=\"total-strip\">\r\n            <tr>\r\n                <td style=\"width: 78%; border-right: none;\"></td>\r\n                <td style=\"width: 10%; text-align: center; border-left: none;\">\r\n                    Total\r\n                </td>\r\n                <td style=\"width: 12%; text-align: right;\">\r\n                    {{ \"%.3f\"|format(doc.total_qty or 0) }}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    <!-- ===================================================\r\n         REMARKS & NOTICE\r\n         =================================================== -->\r\n\r\n    <div class=\"remarks-container\">\r\n        <div class=\"remarks-title\">Remarks</div>\r\n        {% if doc.remarks %}\r\n            <div>{{ doc.remarks }}</div>\r\n        {% endif %}\r\n        <div>\r\n            Any discrepancy in the supply related to this delivery note should be notified in writing within 7 days from the date of receipt. Goods returned after 7 days will not be accepted\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         GOODS CONDITION & SIGNATURE BOX\r\n         =================================================== -->\r\n\r\n    <!-- ===================================================\r\n         APPROVAL / SIGNATURE\r\n         =================================================== -->\r\n\r\n    <div class=\"approval\">\r\n\r\n        {% set all_approval = frappe.get_all(\r\n            \"Comment\",\r\n            filters={\r\n                \"comment_type\": \"Workflow\",\r\n                \"reference_doctype\": \"Delivery Note\",\r\n                \"reference_name\": doc.name\r\n            },\r\n            fields=[\"comment_email\", \"creation\"],\r\n            order_by=\"creation asc\"\r\n        ) %}\r\n\r\n\r\n        <table class=\"approval-signatures\">\r\n\r\n            <tr>\r\n\r\n                {% for approval in all_approval %}\r\n\r\n                    {% if approval.comment_email %}\r\n\r\n                        {% set user_data = frappe.db.get_value(\r\n                            \"User\",\r\n                            approval.comment_email,\r\n                            [\r\n                                \"full_name\",\r\n                                \"email\",\r\n                                \"email_signature\"\r\n                            ],\r\n                            as_dict=True\r\n                        ) %}\r\n\r\n\r\n                        {% if user_data and user_data.email_signature %}\r\n\r\n                        <td>\r\n\r\n                            <div class=\"approval-signature-image\">\r\n                                {% if user_data.email_signature %}\r\n                                    {{ user_data.email_signature | safe }}\r\n                                {% endif %}\r\n                            </div>\r\n\r\n\r\n                            <div class=\"approval-user-name\">\r\n\r\n                                {{ user_data.full_name\r\n                                   or approval.comment_email }}\r\n\r\n                            </div>\r\n\r\n\r\n                            <div class=\"approval-user-email\">\r\n\r\n                                {{ user_data.email\r\n                                   or approval.comment_email }}\r\n\r\n                            </div>\r\n\r\n                        </td>\r\n\r\n                        {% endif %}\r\n\r\n                    {% endif %}\r\n\r\n                {% endfor %}\r\n\r\n            </tr>\r\n\r\n        </table>\r\n\r\n    </div>\r\n    \r\n<div id=\"footer-html\" class=\"visible-pdf\">\r\n    <table style=\"width:100%; border-top:1px solid #999; border-collapse:collapse;\r\n                  font-family:Arial, Helvetica, sans-serif; font-size:9px; color:#111;\">\r\n        <tr>\r\n            <td style=\"width:50%; text-align:left; padding-top:3px;\">\r\n                Page <span class=\"page\"></span> of <span class=\"topage\"></span>\r\n            </td>\r\n            <td style=\"width:50%; text-align:right; padding-top:3px;\">\r\n                Generated By {{ doc.owner }}\r\n                &nbsp;&nbsp;\r\n                {{ frappe.utils.format_datetime(doc.creation, \"dd-mm-yyyy HH:mm:ss\") }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</div>",
