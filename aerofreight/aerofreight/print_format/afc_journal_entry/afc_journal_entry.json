 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<title>Journal Voucher</title>\r\n\r\n{# ----------------------- DATA BLOCK ----------------------- #}\r\n{% set company      = doc.company %}\r\n{% set book         = \"KT/DOH/TR/Inventory and Trading Division\" %}\r\n{% set title        = \"Journal ( JV )\" %}\r\n{% set voucher_no   = doc.name %}\r\n{% set voucher_date = frappe.utils.get_datetime(doc.posting_date).strftime(\"%d-%m-%Y\") %}\r\n{% set status       = \"Parked\" %}\r\n{% set narration    = doc.remark or '' %}\r\n{% set currency     = \"QAR\" %}\r\n{% set roe          = \"1.0000000\" %}\r\n{% set entries = [\r\n    {\"account_id\": \"16396\", \"particulars\": \"BUSINESS PROMOTION\", \"remarks\": \"\", \"debit\": 100.00, \"credit\": 0},\r\n    {\"account_id\": \"76130\", \"particulars\": \"Mantech - Loan A/c\",  \"remarks\": \"\", \"debit\": 0, \"credit\": 100.00}\r\n] %}\r\n{% set approval_title = \"Approvals ( Journal_Voucher_Approval)\" %}\r\n{% set approvals = [\r\n    {\"role\": \"Maker\",           \"official\": \"Vinu Varghese\", \"datetime\": \"\",                     \"status\": \"\",           \"signature\": \"\"},\r\n    {\"role\": \"HOD Kompass\",     \"official\": \"Ajith Menon\",   \"datetime\": \"\",                     \"status\": \"\",           \"signature\": \"\"},\r\n    {\"role\": \"Account Head KM\", \"official\": \"Rajeev Rajan\",  \"datetime\": \"\",                     \"status\": \"\",           \"signature\": \"\"}\r\n] %}\r\n{% set signatories = [\"Director Finance\", \"Managing Director\", \"Chairman\"] %}\r\n{% set printed_by = frappe.get_fullname(frappe.session.user) %}\r\n{% set printed_on = frappe.utils.now_datetime().strftime(\"%A, %B %d, %Y %-I:%M:%S %p\") %}\r\n{% set entry_by    = doc.modified_by %}\r\n{% set entry_on = frappe.utils.get_datetime(doc.modified).strftime(\"%A, %B %d, %Y %-I:%M:%S %p\") %}\r\n{% set disclaimer  = \"** This voucher is system-generated and does not require any physical or electronic signature(s) for validation. The information contained herein is considered authentic and does require verification unless otherwise specified by authorized personnel.&nbsp; This is a confidential internal document , not to be circulated\" %}\r\n{# Barcode: hardcoded Code128 SVG for the voucher number. Replace later with a dynamic barcode. #}\r\n{% set barcode_svg %}<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 200 40\" width=\"200\" height=\"38\" preserveAspectRatio=\"none\" shape-rendering=\"crispEdges\" fill=\"#000\"><rect x=\"0\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"3\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"6\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"11\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"13\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"18\" y=\"0\" width=\"3\" height=\"40\"/><rect x=\"22\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"25\" y=\"0\" width=\"3\" height=\"40\"/><rect x=\"31\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"33\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"35\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"40\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"44\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"48\" y=\"0\" width=\"3\" height=\"40\"/><rect x=\"52\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"55\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"60\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"62\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"66\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"69\" y=\"0\" width=\"3\" height=\"40\"/><rect x=\"75\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"77\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"82\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"84\" y=\"0\" width=\"3\" height=\"40\"/><rect x=\"88\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"90\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"93\" y=\"0\" width=\"3\" height=\"40\"/><rect x=\"99\" y=\"0\" width=\"3\" height=\"40\"/><rect x=\"103\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"105\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"110\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"112\" y=\"0\" width=\"3\" height=\"40\"/><rect x=\"116\" y=\"0\" width=\"4\" height=\"40\"/><rect x=\"121\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"124\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"128\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"132\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"135\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"140\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"143\" y=\"0\" width=\"3\" height=\"40\"/><rect x=\"148\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"150\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"154\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"156\" y=\"0\" width=\"4\" height=\"40\"/><rect x=\"161\" y=\"0\" width=\"3\" height=\"40\"/><rect x=\"165\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"169\" y=\"0\" width=\"3\" height=\"40\"/><rect x=\"174\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"176\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"180\" y=\"0\" width=\"3\" height=\"40\"/><rect x=\"184\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"187\" y=\"0\" width=\"2\" height=\"40\"/><rect x=\"192\" y=\"0\" width=\"3\" height=\"40\"/><rect x=\"196\" y=\"0\" width=\"1\" height=\"40\"/><rect x=\"198\" y=\"0\" width=\"2\" height=\"40\"/></svg>{% endset %}\r\n\r\n<style>\r\n  @page { size: A4 portrait; margin: 0; }\r\n  html, body { margin: 0 !important; padding: 0 !important; background: #fff; width: 100%; }\r\n  /* neutralise Frappe / Bootstrap print wrappers so the voucher fills the whole page */\r\n  .print-format, .print-format-gutter, .print-format-wrapper, .page-break, .print-preview-wrapper {\r\n    margin: 0 !important; padding: 0 !important; max-width: 100% !important; width: 100% !important;\r\n    box-shadow: none !important; border: 0 !important; background: #fff !important;\r\n  }\r\n  .jv, .jv * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }\r\n  .jv {\r\n    width: 100% !important; margin: 0 !important; padding: 10mm 8mm 8mm 8mm !important;\r\n    font-family: Verdana, \"DejaVu Sans\", Geneva, Arial, sans-serif !important;\r\n    font-size: 7.6pt !important; color: #000 !important; line-height: 1.25 !important;\r\n  }\r\n  .jv table { border-collapse: collapse !important; border-spacing: 0 !important; table-layout: fixed; width: 100% !important; margin: 0 !important; background: transparent !important; }\r\n  .jv table td, .jv table th {\r\n    padding: 0 !important; vertical-align: middle !important; font-size: 7.6pt !important; line-height: 1.25 !important;\r\n    color: #000 !important; background: transparent !important; font-family: inherit !important;\r\n    text-transform: none !important; letter-spacing: 0 !important; word-wrap: break-word;\r\n  }\r\n  .jv table th { font-weight: bold !important; }\r\n  .jv .serif { font-family: \"Times New Roman\", Times, \"Liberation Serif\", serif !important; font-weight: bold !important; }\r\n\r\n  /* ---------- Header ---------- */\r\n  .jv .hdr td { vertical-align: top !important; }\r\n  .jv .company { font-size: 12pt !important; line-height: 1.2 !important; }\r\n  .jv .book { font-size: 7.5pt !important; font-weight: bold !important; margin-top: 4mm; padding-left: 1.4mm; }\r\n  .jv .jv-title { font-size: 13.5pt !important; color: #00008b !important; margin-top: 3mm; }\r\n  .jv .hdr td.bc-cell { width: 30%; text-align: right !important; }\r\n  .jv .bc-box { width: 52mm; margin-left: auto; }\r\n  .jv .bc-box svg { display: block; width: 52mm; height: 9.5mm; }\r\n  .jv .bc-text { font-family: Arial, Helvetica, sans-serif !important; font-size: 7pt !important; text-align: center; margin-top: .6mm; }\r\n\r\n  /* ---------- Voucher info ---------- */\r\n  .jv .info { margin-top: 3mm !important; }\r\n  .jv .info td { height: 6.2mm; white-space: nowrap; }\r\n  .jv .info td.lbl { width: 13%; text-align: right !important; font-weight: bold !important; padding-right: 2mm !important; border-top: 1px solid #000; }\r\n  .jv .info td.val { width: 40%; padding-left: 1.6mm !important; border-top: 1px solid #000; }\r\n  .jv .info td.gap { border: 0 !important; padding-left: 4mm !important; }\r\n  .jv .status-cell { font-size: 11pt !important; color: #ffa500 !important; }\r\n  .jv .info tr.nar td { border-top: 0 !important; border-bottom: 1px solid #000 !important; }\r\n  .jv .info tr.nar td.val { white-space: normal; }\r\n\r\n  /* ---------- Entries ---------- */\r\n  .jv .entries { margin-top: 3mm !important; border: 1px solid #000 !important; }\r\n  .jv .entries th, .jv .entries td { border: 1px solid #000 !important; height: 6.3mm; }\r\n  .jv .entries th { text-align: left !important; padding-left: .8mm !important; font-size: 7.3pt !important; }\r\n  .jv .entries th.num { text-align: center !important; padding-left: 0 !important; }\r\n  .jv .entries td { padding: 0 .8mm !important; }\r\n  .jv .entries .c-id { width: 11%; } .jv .entries .c-part { width: 36%; } .c-roe { width: 16%; }\r\n  .jv .entries .c-rem { width: 11%; } .jv .entries .c-dr { width: 13%; } .jv .entries .c-cr { width: 13%; }\r\n  .jv .entries td.id { text-align: right !important; }\r\n  .jv .entries td.num { text-align: right !important; padding-right: 1.2mm !important; }\r\n  .jv .entries tr.total td { font-weight: bold !important; }\r\n  .jv .entries tr.total td.tl { text-align: right !important; padding-right: 1.2mm !important; }\r\n\r\n  .jv .roe { margin-top: 3.6mm; font-size: 7.5pt !important; }\r\n\r\n  /* ---------- Approvals ---------- */\r\n  .jv .appr { margin-top: 7mm !important; border: 1px solid #000 !important; }\r\n  .jv .appr td, .jv .appr th { border: 1px solid #000 !important; padding: 0 .8mm !important; text-align: left !important; }\r\n  .jv .appr td.title { font-weight: bold !important; height: 6mm; }\r\n  .jv .appr th { height: 6mm; font-size: 7.3pt !important; }\r\n  .jv .appr td { height: 12.2mm; }\r\n  .jv .appr th.hd-center { text-align: center !important; }\r\n  .jv .appr .c-no { width: 4%; } .jv .appr .c-role { width: 18%; } .jv .appr .c-off { width: 16%; }\r\n  .jv .appr .c-dt { width: 19%; } .jv .appr .c-st { width: 13.5%; } .jv .appr .c-sg { width: 12%; } .jv .appr .c-ex { width: 17.5%; }\r\n  .jv .appr td.st { font-weight: bold !important; }\r\n  .jv .appr td.st-ok { color: #008000 !important; }\r\n  .jv .appr td.sig { font-size: 6.5pt !important; vertical-align: top !important; padding-top: .4mm !important; line-height: 1.15 !important; }\r\n  .jv .appr td.sig .sig-in { display: block; width: 17mm; font-size: 6.5pt !important; }\r\n  .jv .appr td.nob { border: 0 !important; }\r\n\r\n  .jv .disc { margin-top: 3mm; font-size: 6.6pt !important; line-height: 1.2 !important; }\r\n\r\n  /* ---------- Signature boxes ---------- */\r\n  .jv .sign { margin-top: 5mm !important; border: 1px solid #000 !important; }\r\n  .jv .sign td { border: 1px solid #000 !important; text-align: center !important; }\r\n  .jv .sign td.box { height: 17mm; color: #bdbdbd !important; }\r\n  .jv .sign td.name { height: 6mm; font-weight: bold !important; }\r\n  .jv .sign .w1 { width: 32.7%; } .jv .sign .w2 { width: 34.7%; } .jv .sign .w3 { width: 32.6%; }\r\n\r\n  .jv .printed { margin-top: 3mm; font-size: 7.5pt !important; }\r\n\r\n  .jv tr, .jv td, .jv th { page-break-inside: avoid; }\r\n  @media screen { body { background: #fff; } }\r\n</style>\r\n</head>\r\n<body>\r\n<div class=\"jv\">\r\n\r\n  <!-- ===== HEADER ===== -->\r\n  <table class=\"hdr\">\r\n    <colgroup><col style=\"width:70%\"><col style=\"width:30%\"></colgroup>\r\n    <tr>\r\n      <td>\r\n        <div class=\"company serif\">{{ company }}</div>\r\n        <!--<div class=\"book\">Book : {{ book }}</div>-->\r\n        <div class=\"jv-title serif\">{{ title }}</div>\r\n      </td>\r\n      <!--<td class=\"bc-cell\">-->\r\n      <!--  <div class=\"bc-box\">{{ barcode_svg }}<div class=\"bc-text\">{{ voucher_no }}</div></div>-->\r\n      <!--</td>-->\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- ===== VOUCHER INFO ===== -->\r\n  <table class=\"info\">\r\n    <colgroup><col style=\"width:13%\"><col style=\"width:40%\"><col style=\"width:47%\"></colgroup>\r\n    <tr>\r\n      <td class=\"lbl\">Voucher No:</td>\r\n      <td class=\"val\">{{ voucher_no }}</td>\r\n      <!--<td class=\"gap\" rowspan=\"2\"><span class=\"status-cell serif\">{{ status }}</span></td>-->\r\n    </tr>\r\n    <tr>\r\n      <td class=\"lbl\">Voucher Date:</td>\r\n      <td class=\"val\">{{ voucher_date }}</td>\r\n    </tr>\r\n    <tr class=\"nar\">\r\n      <td class=\"lbl\">Narration:</td>\r\n      <td class=\"val\" colspan=\"2\">{{ narration }}</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- ===== ENTRIES ===== -->\r\n  <table class=\"entries\">\r\n    <colgroup><col class=\"c-id\"><col class=\"c-part\"><col class=\"c-rem\"><col class=\"c-dr\"><col class=\"c-cr\"></colgroup>\r\n    <thead>\r\n      <tr>\r\n        <th class=\"c-id\">Account ID</th>\r\n        <th class=\"c-part\">Perticulars</th>\r\n        <th class=\"c-roe\">ROE</th>\r\n        <th class=\"c-rem\">Remarks</th>\r\n        <th class=\"c-dr num\">Debit</th>\r\n        <th class=\"c-cr num\">Credit</th>\r\n      </tr>\r\n    </thead>\r\n    <tbody>\r\n      {% for i in doc.accounts %}\r\n      <tr>\r\n        <td class=\"id\">{{ frappe.db.get_value('Account',i.account,'account_number') or '' }}</td>\r\n        <td class=\"part\">{{ i.account }}</td>\r\n        <td>{{ i.account_currency }}@{{ i.exchange_rate }}</td>\r\n        <td>{{ i.user_remark or ''}}</td>\r\n        <td class=\"num\">{% if i.debit_in_account_currency %}{{ \"{:,.2f}\".format(i.debit_in_account_currency) }}{% endif %}</td>\r\n        <td class=\"num\">{% if i.credit_in_account_currency %}{{ \"{:,.2f}\".format(i.credit_in_account_currency) }}{% endif %}</td>\r\n      </tr>\r\n      {% endfor %}\r\n      <tr class=\"total\">\r\n        <td class=\"tl\" colspan=\"4\">TOTAL</td>\r\n        <td class=\"num\">{{ \"{:,.2f}\".format(doc.total_debit) }}</td>\r\n        <td class=\"num\">{{ \"{:,.2f}\".format(doc.total_credit) }}</td>\r\n      </tr>\r\n    </tbody>\r\n  </table>\r\n\r\n  <!-- ===== APPROVALS ===== -->\r\n  <!--<table class=\"appr\">-->\r\n  <!--  <colgroup><col class=\"c-no\"><col class=\"c-role\"><col class=\"c-off\"><col class=\"c-dt\"><col class=\"c-st\"><col class=\"c-sg\"><col class=\"c-ex\"></colgroup>-->\r\n  <!--  <tr><td class=\"title\" colspan=\"7\">{{ approval_title }}</td></tr>-->\r\n  <!--  <tr>-->\r\n  <!--    <th class=\"c-no\">#</th>-->\r\n  <!--    <th class=\"c-role\">Role</th>-->\r\n  <!--    <th class=\"c-off\">Approval Official</th>-->\r\n  <!--    <th class=\"c-dt\">Date &amp; Time</th>-->\r\n  <!--    <th class=\"c-st\">Request Status</th>-->\r\n  <!--    <th class=\"hd-center\" colspan=\"2\">Signature</th>-->\r\n  <!--  </tr>-->\r\n  <!--  {% for a in approvals %}-->\r\n  <!--  <tr>-->\r\n  <!--    <td>{{ loop.index }}</td>-->\r\n  <!--    <td>{{ a.role }}</td>-->\r\n  <!--    <td>{{ a.official }}</td>-->\r\n  <!--    <td>{{ a.datetime }}</td>-->\r\n  <!--    <td class=\"st {% if a.status == 'Approved' %}st-ok{% endif %}\">{{ a.status }}</td>-->\r\n  <!--    <td class=\"sig\" colspan=\"2\"><span class=\"sig-in\">{{ a.signature }}</span></td>-->\r\n  <!--  </tr>-->\r\n  <!--  {% endfor %}-->\r\n  <!--</table>-->\r\n\r\n  <div class=\"disc\">{{ disclaimer }}</div>\r\n\r\n  <!-- ===== SIGNATURE BOXES ===== -->\r\n  <table class=\"sign\">\r\n    <colgroup><col class=\"w1\"><col class=\"w2\"><col class=\"w3\"></colgroup>\r\n    <tr>\r\n      {% for s in signatories %}\r\n      <td class=\"box w{{ loop.index }}\">(signature){% if not loop.last %}{% endif %}</td>\r\n      {% endfor %}\r\n    </tr>\r\n    <tr>\r\n      {% for s in signatories %}\r\n      <td class=\"name w{{ loop.index }}\">{{ s }}</td>\r\n      {% endfor %}\r\n    </tr>\r\n  </table>\r\n\r\n  <div class=\"printed\">Printed by {{ printed_by }}&nbsp; at {{ printed_on }}&nbsp;&nbsp; Entry By - {{ entry_by }} On {{ entry_on }}</div>\r\n\r\n</div>\r\n</body>\r\n</html>",
