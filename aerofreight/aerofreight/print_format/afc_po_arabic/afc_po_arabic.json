{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-09-22 16:07:10.285204",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Purchase Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<meta name=\"pdfkit-margin-top\" content=\"5mm\">\r\n<meta name=\"pdfkit-margin-bottom\" content=\"15mm\">\r\n<meta name=\"pdfkit-margin-left\" content=\"1mm\">\r\n<meta name=\"pdfkit-margin-right\" content=\"1mm\">\r\n<style>\r\n/* =========================================================\r\n   A4 COMPACT PURCHASE ORDER  (English + Arabic labels)\r\n   ========================================================= */\r\n\r\n@page {\r\n    size: A4;\r\n    margin: 0;\r\n}\r\n\r\nhtml,\r\nbody {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    width: 100% !important;\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 9.5px;\r\n    color: #222;\r\n    line-height: 1.2;\r\n}\r\n\r\n.print-format {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    max-width: 100% !important;\r\n}\r\n\r\n.po-page {\r\n    width: 100%;\r\n    margin: 0;\r\n}\r\n\r\n/* ONE place that controls the side space */\r\n.po-page,\r\n#footer-html {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    padding-left: 20px !important;\r\n    padding-right: 20px !important;\r\n}\r\n\r\n/* =========================================================\r\n   ARABIC LABEL (shown under / beside the English label)\r\n   ========================================================= */\r\n\r\n.ar {\r\n    display: block;\r\n    direction: rtl;\r\n    unicode-bidi: embed;\r\n    font-family: Arial, Tahoma, \"Noto Sans Arabic\", sans-serif;\r\n    font-weight: 700;\r\n    font-size: 8.5px;\r\n    line-height: 1.2;\r\n    text-align: inherit;\r\n}\r\n\r\n.ar-inline {\r\n    direction: rtl;\r\n    unicode-bidi: embed;\r\n    font-family: Arial, Tahoma, \"Noto Sans Arabic\", sans-serif;\r\n    font-weight: 700;\r\n}\r\n\r\n/* =========================================================\r\n   GENERAL\r\n   ========================================================= */\r\n\r\n.po-page table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border-spacing: 0;\r\n}\r\n\r\n.po-page td,\r\n.po-page th {\r\n    vertical-align: top;\r\n}\r\n\r\n.text-left {\r\n    text-align: left;\r\n}\r\n\r\n.text-center {\r\n    text-align: center;\r\n}\r\n\r\n.text-right {\r\n    text-align: right;\r\n}\r\n\r\np {\r\n    margin: 0 0 2px 0;\r\n}\r\n\r\nimg {\r\n    max-width: 100%;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   LETTER HEAD / LOGO\r\n   ========================================================= */\r\n\r\n.letter-head {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    width: 100% !important;\r\n    height: auto !important;\r\n    margin: 0 !important;\r\n    padding: 30px 20px 0 20px !important;   /* top | right | bottom | left */\r\n}\r\n\r\n.letter-head img {\r\n    display: block;\r\n    width: 100% !important;\r\n    height: 130px !important;   /* use \"auto\" to keep the original proportions */\r\n}\r\n\r\n/* =========================================================\r\n   DOCUMENT INFORMATION\r\n   ========================================================= */\r\n\r\n.info-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin: 2px 0 4px 0;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.info-table td {\r\n    border: 1px solid #555;\r\n    padding: 3px 5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.info-label {\r\n    width: 15%;\r\n    font-weight: 700;\r\n    background: #f3f3f3;\r\n    font-size: 8.5px;\r\n    white-space: nowrap;\r\n}\r\n\r\n.info-value {\r\n    width: 35%;\r\n    font-size: 9px;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   INTRODUCTION\r\n   ========================================================= */\r\n\r\n.intro-text {\r\n    margin: 3px 0 4px 0;\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    line-height: 1.15;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   ITEMS\r\n   ========================================================= */\r\n\r\n.items-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin: 0;\r\n    page-break-inside: auto;\r\n}\r\n\r\n.items-table thead {\r\n    display: table-header-group;\r\n}\r\n\r\n.items-table tr {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.items-table th {\r\n    background-color: #f3f3f3 !important;\r\n    border: 1px solid #555 !important;\r\n    padding: 3px 4px;\r\n    font-family: Arial, Helvetica, sans-serif !important;\r\n    font-size: 8.5px;\r\n    font-weight: 700 !important;\r\n    line-height: 1.05;\r\n    color: #222 !important;\r\n}\r\n\r\n.items-table td {\r\n    border: 1px solid  #555;\r\n    padding: 3px 4px;\r\n    font-size: 9px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.items-table .total-row td {\r\n    background-color: #d9d9d9 !important;\r\n    border: 1px solid #555 !important;\r\n    padding: 4px 5px;\r\n    font-size: 10px;\r\n    font-weight: 700 !important;\r\n    line-height: 1.1;\r\n}\r\n\r\n.items-table .total-row .total-label {\r\n    text-align: left;\r\n}\r\n\r\n.items-table .total-row .total-value {\r\n    text-align: right;\r\n}\r\n\r\n.items-table .amount-words-row td {\r\n    background-color: #d9d9d9 !important;\r\n    border: 1px solid #aaa !important;\r\n    padding: 6px 5px;\r\n    font-size: 12px;\r\n    font-weight: 700 !important;\r\n    font-style: italic;\r\n    line-height: 1.1;\r\n}\r\n\r\n.items-table .amount-words-left {\r\n    text-align: left;\r\n}\r\n\r\n.items-table .amount-words-right {\r\n    text-align: right;\r\n    white-space: nowrap;\r\n}\r\n/* =========================================================\r\n   TOTALS\r\n   ========================================================= */\r\n.totals-wrapper {\r\n    margin-top: 3px;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.totals-table {\r\n    width: 42%;                      /* line length; change this to resize the line */\r\n    margin-left: auto;\r\n    border-collapse: collapse;\r\n}\r\n\r\n.totals-table td {\r\n    padding: 2px 5px;\r\n    font-size: 9px;\r\n    line-height: 1.05;\r\n    white-space: nowrap;\r\n}\r\n\r\n.total-label {\r\n    text-align: right;\r\n    color: #555;\r\n    padding-right: 10px !important;  /* gap between label and value */\r\n}\r\n\r\n.totals-table td.text-right {\r\n    width: 1%;                       /* value column only as wide as its content */\r\n    text-align: right;\r\n}\r\n\r\n.grand-total {\r\n    font-weight: 700;\r\n    font-size: 10px !important;\r\n    border-top: 1px solid #555;\r\n}\r\n\r\n/* =========================================================\r\n   AMOUNT IN WORDS\r\n   ========================================================= */\r\n\r\n.words-table {\r\n    margin-top: 3px;\r\n    border: 1px solid #ccc;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.words-table td {\r\n    padding: 3px 5px;\r\n    font-size: 9px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.words-label {\r\n    width: 15%;\r\n    font-weight: 700;\r\n    white-space: nowrap;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   EXCHANGE RATE\r\n   ========================================================= */\r\n\r\n.exchange-rate {\r\n    margin-top: 3px;\r\n    padding: 3px 4px;\r\n    border-top: 1px solid #555;\r\n    border-bottom: 1px solid #555;\r\n    font-size: 12px;\r\n    line-height: 1.1;\r\n}\r\n.remark-rate {\r\n    margin-top: 3px;\r\n    margin-bottom: 10 !important;\r\n    padding: 3px 4px;\r\n    border-top: 1px solid #555;\r\n    border-bottom: 1px solid #555;\r\n    font-size: 9px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.exchange-title {\r\n    font-weight: 900;\r\n}\r\n\r\n.remark-title {\r\n    font-weight: 900;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   ADDITIONAL INFORMATION\r\n   ========================================================= */\r\n\r\n.details-table {\r\n    margin-top: 3px;\r\n    border: 1px solid #ccc;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.details-table td {\r\n    border: 1px solid #ccc;\r\n    padding: 3px 5px;\r\n    font-size: 8.5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.details-label {\r\n    width: 18%;\r\n    font-weight: 700;\r\n    background: #f7f7f7;\r\n    font-size: 8px !important;\r\n}\r\n\r\n.details-value {\r\n    width: 32%;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   TERMS AND CONDITIONS\r\n   ========================================================= */\r\n\r\n.terms {\r\n    margin-top: 4px;\r\n\r\n    font-size: 8.5px;\r\n\r\n    line-height: 1.1;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.terms-title {\r\n    font-weight: 700;\r\n\r\n    font-size: 9px;\r\n\r\n    margin-bottom: 2px;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   APPROVAL / SIGNATURE\r\n   PDF-SAFE HORIZONTAL TABLE\r\n   ========================================================= */\r\n\r\n.approval {\r\n    width: 100%;\r\n    margin-top: 15px !important;\r\n    padding-top: 3px;\r\n    border-top: none !important;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n/*\r\n * IMPORTANT:\r\n * Do NOT use display:flex here.\r\n * wkhtmltopdf handles normal HTML tables much\r\n * more reliably than flexbox.\r\n */\r\n\r\n.approval-signatures {\r\n    width: 100% !important;\r\n\r\n    border-collapse: collapse !important;\r\n    border-spacing: 0 !important;\r\n\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n\r\n    table-layout: auto !important;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures tr {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures td {\r\n    text-align: center !important;\r\n\r\n    vertical-align: bottom !important;\r\n\r\n    border: none !important;\r\n\r\n    padding: 0 8px 0 8px !important;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   SIGNATURE IMAGE\r\n   ========================================================= */\r\n\r\n.approval-signature-image {\r\n    height: 32px;\r\n\r\n    width: 100%;\r\n\r\n    text-align: center;\r\n\r\n    vertical-align: bottom;\r\n\r\n    margin-bottom: 2px;\r\n\r\n    overflow: hidden;\r\n}\r\n\r\n.approval-signature-image img {\r\n    display: inline-block;\r\n\r\n    max-width: 105px !important;\r\n\r\n    max-height: 30px !important;\r\n\r\n    width: auto !important;\r\n\r\n    height: auto !important;\r\n\r\n    object-fit: contain;\r\n}\r\n.approval-signature-image,\r\n.approval-signature-image * {\r\n    overflow: hidden !important;\r\n    max-height: 30px !important;\r\n}\r\n\r\n.approval-signature-image {\r\n    scrollbar-width: none;       /* Firefox */\r\n    -ms-overflow-style: none;    /* old Edge/IE */\r\n}\r\n\r\n.approval-signature-image::-webkit-scrollbar {\r\n    display: none;               /* WebKit / wkhtmltopdf */\r\n}\r\n\r\n\r\n/* =========================================================\r\n   APPROVER NAME\r\n   ========================================================= */\r\n\r\n.approval-user-name {\r\n    font-size: 8.5px;\r\n\r\n    font-weight: 700;\r\n\r\n    color: #222;\r\n\r\n    border-top: 1px solid #777;\r\n\r\n    padding-top: 2px;\r\n\r\n    line-height: 1.05;\r\n\r\n    white-space: normal;\r\n\r\n    word-wrap: break-word;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   APPROVER EMAIL\r\n   ========================================================= */\r\n\r\n.approval-user-email {\r\n    font-size: 7.5px;\r\n\r\n    color: #666;\r\n\r\n    margin-top: 1px;\r\n\r\n    line-height: 1;\r\n\r\n    word-break: break-all;\r\n\r\n    white-space: normal;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   PRINT / PDF SAFETY\r\n   ========================================================= */\r\n\r\ntable,\r\ntr,\r\ntd,\r\nth {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.approval,\r\n.approval-signatures,\r\n.approval-signatures tr,\r\n.approval-signatures td,\r\n.details-table,\r\n.words-table,\r\n.totals-wrapper,\r\n.terms {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n</style>\r\n\r\n\r\n<!-- =======================================================\r\n     LETTER HEAD / LOGO\r\n     ======================================================= -->\r\n\r\n<div id=\"header-html\" class=\"hidden-pdf\">\r\n    {% if letter_head and not no_letterhead %}\r\n        {{ letter_head }}\r\n    {% endif %}\r\n</div>\r\n<!-- =======================================================\r\n     MAIN PURCHASE ORDER\r\n     ======================================================= -->\r\n\r\n<div class=\"po-page\">\r\n\r\n\r\n    <!-- ===================================================\r\n         STATUS\r\n         =================================================== -->\r\n    <div class=\"text-center\">\r\n        <b style=\"font-size: 14px;\">Purchase Order &nbsp;/&nbsp; <span class=\"ar-inline\">\u0623\u0645\u0631 \u0634\u0631\u0627\u0621</span></b><br>\r\n        <b>{{ doc.status }}</b>\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         SUPPLIER / PO DETAILS\r\n         =================================================== -->\r\n\r\n    <table class=\"info-table\">\r\n\r\n        <tr>\r\n            <td class=\"info-label\" rowspan=\"2\">\r\n                {{ _(\"Order To\") }}\r\n                <span class=\"ar\">\u0623\u0645\u0631 \u0625\u0644\u0649</span>\r\n            </td>\r\n            <td class=\"info-value\" rowspan=\"2\">\r\n                {{ doc.supplier_name or '' }}\r\n            </td>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Purchase Order\") }}\r\n                <span class=\"ar\">\u0623\u0645\u0631 \u0627\u0644\u0634\u0631\u0627\u0621</span>\r\n            </td>\r\n            <td class=\"info-value\">\r\n                <b>{{ (doc.name or '')[-5:] }}</b>\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"info-label\">\r\n                {{ _(\"Purchase Order Date\") }}\r\n                <span class=\"ar\">\u062a\u0627\u0631\u064a\u062e \u0623\u0645\u0631 \u0627\u0644\u0634\u0631\u0627\u0621</span>\r\n            </td>\r\n            <td class=\"info-value\">\r\n                <b>{{ frappe.utils.format_date(doc.transaction_date) }}</b>\r\n            </td>\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label\" >\r\n                {{ _(\"Attention To\") }}\r\n                <span class=\"ar\">\u0639\u0646\u0627\u064a\u0629</span>\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.address_display or '' }}\r\n            </td>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Purchase Type / Mode\") }}\r\n                <span class=\"ar\">\u0646\u0648\u0639 / \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0634\u0631\u0627\u0621</span>\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                <b>{{ doc.custom_purchase_type or '' }}</b>\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Project Name\") }}\r\n                <span class=\"ar\">\u0627\u0633\u0645 \u0627\u0644\u0645\u0634\u0631\u0648\u0639</span>\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {% set project_name = frappe.db.get_value(\r\n                    \"Project\",\r\n                    doc.project,\r\n                    \"project_name\"\r\n                ) %}\r\n                {{ doc.project or '' }}{% if doc.project and project_name %} - {{ project_name }}{% endif %}\r\n            </td>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Reference No\") }}\r\n                <span class=\"ar\">\u0631\u0642\u0645 \u0627\u0644\u0645\u0631\u062c\u0639</span>\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.order_confirmation_no or '' }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Incoterms\") }}\r\n                <span class=\"ar\">\u0634\u0631\u0648\u0637 \u0627\u0644\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u062f\u0648\u0644\u064a\u0629</span>\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.incoterm or '' }}\r\n            </td>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Invoice Date\") }}\r\n                <span class=\"ar\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</span>\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                \r\n            </td>\r\n\r\n        </tr>\r\n        {% if doc.custom_purchase_type == 'International' %}        \r\n        <tr>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Source Of Shipment\") }}\r\n                <span class=\"ar\">\u0645\u0635\u062f\u0631 \u0627\u0644\u0634\u062d\u0646\u0629</span>\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.custom_importer_name or '' }}\r\n            </td>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Mode Of Shipment:\") }}\r\n                <span class=\"ar\">\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0634\u062d\u0646</span>\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.custom_freight_type or '' }}\r\n            </td>\r\n\r\n        </tr>\r\n        {% endif %}\r\n    </table>\r\n\r\n\r\n    <!-- ===================================================\r\n         INTRODUCTION\r\n         =================================================== -->\r\n\r\n    <div class=\"intro-text\">\r\n\r\n        This Purchase Order is issued for you to proceed with the\r\n        supply, provision of documentation and delivery of the following.\r\n\r\n    </div>\r\n\r\n\r\n    <!-- ===================================================\r\n         ITEMS\r\n         =================================================== -->\r\n\r\n    <table class=\"items-table\">\r\n\r\n        <thead>\r\n\r\n            <tr>\r\n\r\n                <th style=\"width:2%;\" class=\"text-center\">\r\n                    {{ _(\"No\") }}\r\n                    <span class=\"ar\">\u0645</span>\r\n                </th>\r\n\r\n                <th style=\"width:10%;\" class=\"text-left\">\r\n                    {{ _(\"Item Code\") }}\r\n                    <span class=\"ar\">\u0631\u0645\u0632 \u0627\u0644\u0635\u0646\u0641</span>\r\n                </th>\r\n\r\n                <th style=\"width:32%;\" class=\"text-left\">\r\n                    {{ _(\"Item Name\") }}\r\n                    <span class=\"ar\">\u0627\u0633\u0645 \u0627\u0644\u0635\u0646\u0641</span>\r\n                </th>\r\n                \r\n                <th style=\"width:25%;\" class=\"text-left\">\r\n                    {{ _(\"Description\") }}\r\n                    <span class=\"ar\">\u0627\u0644\u0648\u0635\u0641</span>\r\n                </th>\r\n\r\n                <th style=\"width:2%;\" class=\"text-right\">\r\n                    {{ _(\"Units\") }}\r\n                    <span class=\"ar\">\u0627\u0644\u0648\u062d\u062f\u0629</span>\r\n                </th>\r\n\r\n                <th style=\"width:3%;\" class=\"text-right\">\r\n                    {{ _(\"Qty\") }}\r\n                    <span class=\"ar\">\u0627\u0644\u0643\u0645\u064a\u0629</span>\r\n                </th>\r\n\r\n                <th style=\