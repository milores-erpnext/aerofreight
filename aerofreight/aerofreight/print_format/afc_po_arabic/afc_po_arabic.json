ails-value\">\r\n\r\n                {{ doc.custom_insurance or '' }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"details-label\">\r\n                {{ _(\"Country of Origin Documentation\") }}\r\n                <span class=\"ar\">\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0628\u0644\u062f \u0627\u0644\u0645\u0646\u0634\u0623</span>\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.custom_country_of_origin_documentation or '' }}\r\n\r\n            </td>\r\n\r\n            <td class=\"details-label\">\r\n                {{ _(\"Shipping Marks\") }}\r\n                <span class=\"ar\">\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0634\u062d\u0646</span>\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.custom_shipping_marks or '' }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n        {% endif %}\r\n    </table>\r\n\r\n    <div class=\"remark-rate\">\r\n\r\n        <span class=\"remark-title\">\r\n            {{ _(\"Remarks\") }}\r\n            (<span class=\"ar-inline\">\u0645\u0644\u0627\u062d\u0638\u0627\u062a</span>):\r\n        </span>\r\n    \r\n        <span>\r\n    \r\n            {{ doc.custom_remark or ''}}\r\n    \r\n        </span>\r\n\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         APPROVAL / SIGNATURE\r\n         =================================================== -->\r\n\r\n    <div class=\"approval\">\r\n\r\n        {% set all_approval = frappe.get_all(\r\n            \"Comment\",\r\n            filters={\r\n                \"comment_type\": \"Workflow\",\r\n                \"reference_doctype\": \"Purchase Order\",\r\n                \"reference_name\": doc.name\r\n            },\r\n            fields=[\"comment_email\", \"creation\"],\r\n            order_by=\"creation asc\"\r\n        ) %}\r\n\r\n\r\n        <table class=\"approval-signat