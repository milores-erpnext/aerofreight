{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-09-22 15:57:08.571077",
 "css": "",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Purchase Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<meta name=\"pdfkit-margin-top\" content=\"5mm\">\r\n<meta name=\"pdfkit-margin-bottom\" content=\"15mm\">\r\n<meta name=\"pdfkit-margin-left\" content=\"1mm\">\r\n<meta name=\"pdfkit-margin-right\" content=\"1mm\">\r\n<style>\r\n/* =========================================================\r\n   A4 COMPACT PURCHASE ORDER\r\n   ========================================================= */\r\n\r\n@page {\r\n    size: A4;\r\n    margin: 0;\r\n}\r\n\r\nhtml,\r\nbody {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    width: 100% !important;\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 9.5px;\r\n    color: #222;\r\n    line-height: 1.2;\r\n}\r\n\r\n.print-format {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    max-width: 100% !important;\r\n}\r\n\r\n.po-page {\r\n    width: 100%;\r\n    margin: 0;\r\n}\r\n\r\n/* ONE place that controls the side space */\r\n.po-page,\r\n#footer-html {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    padding-left: 20px !important;\r\n    padding-right: 20px !important;\r\n}\r\n\r\n/* =========================================================\r\n   GENERAL\r\n   ========================================================= */\r\n\r\n.po-page table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border-spacing: 0;\r\n}\r\n\r\n.po-page td,\r\n.po-page th {\r\n    vertical-align: top;\r\n}\r\n\r\n.text-left {\r\n    text-align: left;\r\n}\r\n\r\n.text-center {\r\n    text-align: center;\r\n}\r\n\r\n.text-right {\r\n    text-align: right;\r\n}\r\n\r\np {\r\n    margin: 0 0 2px 0;\r\n}\r\n\r\nimg {\r\n    max-width: 100%;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   LETTER HEAD / LOGO\r\n   ========================================================= */\r\n\r\n.letter-head {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    width: 100% !important;\r\n    height: auto !important;\r\n    margin: 0 !important;\r\n    padding: 30px 20px 0 20px !important;   /* top | right | bottom | left */\r\n}\r\n\r\n.letter-head img {\r\n    display: block;\r\n    width: 100% !important;\r\n    height: 130px !important;   /* use \"auto\" to keep the original proportions */\r\n}\r\n\r\n/* =========================================================\r\n   DOCUMENT INFORMATION\r\n   ========================================================= */\r\n\r\n.info-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin: 2px 0 4px 0;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.info-table td {\r\n    border: 1px solid #555;\r\n    padding: 3px 5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.info-label {\r\n    width: 15%;\r\n    font-weight: 700;\r\n    background: #f3f3f3;\r\n    font-size: 8.5px;\r\n    white-space: nowrap;\r\n}\r\n\r\n.info-value {\r\n    width: 35%;\r\n    font-size: 9px;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   INTRODUCTION\r\n   ========================================================= */\r\n\r\n.intro-text {\r\n    margin: 3px 0 4px 0;\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    line-height: 1.15;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   ITEMS\r\n   ========================================================= */\r\n\r\n.items-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin: 0;\r\n    page-break-inside: auto;\r\n}\r\n\r\n.items-table thead {\r\n    display: table-header-group;\r\n}\r\n\r\n.items-table tr {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.items-table th {\r\n    background-color: #f3f3f3 !important;\r\n    border: 1px solid #555 !important;\r\n    padding: 3px 4px;\r\n    font-family: Arial, Helvetica, sans-serif !important;\r\n    font-size: 8.5px;\r\n    font-weight: 700 !important;\r\n    line-height: 1.05;\r\n    color: #222 !important;\r\n}\r\n\r\n.items-table td {\r\n    border: 1px solid  #555;\r\n    padding: 3px 4px;\r\n    font-size: 9px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.items-table .total-row td {\r\n    background-color: #d9d9d9 !important;\r\n    border: 1px solid #555 !important;\r\n    padding: 4px 5px;\r\n    font-size: 10px;\r\n    font-weight: 700 !important;\r\n    line-height: 1.1;\r\n}\r\n\r\n.items-table .total-row .total-label {\r\n    text-align: left;\r\n}\r\n\r\n.items-table .total-row .total-value {\r\n    text-align: right;\r\n}\r\n\r\n.items-table .amount-words-row td {\r\n    background-color: #d9d9d9 !important;\r\n    border: 1px solid #aaa !important;\r\n    padding: 6px 5px;\r\n    font-size: 12px;\r\n    font-weight: 700 !important;\r\n    font-style: italic;\r\n    line-height: 1.1;\r\n}\r\n\r\n.items-table .amount-words-left {\r\n    text-align: left;\r\n}\r\n\r\n.items-table .amount-words-right {\r\n    text-align: right;\r\n    white-space: nowrap;\r\n}\r\n/* =========================================================\r\n   TOTALS\r\n   ========================================================= */\r\n.totals-wrapper {\r\n    margin-top: 3px;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.totals-table {\r\n    width: 42%;                      /* line length; change this to resize the line */\r\n    margin-left: auto;\r\n    border-collapse: collapse;\r\n}\r\n\r\n.totals-table td {\r\n    padding: 2px 5px;\r\n    font-size: 9px;\r\n    line-height: 1.05;\r\n    white-space: nowrap;\r\n}\r\n\r\n.total-label {\r\n    text-align: right;\r\n    color: #555;\r\n    padding-right: 10px !important;  /* gap between label and value */\r\n}\r\n\r\n.totals-table td.text-right {\r\n    width: 1%;                       /* value column only as wide as its content */\r\n    text-align: right;\r\n}\r\n\r\n.grand-total {\r\n    font-weight: 700;\r\n    font-size: 10px !important;\r\n    border-top: 1px solid #555;\r\n}\r\n\r\n/* =========================================================\r\n   AMOUNT IN WORDS\r\n   ========================================================= */\r\n\r\n.words-table {\r\n    margin-top: 3px;\r\n    border: 1px solid #ccc;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.words-table td {\r\n    padding: 3px 5px;\r\n    font-size: 9px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.words-label {\r\n    width: 15%;\r\n    font-weight: 700;\r\n    white-space: nowrap;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   EXCHANGE RATE\r\n   ========================================================= */\r\n\r\n.exchange-rate {\r\n    margin-top: 3px;\r\n    padding: 3px 4px;\r\n    border-top: 1px solid #555;\r\n    border-bottom: 1px solid #555;\r\n    font-size: 12px;\r\n    line-height: 1.1;\r\n}\r\n.remark-rate {\r\n    margin-top: 3px;\r\n    margin-bottom: 10 !important;\r\n    padding: 3px 4px;\r\n    border-top: 1px solid #555;\r\n    border-bottom: 1px solid #555;\r\n    font-size: 9px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.exchange-title {\r\n    font-weight: 900;\r\n}\r\n\r\n.remark-title {\r\n    font-weight: 900;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   ADDITIONAL INFORMATION\r\n   ========================================================= */\r\n\r\n.details-table {\r\n    margin-top: 3px;\r\n    border: 1px solid #ccc;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.details-table td {\r\n    border: 1px solid #ccc;\r\n    padding: 3px 5px;\r\n    font-size: 8.5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.details-label {\r\n    width: 18%;\r\n    font-weight: 700;\r\n    background: #f7f7f7;\r\n    font-size: 8px !important;\r\n}\r\n\r\n.details-value {\r\n    width: 32%;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   TERMS AND CONDITIONS\r\n   ========================================================= */\r\n\r\n.terms {\r\n    margin-top: 4px;\r\n\r\n    font-size: 8.5px;\r\n\r\n    line-height: 1.1;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.terms-title {\r\n    font-weight: 700;\r\n\r\n    font-size: 9px;\r\n\r\n    margin-bottom: 2px;\r\n}\r\n\r\n/* =========================================================\r\n   SIGNATURE BLOCK (dynamic: 1..N, wraps into rows)\r\n   ========================================================= */\r\n\r\n.po-page .approval {\r\n    margin-top: 12px;\r\n    text-align: center;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n    font-size: 0;                    /* removes gaps between inline-blocks */\r\n}\r\n\r\n.po-page .sign-box {\r\n    display: inline-block;\r\n    vertical-align: top;\r\n    width: 24%;                      /* 4 per row. Use 32% for 3, 48% for 2 */\r\n    margin: 0 0 12px 0;\r\n    padding: 0 10px;\r\n    box-sizing: border-box;\r\n    text-align: center;\r\n    font-size: 8.5px;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n/* signature image area: NO border here, so nothing can break the line */\r\n.po-page .sign-img {\r\n    height: 34px;\r\n    line-height: 34px;\r\n    overflow: hidden;\r\n    text-align: center !important;\r\n}\r\n\r\n.po-page .sign-img div,\r\n.po-page .sign-img p,\r\n.po-page .sign-img span {\r\n    display: block;\r\n    margin: 0 auto !important;\r\n    padding: 0 !important;\r\n    float: none !important;\r\n    text-align: center !important;\r\n    line-height: 34px;\r\n    background: transparent !important;\r\n}\r\n\r\n.po-page .sign-img img {\r\n    display: inline-block;\r\n    max-width: 110px;\r\n    max-height: 30px;\r\n    width: auto;\r\n    height: auto;\r\n    margin: 0 auto !important;\r\n    float: none !important;\r\n    vertical-align: bottom;\r\n    background: transparent !important;\r\n}\r\n\r\n/* the line is its own element: continuous, same level, heavier */\r\n.po-page .sign-line {\r\n    height: 0;\r\n    font-size: 0;\r\n    line-height: 0;\r\n    border-top: 1px solid #333;\r\n}\r\n\r\n/* name: normal weight */\r\n.po-page .sign-name {\r\n    margin-top: 3px;\r\n    min-height: 22px;\r\n    font-size: 8.5px;\r\n    font-weight: 400 !important;\r\n    line-height: 1.15;\r\n    color: #222;\r\n}\r\n\r\n/* \"Approved By\": the only bold text */\r\n.po-page .sign-status {\r\n    min-height: 11px;\r\n    font-size: 8.5px;\r\n    font-weight: 700 !important;\r\n    color: #111;\r\n}\r\n.details-table,\r\n.words-table,\r\n.totals-wrapper,\r\n.terms {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n/* =========================================================\r\n   PRINT / PDF SAFETY\r\n   ========================================================= */\r\n\r\ntable,\r\ntr,\r\ntd,\r\nth {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.details-table,\r\n.words-table,\r\n.totals-wrapper,\r\n.terms {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n@media print {\r\n    .print-format #footer-html {\r\n        position: fixed;\r\n        bottom: 0;\r\n        left: 0;\r\n        right: 0;\r\n    }\r\n    /* keep content from running under the fixed footer */\r\n    .print-format .po-page {\r\n        padding-bottom: 14mm !important;\r\n    }\r\n}\r\n\r\n@media print {\r\n    .print-format .page-numbers { visibility: hidden; }\r\n}\r\n\r\n@media print {\r\n    /* reserve space for the page footer */\r\n    @page {\r\n        size: A4;\r\n        margin: 0 0 14mm 0;\r\n\r\n        @bottom-left {\r\n            content: \"Page \" counter(page) \" of \" counter(pages);\r\n            font: 9px Arial, Helvetica, sans-serif;\r\n            color: #111;\r\n            width: 50%;\r\n            padding-left: 20px;\r\n            border-top: 1px solid #999;\r\n            vertical-align: top;\r\n        }\r\n        @bottom-right {\r\n            content: \"Generated By {{ doc.owner }}   {{ frappe.utils.format_datetime(doc.creation, 'dd-MM-yyyy HH:mm:ss') }}\";\r\n            font: 9px Arial, Helvetica, sans-serif;\r\n            color: #111;\r\n            width: 50%;\r\n            padding-right: 20px;\r\n            text-align: right;\r\n            border-top: 1px solid #999;\r\n            vertical-align: top;\r\n        }\r\n    }\r\n\r\n    /* the inline footer is replaced by the margin boxes above */\r\n    .print-format #footer-html {\r\n        display: none !important;\r\n    }\r\n}\r\n</style>\r\n\r\n\r\n<!-- =======================================================\r\n     LETTER HEAD / LOGO\r\n     ======================================================= -->\r\n\r\n<div id=\"header-html\" class=\"hidden-pdf\">\r\n    {% if letter_head and not no_letterhead %}\r\n        {{ letter_head }}\r\n    {% endif %}\r\n</div>\r\n<!-- =======================================================\r\n     MAIN PURCHASE ORDER\r\n     ======================================================= -->\r\n\r\n<div class=\"po-page\">\r\n\r\n\r\n    <!-- ===================================================\r\n         STATUS\r\n         =================================================== -->\r\n    <div class=\"text-center\">\r\n        <b style=\"font-size: 14px;\">Purchase Order</b><br>\r\n        {% if doc.status == 'Draft' %}<b>{{ doc.status or '' }}</b>{% endif %}\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         SUPPLIER / PO DETAILS\r\n         =================================================== -->\r\n\r\n    <table class=\"info-table\">\r\n\r\n        <tr>\r\n            <td class=\"info-label\" rowspan=\"2\">\r\n                {{ _(\"Order To\") }}\r\n            </td>\r\n            <td class=\"info-value\" rowspan=\"2\">\r\n                {{ doc.supplier_name or '' }}\r\n            </td>\r\n        \r\n            <td class=\"info-label\">\r\n                {{ _(\"Purchase Order\") }}\r\n            </td>\r\n            <td class=\"info-value\">\r\n                <b>{{ (doc.name or '')[-5:] or '' }}</b>\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"info-label\">\r\n                {{ _(\"Purchase Order Date\") }}\r\n            </td>\r\n            <td class=\"info-value\">\r\n                <b>{{ frappe.utils.format_date(doc.transaction_date)  or ''}}</b>\r\n            </td>\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label\" >\r\n                {{ _(\"Attention To\") }}\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.address_display or '' }}\r\n            </td>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Purchase Type / Mode\") }}\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                <b>{{ doc.custom_purchase_type or '' }}</b>\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Project Name\") }}\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {% set project_name = frappe.db.get_value(\r\n                    \"Project\",\r\n                    doc.project,\r\n                    \"project_name\"\r\n                ) %}\r\n                {{ doc.project or '' }}{% if doc.project and project_name %} - {{ project_name }}{% endif %}\r\n            </td>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Reference No\") }}\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.order_confirmation_no or '' }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Incoterms\") }}\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.incoterm or '' }}\r\n            </td>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Invoice Date\") }}\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                \r\n            </td>\r\n\r\n        </tr>\r\n        {% if doc.custom_purchase_type == 'International' %}        \r\n        <tr>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Source Of Shipment\") }}\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.custom_importer_name or '' }}\r\n            </td>\r\n\r\n            <td class=\"info-label\">\r\n                {{ _(\"Mode Of Shipment:\") }}\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.custom_freight_type or '' }}\r\n            </td>\r\n\r\n        </tr>\r\n        {% endif %}\r\n    </table>\r\n\r\n\r\n    <!-- ===================================================\r\n         INTRODUCTION\r\n         =================================================== -->\r\n\r\n    <div class=\"intro-text\">\r\n\r\n        This Purchase Order is issued for you to proceed with the\r\n        supply, provision of documentation and delivery of the following.\r\n\r\n    </div>\r\n\r\n\r\n    <!-- ===================================================\r\n         ITEMS\r\n         =================================================== -->\r\n\r\n    <table class=\"items-table\">\r\n\r\n        <thead>\r\n\r\n            <tr>\r\n\r\n                <th style=\"width:2%;\" class=\"text-center\">\r\n                    {{ _(\"No\") }}\r\n                </th>\r\n\r\n                <th style=\"width:10%;\" class=\"text-left\">\r\n                    {{ _(\"Part No\") }}\r\n                </th>\r\n\r\n                <th style=\"width:57%;\" class=\"text-left\">\r\n                    {{ _(\"Description Of Good\") }}\r\n                </th>\r\n\r\n                <th style=\"width:2%;\" class=\"text-right\">\r\n                    {{ _(\"Units\") }}\r\n                </th>\r\n\r\n                <th style=\"width:3%;\" class=\"text-right\">\r\n                    {{ _(\"Qty\") }}\r\n                </th>\r\n\r\n                <th style=\"width:12%;\" class=\"text-right\">\r\n                    {{ _(\"Unit Price\") }}\r\n                </th>\r\n\r\n                <th style=\"width:12%;\" class=\"text-right\">\r\n                    {{ _(\"Total Price\") }}\r\n                </th>\r\n\r\n            </tr>\r\n\r\n        </thead>\r\n\r\n\r\n        <tbody>\r\n\r\n            {% for item in doc.items %}\r\n\r\n            <tr>\r\n\r\n                <td class=\"text-center\">\r\n                    {{ loop.index }}\r\n                </td>\r\n\r\n                <td>\r\n                    {{ item.item_code or '' }}\r\n                </td>\r\n\r\n                <td>\r\n                    {{ item.item_name or '' }}\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n                    {{ item.uom or '' }}\r\n\r\n                </td>\r\n                \r\n                <td class=\"text-right\">\r\n                    {{ item.get_formatted(\"qty\", 0) }}\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n\r\n                    {{ item.get_formatted(\"net_rate\", doc) }}\r\n\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n\r\n                    {{ item.get_formatted(\"net_amount\", doc) }}\r\n\r\n                </td>\r\n\r\n            </tr>\r\n\r\n            {% endfor %}\r\n            \r\n            <tr class=\"total-row\">\r\n                <td colspan=\"4\" class=\"total-label\">\r\n                    <b>{{ _(\"Total\") }}</b>\r\n                </td>\r\n            \r\n                <td class=\"total-value\">\r\n                    <b>{{ doc.get_formatted(\"total_qty\") or '' }}</b>\r\n                </td>\r\n            \r\n                <td></td>\r\n            \r\n                <td class=\"total-value\">\r\n                    <b>{{ doc.get_formatted(\"grand_total\") or ''}}</b>\r\n                </td>\r\n            </tr>\r\n            <tr class=\"amount-words-row\">\r\n                <td colspan=\"4\" class=\"amount-words-left\">\r\n                    {{ doc.in_words or '' }}\r\n                </td>\r\n            \r\n                <td colspan=\"3\" class=\"amount-words-right\">\r\n                    Net {{ doc.get_formatted(\"grand_total\") }}\r\n                </td>\r\n            </tr>\r\n        </tbody>\r\n\r\n    </table>\r\n\r\n\r\n    <!-- ===================================================\r\n         EXCHANGE RATE\r\n         =================================================== -->\r\n\r\n    <div class=\"exchange-rate\">\r\n\r\n        <span class=\"exchange-title\">\r\n            {{ _(\"Applied Rates of Exchange\") }}:\r\n        </span>\r\n\r\n        <span>\r\n\r\n            {{ doc.currency }} @\r\n            {{ doc.conversion_rate or '' }}\r\n\r\n        </span>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- ===================================================\r\n         ADDITIONAL INFORMATION\r\n         =================================================== -->\r\n\r\n    <table class=\"details-table\">\r\n\r\n        <tr>\r\n\r\n            <td class=\"details-label\">\r\n                {{ _(\"Consignee\") }}\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.shipping_address or '' }}\r\n\r\n                <br>\r\n\r\n                {{ doc.shipping_address_display or '' }}\r\n\r\n            </td>\r\n\r\n            <td class=\"details-label\">\r\n                {{ _(\"Payment Terms\") }}\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.payment_terms_template or '' }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n        {% if doc.custom_purchase_type == 'International' %}\r\n\r\n        <tr>\r\n\r\n            <td class=\"details-label\">\r\n                {{ _(\"Origin Country\") }}\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.custom_origin_country or '' }}\r\n\r\n            </td>\r\n\r\n            <td class=\"details-label\">\r\n                {{ _(\"Export Documentation\") }}\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.custom_export_documentation or '' }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"details-label\">\r\n                {{ _(\"Technical Documentation\") }}\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.custom_technical_documentation or '' }}\r\n\r\n            </td>\r\n\r\n            <td class=\"details-label\">\r\n                {{ _(\"Insurance\") }}\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.custom_insurance or '' }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"details-label\">\r\n                {{ _(\"Country of Origin Documentation\") }}\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.custom_country_of_origin_documentation or '' }}\r\n\r\n            </td>\r\n\r\n            <td class=\"details-label\">\r\n                {{ _(\"Shipping Marks\") }}\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.custom_shipping_marks or '' }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n        {% endif %}\r\n    </table>\r\n\r\n    <div class=\"remark-rate\">\r\n\r\n        <span class=\"remark-title\">\r\n            {{ _(\"Remarks\") }}:\r\n        </span>\r\n    \r\n        <span>\r\n    \r\n            {{ doc.custom_remark or ''}}\r\n    \r\n        </span>\r\n\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         APPROVAL / SIGNATURE\r\n         =================================================== -->\r\n    <div class=\"approval\">\r\n        {% set all_approval = frappe.get_all(\r\n            \"Comment\",\r\n            filters={\r\n                \"comment_type\": \"Workflow\",\r\n                \"reference_doctype\": \"Purchase Order\",\r\n                \"reference_name\": doc.name\r\n            },\r\n            fields=[\"comment_email\", \"creation\", \"content\"],\r\n            order_by=\"creation asc\"\r\n        ) %}\r\n    \r\n        {% for approval in all_approval %}\r\n            {% if approval.comment_email %}\r\n                {% set user_data = frappe.db.get_value(\r\n                    \"User\",\r\n                    approval.comment_email,\r\n                    [\"full_name\", \"email_signature\"],\r\n                    as_dict=True\r\n                ) %}\r\n    \r\n                <div class=\"sign-box\">\r\n                    <div class=\"sign-img\">\r\n                        {% if user_data and user_data.email_signature %}\r\n                            {{ user_data.email_signature | safe }}\r\n                        {% endif %}\r\n                    </div>\r\n                    <div class=\"sign-line\"></div>\r\n                    <div class=\"sign-name\">\r\n                        {{ (user_data.full_name if user_data else approval.comment_email) or '' }}\r\n                    </div>\r\n                    <div class=\"sign-status\">\r\n                        {% if approval.content == 'Approved' %}Approved By{% endif %}\r\n                    </div>\r\n                </div>\r\n            {% endif %}\r\n        {% endfor %}\r\n    </div>\r\n</div>\r\n<div id=\"footer-html\" class=\"visible-pdf\">\r\n        <table style=\"width:100%; border-top:1px solid #999; border-collapse:collapse;\r\n                      font-family:Arial, Helvetica, sans-serif; font-size:9px; color:#111;\">\r\n            <tr>\r\n                <td style=\"width:50%; text-align:left; padding-top:3px;\">\r\n                    <span class=\"page-numbers\">Page <span class=\"page\"></span> of <span class=\"topage\"></span></span>\r\n      