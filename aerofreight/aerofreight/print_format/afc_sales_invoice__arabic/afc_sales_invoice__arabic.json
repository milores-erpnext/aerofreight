{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-10-14 19:51:28.453145",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<meta name=\"pdfkit-margin-top\" content=\"5mm\">\r\n<meta name=\"pdfkit-margin-bottom\" content=\"15mm\">\r\n<meta name=\"pdfkit-margin-left\" content=\"5mm\">\r\n<meta name=\"pdfkit-margin-right\" content=\"5mm\">\r\n<style>\r\n/* =========================================================\r\n   A4 BILINGUAL FREIGHT & LOGISTICS SALES INVOICE\r\n   FORCE INCREASED FONT SIZE VERSION\r\n   ========================================================= */\r\n\r\n@page {\r\n    size: A4;\r\n    margin: 0;\r\n}\r\n\r\nhtml,\r\nbody {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    width: 100% !important;\r\n    font-family: Arial, \"Helvetica Neue\", Helvetica, \"DejaVu Sans\", Tahoma, sans-serif;\r\n    font-size: 9px;\r\n    font-weight: 500;\r\n    color: #111;\r\n    line-height: 1.25;\r\n}\r\n\r\n.print-format {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    max-width: 100% !important;\r\n}\r\n\r\n.si-page {\r\n    width: 100%;\r\n    margin: 0;\r\n    font-size: 9px;\r\n    font-weight: 500;\r\n}\r\n\r\n/* ONE place that controls the side space */\r\n.si-page,\r\n#footer-html {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    padding-left: 20px !important;\r\n    padding-right: 20px !important;\r\n}\r\n/* =========================================================\r\n   GLOBAL FONT SIZE / WEIGHT\r\n   ========================================================= */\r\n\r\n.si-page,\r\n.si-page table,\r\n.si-page td,\r\n.si-page th,\r\n.si-page div,\r\n.si-page span {\r\n    font-weight: 500;\r\n}\r\n\r\n.si-page b,\r\n.si-page strong,\r\n.si-page th,\r\n.bold {\r\n    font-weight: 700;\r\n}\r\n\r\n.si-page table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border-spacing: 0;\r\n}\r\n\r\n.si-page td,\r\n.si-page th {\r\n    vertical-align: top;\r\n}\r\n\r\n.text-left {\r\n    text-align: left;\r\n}\r\n\r\n.text-center {\r\n    text-align: center;\r\n}\r\n\r\n.text-right {\r\n    text-align: right;\r\n}\r\n\r\n.bold {\r\n    font-weight: 700;\r\n}\r\n\r\n.ar-text {\r\n    direction: rtl;\r\n    font-family: \"DejaVu Sans\", Tahoma, Arial, sans-serif;\r\n    font-weight: 500;\r\n    font-size: 9px;\r\n}\r\n\r\n/* =========================================================\r\n   LETTER HEAD\r\n   ========================================================= */\r\n\r\n.letter-head {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    width: 100% !important;\r\n    height: auto !important;\r\n    margin: 0 !important;\r\n    padding: 30px 20px 0 20px !important;   /* top | right | bottom | left */\r\n}\r\n\r\n.letter-head img {\r\n    display: block;\r\n    width: 100% !important;\r\n    height: 130px !important;\r\n}\r\n\r\n/* =========================================================\r\n   INVOICE TITLE\r\n   ========================================================= */\r\n\r\n.si-page > .text-center {\r\n    font-size: 14px !important;\r\n    font-weight: 700 !important;\r\n    margin-top: 2px;\r\n    margin-bottom: 4px;\r\n}\r\n\r\n/* =========================================================\r\n   INVOICE TOP STRIP\r\n   ========================================================= */\r\n\r\n.top-bar-table {\r\n    width: 100%;\r\n    border: 1px solid #444;\r\n    margin-bottom: 3px;\r\n}\r\n\r\n.top-bar-table td {\r\n    border: 1px solid #444;\r\n    padding: 3px 5px;\r\n    font-size: 9.5px !important;\r\n    line-height: 1.2;\r\n    font-weight: 500;\r\n}\r\n\r\n.top-bar-label {\r\n    background-color: #f7f7f7;\r\n    font-weight: 700 !important;\r\n    white-space: nowrap;\r\n}\r\n\r\n/* =========================================================\r\n   PARTIES SECTION\r\n   ========================================================= */\r\n\r\n.parties-table {\r\n    width: 100%;\r\n    border: 1px solid #444;\r\n    margin-bottom: 3px;\r\n}\r\n\r\n.parties-table td {\r\n    border: 1px solid #444;\r\n    padding: 3.5px 5px;\r\n    font-size: 9.5px !important;\r\n    line-height: 1.25;\r\n    font-weight: 500;\r\n}\r\n\r\n.party-title-bar {\r\n    background-color: #f2f2f2;\r\n    font-weight: 700 !important;\r\n    font-size: 10px !important;\r\n    padding: 2.5px 5px;\r\n    border-bottom: 1px solid #444;\r\n}\r\n\r\n/* =========================================================\r\n   SHIPMENT DETAILS\r\n   ========================================================= */\r\n\r\n.section-banner {\r\n    background-color: #ececec;\r\n    border: 1px solid #444;\r\n    border-bottom: none;\r\n    font-weight: 700 !important;\r\n    font-size: 10px !important;\r\n    padding: 3px 5px;\r\n    text-align: center;\r\n}\r\n\r\n.shipment-table {\r\n    width: 100%;\r\n    border: 1px solid #444;\r\n    margin-bottom: 3px;\r\n}\r\n\r\n.shipment-table td {\r\n    border: 1px solid #555;\r\n    padding: 2.5px 4px;\r\n    font-size: 9px !important;\r\n    line-height: 1.2;\r\n    font-weight: 500;\r\n}\r\n\r\n.lbl-col {\r\n    background-color: #fcfcfc;\r\n    font-weight: 700 !important;\r\n    white-space: nowrap;\r\n    width: 13%;\r\n    font-size: 9px !important;\r\n}\r\n\r\n.val-col {\r\n    width: 20%;\r\n    font-size: 9px !important;\r\n}\r\n\r\n/* =========================================================\r\n   CHARGES / ITEMS TABLE\r\n   ========================================================= */\r\n\r\n.items-table {\r\n    width: 100%;\r\n    border: 1px solid #444;\r\n    margin-bottom: 0;\r\n    page-break-inside: auto;\r\n}\r\n\r\n.items-table thead {\r\n    display: table-header-group;\r\n}\r\n\r\n.items-table tr {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.items-table th {\r\n    background-color: #eaeaea;\r\n    border: 1px solid #444;\r\n    padding: 3.5px 4px;\r\n    font-size: 9.5px !important;\r\n    font-weight: 700 !important;\r\n    line-height: 1.15;\r\n}\r\n\r\n.items-table td {\r\n    border: 1px solid #666;\r\n    padding: 3.5px 4px;\r\n    font-size: 9.5px !important;\r\n    line-height: 1.2;\r\n    font-weight: 500;\r\n}\r\n\r\n.items-table td b {\r\n    font-weight: 700 !important;\r\n}\r\n\r\n.items-table td div {\r\n    font-size: 8.8px !important;\r\n}\r\n\r\n/* =========================================================\r\n   TOTALS / SUMMARY\r\n   ========================================================= */\r\n\r\n.summary-strip {\r\n    width: 100%;\r\n    border: 1px solid #444;\r\n    border-top: none;\r\n    margin-bottom: 3px;\r\n}\r\n\r\n.summary-strip td {\r\n    padding: 3.5px 5px;\r\n    font-size: 9.5px !important;\r\n    font-weight: 700 !important;\r\n    line-height: 1.2;\r\n}\r\n\r\n.summary-strip td:first-child {\r\n    font-size: 8.8px !important;\r\n    font-weight: 500 !important;\r\n}\r\n\r\n.summary-strip td:last-child {\r\n    font-size: 11px !important;\r\n}\r\n\r\n.words-row {\r\n    width: 100%;\r\n    border: 1px solid #444;\r\n    border-top: none;\r\n    background-color: #fcfcfc;\r\n    font-size: 9.5px !important;\r\n    font-weight: 700 !important;\r\n    padding: 3.5px 5px;\r\n    line-height: 1.2;\r\n}\r\n\r\n/* =========================================================\r\n   BANK DETAILS\r\n   ========================================================= */\r\n\r\n.bank-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin-top: 3px;\r\n    margin-bottom: 3px;\r\n}\r\n\r\n.bank-table td {\r\n    border: 1px solid #777;\r\n    padding: 3px 5px;\r\n    font-size: 9px !important;\r\n    line-height: 1.2;\r\n    font-weight: 500;\r\n}\r\n\r\n.bank-header {\r\n    background-color: #f7f7f7;\r\n    font-size: 9.5px !important;\r\n    font-weight: 700 !important;\r\n}\r\n\r\n.bank-table td[style*=\"font-weight: 700\"] {\r\n    font-weight: 700 !important;\r\n}\r\n\r\n/* =========================================================\r\n   TERMS & CONDITIONS\r\n   ========================================================= */\r\n\r\n.terms-container {\r\n    width: 100%;\r\n    border: 1px solid #777;\r\n    margin-top: 3px;\r\n    margin-bottom: 4px;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.terms-container td {\r\n    padding: 3.5px 5px;\r\n    font-size: 8.5px !important;\r\n    line-height: 1.2;\r\n    vertical-align: top;\r\n    font-weight: 500;\r\n}\r\n\r\n.terms-container td b {\r\n    font-weight: 700 !important;\r\n}\r\n\r\n.terms-left {\r\n    width: 50%;\r\n    border-right: 1px solid #777;\r\n    text-align: left;\r\n}\r\n\r\n.terms-right {\r\n    width: 50%;\r\n    text-align: right;\r\n    direction: rtl;\r\n    font-size: 8.5px !important;\r\n}\r\n\r\n/* =========================================================\r\n   APPROVAL BOX\r\n   ========================================================= */\r\n\r\n.approval-box {\r\n    width: 100%;\r\n    border: 1px solid #444;\r\n    margin-top: 4px;\r\n    page-break-inside: avoid !important;\r\n}\r\n\r\n.approval-box td {\r\n    padding: 4px 6px;\r\n    font-size: 9px !important;\r\n    line-height: 1.2;\r\n    vertical-align: top;\r\n    font-weight: 500;\r\n}\r\n\r\n.approval-box td b {\r\n    font-weight: 700 !important;\r\n}\r\n\r\n.computer-gen-notice {\r\n    font-size: 8.5px !important;\r\n    font-style: italic;\r\n    color: #444;\r\n    margin-top: 2px;\r\n    font-weight: 500;\r\n    line-height: 1.15;\r\n}\r\n\r\n/* =========================================================\r\n   APPROVAL / SIGNATURE\r\n   ========================================================= */\r\n\r\n.approval {\r\n    width: 100%;\r\n    margin-top: 4px;\r\n    border-top: 1px solid #555;\r\n    padding-top: 3px;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures {\r\n    width: 100% !important;\r\n    border-collapse: collapse !important;\r\n    border-spacing: 0 !important;\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    table-layout: auto !important;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures tr {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures td {\r\n    text-align: center !important;\r\n    vertical-align: bottom !important;\r\n    border: none !important;\r\n    padding: 0 8px 0 8px !important;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n    font-weight: 500 !important;\r\n}\r\n\r\n/* =========================================================\r\n   SIGNATURE IMAGE\r\n   ========================================================= */\r\n\r\n.approval-signature-image {\r\n    height: 32px;\r\n    width: 100%;\r\n    text-align: center;\r\n    vertical-align: bottom;\r\n    margin-bottom: 2px;\r\n    overflow: hidden;\r\n}\r\n\r\n.approval-signature-image img {\r\n    display: inline-block;\r\n    max-width: 105px !important;\r\n    max-height: 30px !important;\r\n    width: auto !important;\r\n    height: auto !important;\r\n    object-fit: contain;\r\n}\r\n\r\n.approval-signature-image,\r\n.approval-signature-image * {\r\n    overflow: hidden !important;\r\n    max-height: 30px !important;\r\n}\r\n\r\n.approval-signature-image {\r\n    scrollbar-width: none;\r\n    -ms-overflow-style: none;\r\n}\r\n\r\n.approval-signature-image::-webkit-scrollbar {\r\n    display: none;\r\n}\r\n\r\n/* =========================================================\r\n   APPROVER NAME\r\n   ========================================================= */\r\n\r\n.approval-user-name {\r\n    font-size: 9.5px !important;\r\n    font-weight: 700 !important;\r\n    color: #222;\r\n    border-top: 1px solid #777;\r\n    padding-top: 2px;\r\n    line-height: 1.1;\r\n    white-space: normal;\r\n    word-wrap: break-word;\r\n}\r\n\r\n/* =========================================================\r\n   APPROVER EMAIL\r\n   ========================================================= */\r\n\r\n.approval-user-email {\r\n    font-size: 8.5px !important;\r\n    color: #666;\r\n    margin-top: 1px;\r\n    line-height: 1.05;\r\n    word-break: break-all;\r\n    white-space: normal;\r\n    font-weight: 500;\r\n}\r\n\r\n/* =========================================================\r\n   GENERATED / PREPARED BY\r\n   ========================================================= */\r\n\r\n.si-page > div[style*=\"margin-top: 15px\"] {\r\n    font-size: 9.5px !important;\r\n    line-height: 1.3;\r\n}\r\n\r\n.si-page > div[style*=\"margin-top: 15px\"] b {\r\n    font-weight: 700 !important;\r\n}\r\n\r\n/* =========================================================\r\n   PRINT / PDF SAFETY\r\n   ========================================================= */\r\n\r\ntable,\r\ntr,\r\ntd,\r\nth {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.approval,\r\n.approval-signatures,\r\n.approval-signatures tr,\r\n.approval-signatures td,\r\n.details-table,\r\n.words-table,\r\n.totals-wrapper,\r\n.terms {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.top-bar-table,\r\n.parties-table,\r\n.shipment-table,\r\n.items-table,\r\n.summary-strip,\r\n.bank-table,\r\n.terms-container,\r\n.approval-box {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n/* =========================================================\r\n   FINAL FONT OVERRIDE\r\n   This section is intentionally at the END.\r\n   It overrides inline font-size values in the HTML.\r\n   ========================================================= */\r\n\r\n.si-page,\r\n.si-page table,\r\n.si-page tbody,\r\n.si-page thead,\r\n.si-page tr,\r\n.si-page td,\r\n.si-page th,\r\n.si-page div,\r\n.si-page span,\r\n.si-page b,\r\n.si-page strong {\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n/* Title */\r\n.si-page > .text-center {\r\n    font-size: 14px !important;\r\n    font-weight: 700 !important;\r\n}\r\n\r\n/* Top bar */\r\n.si-page .top-bar-table td {\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n/* Parties */\r\n.si-page .parties-table td {\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n.si-page .party-title-bar {\r\n    font-size: 10px !important;\r\n}\r\n\r\n/* Shipment */\r\n.si-page .section-banner {\r\n    font-size: 10px !important;\r\n}\r\n\r\n.si-page .shipment-table td,\r\n.si-page .shipment-table .lbl-col,\r\n.si-page .shipment-table .val-col {\r\n    font-size: 9px !important;\r\n}\r\n\r\n/* Cargo description */\r\n.si-page .shipment-table td[style*=\"font-size\"] {\r\n    font-size: 9px !important;\r\n}\r\n\r\n/* Items */\r\n.si-page .items-table th {\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n.si-page .items-table td {\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n/* Item description */\r\n.si-page .items-table td div {\r\n    font-size: 8.8px !important;\r\n}\r\n\r\n/* Arabic item description */\r\n.si-page .items-table .ar-text {\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n/* Summary */\r\n.si-page .summary-strip td {\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n.si-page .summary-strip td:first-child {\r\n    font-size: 8.8px !important;\r\n}\r\n\r\n.si-page .summary-strip td:last-child {\r\n    font-size: 11px !important;\r\n}\r\n\r\n/* Words */\r\n.si-page .words-row {\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n/* Bank */\r\n.si-page .bank-table td {\r\n    font-size: 9px !important;\r\n}\r\n\r\n.si-page .bank-header {\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n/* Terms */\r\n.si-page .terms-container td,\r\n.si-page .terms-left,\r\n.si-page .terms-right {\r\n    font-size: 8.5px !important;\r\n}\r\n\r\n/* Approval */\r\n.si-page .approval-box td {\r\n    font-size: 9px !important;\r\n}\r\n\r\n.si-page .computer-gen-notice {\r\n    font-size: 8.5px !important;\r\n}\r\n\r\n/* Signature */\r\n.si-page .approval-user-name {\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n.si-page .approval-user-email {\r\n    font-size: 8.5px !important;\r\n}\r\n\r\n/* Generated / Prepared */\r\n.si-page > div[style*=\"margin-top: 15px\"] {\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n</style>\r\n\r\n<!-- =======================================================\r\n     LETTER HEAD / LOGO\r\n     ======================================================= -->\r\n\r\n{% if letter_head and not no_letterhead %}\r\n<!--<div class=\"letter-head\">-->\r\n<div>\r\n    {{ letter_head }}\r\n</div>\r\n{% endif %}\r\n\r\n<div class=\"si-page\">\r\n\r\n    {# ================= DOCTYPE ================= #}\r\n    <br>\r\n\r\n    <div class=\"text-center\"\r\n         style=\"font-size: 12px; font-weight: 700; margin-top: 2px; margin-bottom: 4px;\">\r\n        \u0641\u0627\u062a\u0648\u0631\u0629 \u0645\u0628\u064a\u0639\u0627\u062a / SALES INVOICE\r\n        <br>{{doc.status}}\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         INVOICE TOP STRIP\r\n         =================================================== -->\r\n\r\n    <table class=\"top-bar-table\">\r\n        <tr>\r\n            <td style=\"width: 1%;\" class=\"top-bar-label\">\r\n                Invoice No. <br>\r\n                 \u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629\r\n            </td>\r\n\r\n            <td style=\"width: 1%; font-weight: 400;\">\r\n                {{ doc.name }}\r\n            </td>\r\n\r\n            <td style=\"width: 5%;\" class=\"top-bar-label\">\r\n                Invoice Date <br>\r\n                \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629\r\n            </td>\r\n\r\n            <td style=\"width: 20%; font-weight: 700;\">\r\n                {{ frappe.utils.format_date(doc.posting_date) }}\r\n            </td>\r\n\r\n            <td style=\"width: 18%;\" class=\"top-bar-label\">\r\n                Invoice Due Date<br> \r\n                \u062a\u0627\u0631\u064a\u062e \u0627\u0633\u062a\u062d\u0642\u0627\u0642 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629\r\n            </td>\r\n\r\n            <td style=\"width: 20%; font-weight: 700;\">\r\n                {{ frappe.utils.format_date(doc.due_date) if doc.due_date else '' }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         PARTIES SECTION\r\n         =================================================== -->\r\n\r\n    {% set customer_addr = doc.address_display %}\r\n\r\n    {% if not customer_addr and doc.customer_address %}\r\n        {% set customer_addr = frappe.db.get_value(\r\n            \"Address\",\r\n            doc.customer_address,\r\n            \"display\"\r\n        ) %}\r\n    {% endif %}\r\n\r\n    <table class=\"parties-table\">\r\n        <tr>\r\n\r\n            <td style=\"width: 50%; padding: 0;\">\r\n\r\n                <div class=\"party-title-bar\">\r\n                    Messers. / \u0627\u0644\u0633\u0627\u062f\u0629\r\n                </div>\r\n\r\n                <div style=\"padding: 4px 6px;\">\r\n\r\n                    <b>{{ doc.customer_name or '' }}</b>\r\n\r\n                    {% if doc.tax_id %}\r\n                        | <b>CR No.: {{ doc.tax_id }}</b>\r\n                    {% endif %}\r\n\r\n                    <br>\r\n\r\n                    {% if customer_addr %}\r\n                        {{ customer_addr | safe }}\r\n                    {% endif %}\r\n\r\n                    {% if doc.contact_display %}\r\n                        <br>Attn: {{ doc.contact_display }}\r\n                    {% endif %}\r\n\r\n                    {% if doc.contact_email %}\r\n                        <br>Email: {{ doc.contact_email }}\r\n                    {% endif %}\r\n\r\n                    {% if doc.contact_mobile or doc.contact_phone %}\r\n                        <br>Tel.: {{ doc.contact_mobile or doc.contact_phone }}\r\n                    {% endif %}\r\n\r\n                </div>\r\n\r\n            </td>\r\n\r\n            <td style=\"width: 50%; padding: 0;\">\r\n\r\n                <div class=\"party-title-bar\">\r\n                    Shipper / \u0627\u0644\u0645\u0635\u062f\u0631\r\n                </div>\r\n\r\n                <div style=\"padding: 4px 6px;\">\r\n\r\n                    <b>\r\n                        {{ doc.custom_shipper_name or doc.customer_name or '' }}\r\n                    </b>\r\n\r\n                    <br>\r\n\r\n                    {{\r\n                        (\r\n                            doc.custom_shipper_address\r\n                            or doc.shipping_address_display\r\n                            or doc.shipping_address\r\n                            or ''\r\n                        ) | safe\r\n                    }}\r\n\r\n                </div>\r\n\r\n            </td>\r\n\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         SHIPMENT DETAILS\r\n         =================================================== -->\r\n\r\n    <div class=\"section-banner\">\r\n        Shipment Details / \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0634\u062d\u0646\u0629\r\n    </div>\r\n\r\n    <table class=\"shipment-table\">\r\n\r\n        <tr>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u0631\u0642\u0645 \u0627\u0644\u0645\u0631\u062c\u0639<br>\r\n                Job / Ref No\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                <b>\r\n                    {{ doc.custom_job_no or doc.po_no or doc.name }}\r\n                </b>\r\n            </td>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a<br>\r\n                Sales Executive\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n\r\n                {% if doc.sales_team and doc.sales_team | length > 0 %}\r\n\r\n                    {{ doc.sales_team[0].sales_person }}\r\n\r\n                {% else %}\r\n\r\n                    {{ doc.custom_sales_executive or '' }}\r\n\r\n                {% endif %}\r\n\r\n            </td>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u0631\u0642\u0645 \u0645\u0631\u062c\u0639 \u0627\u0644\u0639\u0645\u064a\u0644<br>\r\n                Customer Ref No\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                <b>\r\n                    {{ doc.po_no or doc.custom_customer_ref or '' }}\r\n                </b>\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        <tr>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u063a\u0627\u062f\u0631\u0629<br>\r\n                ETD\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                {{ frappe.utils.format_date(doc.custom_etd) if doc.custom_etd else '' }}\r\n            </td>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u0627\u0644\u0648\u062c\u0647\u0629<br>\r\n                Destination\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                {{ doc.custom_destination or doc.shipping_address_name or 'Hamad Port, Qatar' }}\r\n            </td>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0648\u0635\u0648\u0644<br>\r\n                ETA\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                {{ frappe.utils.format_date(doc.custom_eta) if doc.custom_eta else '' }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        <tr>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u0627\u0644\u0646\u0627\u0642\u0644<br>\r\n                Carrier / Vessel\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                {{ doc.custom_carrier or doc.transporter_name or '' }}\r\n            </td>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u0631\u0642\u0645 \u0627\u0644\u0645\u0646\u0627\u0641\u064a\u0633\u062a<br>\r\n                Manifest No\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                {{ doc.custom_manifest_no or '' }}\r\n            </td>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0646\u0627\u0641\u064a\u0633\u062a<br>\r\n                Manifest Date\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                {{\r\n                    frappe.utils.format_date(doc.custom_manifest_date)\r\n                    if doc.custom_manifest_date\r\n                    else ''\r\n                }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        <tr>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u0628\u0648\u0644\u064a\u0635\u0629 \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629<br>\r\n                Master BL / AWB\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                {{ doc.custom_mbl or doc.lr_no or '' }}\r\n            </td>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u0627\u0644\u0648\u0632\u0646 \u0627\u0644\u0645\u062d\u0645\u0644<br>\r\n                Gross Weight\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                {{ doc.custom_gross_weight or '' }}\r\n            </td>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u0627\u0644\u062d\u062c\u0645<br>\r\n                Volume / CBM\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                {{ doc.custom_cbm or '' }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        <tr>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u0628\u0648\u0644\u064a\u0635\u0629 \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0641\u0631\u0639\u064a\u0629<br>\r\n                House BL / HAWB\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                {{ doc.custom_hbl or '' }}\r\n            </td>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u0639\u062f\u062f \u0627\u0644\u0637\u0631\u0648\u062f<br>\r\n                No. of Packages\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                <b>\r\n                    {{ doc.total_qty or doc.custom_no_of_packages or '' }}\r\n                </b>\r\n            </td>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u0646\u0648\u0639 \u0627\u0644\u062a\u062d\u0645\u064a\u0644<br>\r\n                Load Type\r\n            </td>\r\n\r\n            <td class=\"val-col\">\r\n                {{ doc.custom_load_type or 'FCL / LCL' }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        <tr>\r\n\r\n            <td class=\"lbl-col\">\r\n                \u0627\u0644\u0634\u062d\u0646\u0629<br>\r\n                Commodity / Cargo\r\n            </td>\r\n\r\n            <td colspan=\"5\" style=\"font-size: 7.5px;\">\r\n\r\n                {{\r\n                    doc.custom_cargo_description\r\n                    or doc.remarks\r\n                    or 'GENERAL CARGO / FREIGHT CHARGES'\r\n                }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         CHARGES / ITEMS TABLE\r\n         =================================================== -->\r\n\r\n    <table class=\"items-table\">\r\n\r\n        <thead>\r\n\r\n            <tr>\r\n\r\n                <th style=\"width: 5%;\" class=\"text-center\">\r\n                    #\r\n                </th>\r\n\r\n                <th style=\"width: 35%;\" class=\"text-left\">\r\n                    Charge Description\r\n                </th>\r\n\r\n                <th style=\"width: 10%;\" class=\"text-center\">\r\n                    Type<br>(P/S)\r\n                </th>\r\n\r\n                <th style=\"width: 10%;\" class=\"text-center\">\r\n                    \u0627\u0644\u0643\u0645\u064a\u0629<br>Qty\r\n                </th>\r\n\r\n                <th style=\"width: 15%;\" class=\"text-right\">\r\n                    Amount ({{ doc.currency }})<br>\r\n                    \u0627\u0644\u0645\u0628\u0644\u063a\r\n                </th>\r\n\r\n                <th style=\"width: 25%;\" class=\"text-right\">\r\n                    \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0631\u0633\u0648\u0645<br>\r\n                    Arabic Description\r\n                </th>\r\n\r\n            </tr>\r\n\r\n        </thead>\r\n\r\n        <tbody>\r\n\r\n            {% for item in doc.items %}\r\n\r\n            <tr>\r\n\r\n                <td class=\"text-center\">\r\n                    {{ loop.index }}\r\n                </td>\r\n\r\n                <td>\r\n\r\n                    <b>\r\n                        {{ item.item_name or item.item_code }}\r\n                    </b>\r\n\r\n                    {% if item.description and item.description != item.item_name %}\r\n\r\n                        <div style=\"font-size: 7.5px; color: #555; font-weight: 500;\">\r\n                            {{ item.description | striptags }}\r\n                        </div>\r\n\r\n                    {% endif %}\r\n\r\n                </td>\r\n\r\n                <td class=\"text-center\">\r\n                    {{ item.custom_charge_type or 'P' }}\r\n                </td>\r\n\r\n                <td class=\"text-center\">\r\n                    {{ item.get_formatted(\"qty\", 0) }}\r\n                    {{ item.uom or '' }}\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n\r\n                    <b>\r\n                        {{ item.get_formatted(\"amount\", doc) }}\r\n                    </b>\r\n\r\n                </td>\r\n\r\n                <td class=\"text-right ar-text\">\r\n                    {{ item.custom_item_name_arabic or '' }}\r\n                </td>\r\n\r\n            </tr>\r\n\r\n            {% endfor %}\r\n\r\n        </tbody>\r\n\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         TOTAL STRIP & WORDS\r\n         =================================================== -->\r\n\r\n    <table class=\"summary-strip\">\r\n    \r\n        <tr>\r\n    \r\n            <td style=\"width: auto; font-size: 7.5px; color: #333;\">\r\n    \r\n                P - Paid Charges (\u0631\u0633\u0648\u0645 \u0645\u062f\u0641\u0648\u0639\u0629)\r\n                &nbsp;&nbsp;|&nbsp;&nbsp;\r\n                S - Service Charges (\u0631\u0633\u0648\u0645 \u062e\u062f\u0645\u0627\u062a)\r\n    \r\n            </td>\r\n    \r\n            <td style=\"width: 1%; white-space: nowrap; text-align: right; padding-right: 4px;\">\r\n    \r\n                \u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0643\u0644\u064a / TOTAL ({{ doc.currency }}):\r\n    \r\n            </td>\r\n    \r\n            <td style=\"width: 1%; white-space: nowrap; text-align: right; font-size: 10px;\">\r\n    \r\n                <b>\r\n                    {{ doc.get_formatted(\"grand_total\", doc) }}\r\n                </b>\r\n    \r\n            </td>\r\n    \r\n        </tr>\r\n    \r\n    </table>\r\n\r\n    <div class=\"words-row\">\r\n\r\n        <span>\r\n            Amount in Words / \u0627\u0644\u0645\u0628\u0644\u063a \u0643\u062a\u0627\u0628\u0629 :\r\n        </span>\r\n\r\n        &nbsp;\r\n\r\n        <b>\r\n            {{ doc.in_words or '' }}\r\n        </b>\r\n\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         BANK DETAILS\r\n         =================================================== -->\r\n\r\n    <table class=\"bank-table\">\r\n\r\n        <tr class=\"bank-header\">\r\n\r\n            <td colspan=\"4\" style=\"text-align: center;\">\r\n\r\n                Bank Account Details / \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0628\u0646\u0643\u064a\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        <tr>\r\n\r\n            <td style=\"width: 22%; font-weight: 700;\">\r\n                Bank Name / \u0627\u0633\u0645 \u0627\u0644\u0628\u0646\u0643:\r\n            </td>\r\n\r\n            <td style=\"width: 28%;\">\r\n                {{ doc.custom_bank_name or 'Commercial Bank of Qatar' }}\r\n            </td>\r\n\r\n            <td style=\"width: 20%; font-weight: 700;\">\r\n                Swift Code / \u0633\u0648\u064a\u0641\u062a \u0643\u0648\u062f:\r\n            </td>\r\n\r\n            <td style=\"width: 30%;\">\r\n                {{ doc.custom_swift_code or 'CBQAQAQA' }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        <tr>\r\n\r\n            <td style=\"font-weight: 700;\">\r\n                A/c No. (QAR):\r\n            </td>\r\n\r\n            <td>\r\n                {{ doc.custom_account_qar or '4010-117784-001' }}\r\n            </td>\r\n\r\n            <td style=\"font-weight: 700;\">\r\n                IBAN (QAR):\r\n            </td>\r\n\r\n            <td>\r\n                <b>\r\n                    {{ doc.custom_iban_qar or 'QA48CBQA000000004010117784001' }}\r\n                </b>\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        <tr>\r\n\r\n            <td style=\"font-weight: 700;\">\r\n                A/c No. (USD):\r\n            </td>\r\n\r\n            <td>\r\n                {{ doc.custom_account_usd or '4010-117784-051' }}\r\n            </td>\r\n\r\n            <td style=\"font-weight: 700;\">\r\n                IBAN (USD):\r\n            </td>\r\n\r\n            <td>\r\n                <b>\r\n                    {{ doc.custom_iban_usd or 'QA56CBQA000000004010117784051' }}\r\n                </b>\r\n            </td>\r\n\r\n        </tr>\r\n\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         TERMS AND CONDITIONS\r\n         =================================================== -->\r\n\r\n    <table class=\"terms-container\">\r\n\r\n        <tr>\r\n\r\n            <td class=\"terms-left\">\r\n\r\n                <b>Terms & Conditions: E & O E</b><br>\r\n\r\n                1. Any dispute related to this invoice should be notified in writing within 7 days from receipt of invoice.<br>\r\n\r\n                2. Payment to be made in favor of\r\n                <b>{{ doc.company }}</b>.<br>\r\n\r\n                3. Cash payment without collecting of payment receipt shall be deemed as non-payment unless receipt is produced on request.<br>\r\n\r\n                4. Bank charges are on account of the remitter, the invoice amount is to be received in full.<br>\r\n\r\n                5. If Additional port CCIA charges applicable, supplementary invoice for the same will be billed as per actual port receipts.\r\n\r\n            </td>\r\n\r\n            <td class=\"terms-right\">\r\n\r\n                <b>\u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645 :</b><br>\r\n\r\n                \u0661. \u0623\u064a \u0627\u0639\u062a\u0631\u0627\u0636 \u0639\u0644\u0649 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 \u064a\u062c\u0628 \u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646\u0647 \u062e\u0637\u064a\u0627\u064b \u062e\u0644\u0627\u0644 \u0633\u0628\u0639\u0629 \u0623\u064a\u0627\u0645 \u0645\u0646 \u0627\u0633\u062a\u0644\u0627\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629.<br>\r\n\r\n                \u0662. \u064a\u062c\u0628 \u0623\u0646 \u064a\u062a\u0645 \u0627\u0644\u062f\u0641\u0639 \u0644\u062d\u0633\u0627\u0628\r\n                <b>{{ doc.company }}</b>.<br>\r\n\r\n                \u0663. \u064a\u0639\u062a\u0628\u0631 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0646\u0642\u062f\u064a \u062f\u0648\u0646 \u062a\u062d\u0635\u064a\u0644 \u0625\u064a\u0635\u0627\u0644 \u0627\u0644\u062f\u0641\u0639 \u0628\u0645\u062b\u0627\u0628\u0629 \u063a\u064a\u0631 \u0645\u062f\u0641\u0648\u0639 \u0645\u0627 \u0644\u0645 \u064a\u062a\u0645 \u0625\u0628\u0631\u0627\u0632 \u0627\u0644\u0625\u064a\u0635\u