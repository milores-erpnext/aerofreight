 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<title>Invoice</title>\r\n<style>\r\n  /* wkhtmltopdf-safe: NO flexbox, NO gap, NO margin:auto tricks. Tables only. */\r\n  @page { size: A4; margin: 5mm 1mm 15mm 1mm; }\r\n\r\n  html, body {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    width: 100% !important;\r\n    background: #fff;\r\n    font-family: \"Courier New\", Courier, \"Liberation Mono\", \"Nimbus Mono PS\", \"DejaVu Sans Mono\", monospace;\r\n    font-size: 10.5pt;\r\n    color: #222;\r\n    line-height: 1.3;\r\n  }\r\n  @media print { body { background: #fff; } .invoice-sheet { padding: 0 20px !important; } }\r\n  .invoice-sheet { display: block; box-sizing: border-box; }\r\n\r\n  table { border-collapse: collapse; width: 100%; }\r\n  td, th { vertical-align: top; }\r\n  tr { page-break-inside: avoid; }\r\n  thead { display: table-header-group; }\r\n\r\n  /* Arabic text */\r\n  .ar {\r\n    display: block;\r\n    direction: rtl;\r\n    unicode-bidi: embed;\r\n    text-align: left;\r\n    font-family: Tahoma, \"Noto Sans Arabic\", \"DejaVu Sans\", Arial, sans-serif;\r\n    font-size: 8.5pt;\r\n    font-weight: normal;\r\n    line-height: 1.25;\r\n    color: #333;\r\n  }\r\n  .ar-inline { display: inline; }\r\n  .right .ar { text-align: right; }\r\n\r\n  /* HEADER */\r\n  .header { display: block; margin-bottom: 15px; width: 100%; }\r\n  .logo-svg { width: 80px; height: auto; }\r\n\r\n  /* INVOICE NO + DATES */\r\n  .inv-head { margin: 10px 0 15px 0; font-family: \"Times New Roman\", \"Liberation Serif\", serif; }\r\n  .inv-head td { padding: 0 0 8px 0; }\r\n  .inv-head .ar { display: inline; font-family: Tahoma, \"Noto Sans Arabic\", \"DejaVu Sans\", Arial, sans-serif; font-size: 10pt; font-weight: bold; color: inherit; }\r\n  .lbl-grey { color: #777; font-weight: bold; font-size: 13pt; }\r\n  .lbl-green { color: #1b7a3a; font-weight: bold; font-size: 10pt; }\r\n  .inv-no { font-weight: bold; font-size: 14pt; color: #000; }\r\n  .inv-date-row .lbl-grey { font-size: 10pt; }\r\n  .inv-date-row b { font-size: 10.5pt; }\r\n\r\n  .inv-no-table { margin: 10px 0 8px 0; border-collapse: collapse; }\r\n  .inv-no-table td { padding: 1 !important; line-height: 1; border-bottom: 1px solid #222; }\r\n  .inv-no-table span { line-height: 1; }\r\n  .inv-line { width: 100%; border-top: 1px solid #222; height: 0; margin: 0 0 8px 0; font-size: 0; line-height: 0; }\r\n\r\n  /* PARTIES */\r\n  .parties { margin-bottom: 15px; }\r\n  .parties td { width: 50%; line-height: 1.5; padding-right: 10px; }\r\n  .party-title { font-weight: bold; margin-bottom: 4px; }\r\n  .party-title .ar { font-weight: bold; }\r\n\r\n  /* SHIPMENT */\r\n  .sec-title { font-weight: bold; margin-bottom: 5px; }\r\n  .sec-title .ar { font-weight: bold; }\r\n  .ship-table { margin-bottom: 5px; }\r\n  .ship-table td { padding: 2px 0; line-height: 1.4; }\r\n  .ship-table .lbl { width: 18%; }\r\n  .ship-table .val { width: 32%; }\r\n  .trn { font-weight: bold; font-size: 9pt; margin-bottom: 10px; padding-left: 2px; }\r\n  .trn .ar { font-size: 8pt; font-weight: bold; }\r\n\r\n  /* CHARGES */\r\n  .charges-table { margin-bottom: 10px; }\r\n  .charges-table th { border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 6px 0; text-align: left; font-weight: bold; color: #000; }\r\n  .charges-table th .ar { font-weight: bold; }\r\n  .charges-table td { padding: 5px 0; }\r\n  .charges-table .right { text-align: right; }\r\n  .legend { font-size: 9pt; margin-bottom: 8px; }\r\n  .legend .ar { display: inline; }\r\n\r\n  .container-row { border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; padding: 6px 0; margin-bottom: 15px; }\r\n\r\n  /* BANK */\r\n  .bank-section { width: 75%; font-family: Arial, \"Liberation Sans\", sans-serif; font-size: 12px ;}\r\n  .bank-section .ar { font-size: 7.5pt; }\r\n  .bank-header { border-bottom: 1px solid #333; padding-bottom: 4px; margin-bottom: 4px; color: #000; }\r\n  .bank-section td { padding: 0 0 2px 0; }\r\n  .bank-section .bl { width: 28%; }\r\n\r\n  .remarks { margin-bottom: 15px; }\r\n  .remarks .ar { display: inline; }\r\n\r\n  /* FOOTER */\r\n  .footer-block { padding-top: 10px; width: 100%; }\r\n  .total-row td { border-top: 1px solid #222; border-bottom: 1px solid #222; padding: 6px 0; font-weight: bold; }\r\n  .total-row .ar { font-weight: bold; }\r\n  .exch-rate { padding: 5px 0; border-bottom: 1px solid #ddd; margin: 5px 0 10px 0; }\r\n\r\n  .sig-note { font-family: Arial, \"Liberation Sans\", sans-serif; font-weight: bold; font-size: 7pt; margin-bottom: 8px; }\r\n  .sig-note td { width: 50%; padding-right: 10px; }\r\n  .sig-note .ar { font-size: 7pt; font-weight: bold; text-align: right; }\r\n\r\n  .tc-title { font-family: Arial, \"Liberation Sans\", sans-serif; font-weight: bold; font-size: 10pt; margin-bottom: 4px; }\r\n  .tc-title td { width: 50%; }\r\n  .tc-title .ar { font-size: 10pt; font-weight: bold; text-align: right; }\r\n\r\n  .tc-table { font-family: Arial, \"Liberation Sans\", sans-serif; font-size: 7.5pt; line-height: 1.3; }\r\n  .tc-table td { width: 50%; padding: 0 12px 4px 0; }\r\n  .tc-table .ar { font-size: 7.5pt; text-align: right; }\r\n\r\n  .ack { font-family: Arial, \"Liberation Sans\", sans-serif; font-weight: bold; font-size: 10pt; margin: 10px 0 6px 0; }\r\n  .ack td { width: 50%; }\r\n  .ack .ar { font-size: 10pt; font-weight: bold; text-align: right; }\r\n\r\n  .approved { font-family: Arial, \"Liberation Sans\", sans-serif; font-size: 9pt; margin-bottom: 6px; }\r\n  .approved .ar { font-size: 9pt; text-align: right; }\r\n  .cg-note { font-family: Tahoma, \"Noto Sans Arabic\", \"DejaVu Sans\", Arial, sans-serif; font-size: 8.5pt; text-align: right; direction: rtl; unicode-bidi: embed; margin-bottom: 6px; }\r\n\r\n  .for-company { font-style: italic; font-weight: bold; margin-bottom: 8px; }\r\n  .note { font-family: Arial, \"Liberation Sans\", sans-serif; font-size: 8.5pt; color: #0b6fc2; line-height: 1.3; margin-bottom: 15px; }\r\n  .company-info { border-top: 1px dotted #888; padding-top: 8px; text-align: center; font-family: Arial, \"Liberation Sans\", sans-serif; font-size: 8px; line-height: 1.5; }\r\n  .generated { text-align: right; font-family: \"Times New Roman\", \"Liberation Serif\", serif; font-size: 8px; margin-top: 5px; }\r\n  .generated .ar { display: inline; text-align: right; font-size: 8px; }\r\n</style>\r\n<div id=\"header-html\" class=\"hidden-pdf\">\r\n        {% if letter_head and not no_letterhead %}\r\n            {{ letter_head }}\r\n        {% endif %}\r\n    </div>\r\n</head>\r\n<body>\r\n\r\n<div class=\"invoice-sheet\">\r\n\r\n    \r\n\r\n  <!-- INVOICE NO + DATES -->\r\n  <table class=\"inv-head inv-no-table\">\r\n    <tr>\r\n      <td style=\"width:38%;\"><span class=\"lbl-grey\">Invoice No. / <span class=\"ar\">\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</span></span></td>\r\n      <td><span class=\"inv-no\">{{doc.name}}</span></td>\r\n    </tr>\r\n  </table>\r\n  <table class=\"inv-head inv-date-row\">\r\n    <tr>\r\n      <td style=\"width:26%;\"><span class=\"lbl-grey\">Invoice Date / <span class=\"ar\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</span></span></td>\r\n      <td style=\"width:14%;\"><b>{{doc.posting_date or ''}}</b></td>\r\n      <td style=\"width:40%;\"><span class=\"lbl-green\">Invoice Due Date / <span class=\"ar\">\u062a\u0627\u0631\u064a\u062e \u0627\u0633\u062a\u062d\u0642\u0627\u0642 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</span></span></td>\r\n      <td><b>{{ frappe.utils.getdate(doc.due_date).strftime('%d/%m/%Y') if doc.due_date else '' }}</b></td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- PARTIES -->\r\n  <table class=\"parties\">\r\n    <tr>\r\n      <td>\r\n        <div class=\"party-title\">Messers..<span class=\"ar\">\u0627\u0644\u0633\u0627\u062f\u0629</span></div>\r\n        <div>{{doc.customer_name}} | CR No:4512</div>\r\n        <div>{{doc.address_display}}</div>\r\n      </td>\r\n      <td>\r\n        <div class=\"party-title\">Shipper....<span class=\"ar\">\u0627\u0644\u0634\u0627\u062d\u0646</span></div>\r\n        <div>{{doc.shipping_address_name or ''}}</div>\r\n        <div>{{doc.shipping_address or ''}}</div>\r\n      </td>\r\n    </tr>\r\n  </table>\r\n\r\n  {% set ref_doc = frappe.get_doc(\"Import-Export Order\",doc.custom_importexport_order) %}\r\n  <!-- SHIPMENT DETAILS -->\r\n  <div class=\"sec-title\">Shipment Details<span class=\"ar\">\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0634\u062d\u0646\u0629</span></div>\r\n  <table class=\"ship-table\">\r\n    <tr>\r\n      <td class=\"lbl\">Our Ref..<span class=\"ar\">\u0645\u0631\u062c\u0639\u0646\u0627</span></td><td class=\"val\">{{ref_doc.name or ''}}</td>\r\n      <td class=\"lbl\">Clients Ref.<span class=\"ar\">\u0645\u0631\u062c\u0639 \u0627\u0644\u0639\u0645\u064a\u0644</span></td><td class=\"val\">{{ref_doc.clients_reference or ''}}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"lbl\">Departure<span class=\"ar\">\u0627\u0644\u0645\u063a\u0627\u062f\u0631\u0629</span></td><td class=\"val\">{{ref_doc.expected_routing[-1].from or ''}}</td>\r\n      <td class=\"lbl\">Destination<span class=\"ar\">\u0627\u0644\u0648\u062c\u0647\u0629</span></td><td class=\"val\">{{ref_doc.expected_routing[-1].to or ''}}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"lbl\">Carrier<span class=\"ar\">\u0627\u0644\u0646\u0627\u0642\u0644</span></td><td class=\"val\">{{ref_doc.expected_routing[-1].vessel or ''}}&nbsp;{{ref_doc.expected_routing[-1].voyage or ''}}</td>\r\n      <td class=\"lbl\">Arrived on<span class=\"ar\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0648\u0635\u0648\u0644</span></td><td class=\"val\">{{ frappe.utils.getdate(ref_doc.expected_routing[-1].eta.split('Arrived On ')[-1]).strftime('%d-%m-%Y') if ref_doc.expected_routing and ref_doc.expected_routing[-1].eta else '' }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"lbl\">M.B/L No.<span class=\"ar\">\u0631\u0642\u0645 \u0628\u0648\u0644\u064a\u0635\u0629 \u0627\u0644\u0634\u062d\u0646</span></td><td class=\"val\">{{ref_doc.bl_no or ''}}</td>\r\n      <td class=\"lbl\">M.B/L Date<span class=\"ar\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u0648\u0644\u064a\u0635\u0629</span></td><td class=\"val\">{{ref_doc.bl_date or ''}}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"lbl\">No.-Packages<span class=\"ar\">\u0639\u062f\u062f \u0627\u0644\u0637\u0631\u0648\u062f</span></td><td class=\"val\">{{ref_doc.no_of_packs or ''}} CARTONS</td>\r\n      <td class=\"lbl\">Weight<span class=\"ar\">\u0627\u0644\u0648\u0632\u0646</span></td><td class=\"val\">{{ref_doc.gross_weight_kg or ''}} Kgs </td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"lbl\">Cargo<span class=\"ar\">\u0627\u0644\u0628\u0636\u0627\u0639\u0629</span></td><td class=\"val\">{{ref_doc.cargo_type or ''}}</td>\r\n      <td class=\"lbl\">Volume<span class=\"ar\">\u0627\u0644\u062d\u062c\u0645</span></td><td class=\"val\">{{ref_doc.volume_cbm or ''}} CBM</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"lbl\">Load Type<span class=\"ar\">\u0646\u0648\u0639 \u0627\u0644\u062d\u0645\u0648\u0644\u0629</span></td><td class=\"val\">{{ref_doc.load_type or ''}}</td>\r\n     </tr>\r\n  </table>\r\n  \r\n  <!-- CHARGES -->\r\n  <table class=\"charges-table\">\r\n    <thead>\r\n      <tr>\r\n        <th>Description of Charges<span class=\"ar\">\u0648\u0635\u0641 \u0627\u0644\u0631\u0633\u0648\u0645</span></th>\r\n        <th class=\"right\">Amount QAR<span class=\"ar\">\u0627\u0644\u0645\u0628\u0644\u063a (\u0631\u064a\u0627\u0644 \u0642\u0637\u0631\u064a)</span></th>\r\n      </tr>\r\n    </thead>\r\n    <tbody>\r\n      {% for i in doc.items %}\r\n        <tr><td>{{i.item_name or ''}}</td><td class=\"right\">{{i.amount or ''}}</td></tr>\r\n      {% endfor %}\r\n    </tbody>\r\n  </table>\r\n\r\n  <div class=\"legend\">P - Paid Charges <span class=\"ar