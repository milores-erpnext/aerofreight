{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-09-22 16:07:10.285204",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Purchase Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "\r\n<style>\r\n/* =========================================================\r\n   A4 COMPACT PURCHASE ORDER\r\n   ========================================================= */\r\n\r\n@page {\r\n    size: A4;\r\n    margin: 7mm 7mm 7mm 7mm;\r\n}\r\n\r\nhtml,\r\nbody {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 9.5px;\r\n    color: #222;\r\n\r\n    line-height: 1.2;\r\n}\r\n\r\n.po-page {\r\n    width: 100%;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   GENERAL\r\n   ========================================================= */\r\n\r\n.po-page table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border-spacing: 0;\r\n}\r\n\r\n.po-page td,\r\n.po-page th {\r\n    vertical-align: top;\r\n}\r\n\r\n.text-left {\r\n    text-align: left;\r\n}\r\n\r\n.text-center {\r\n    text-align: center;\r\n}\r\n\r\n.text-right {\r\n    text-align: right;\r\n}\r\n\r\np {\r\n    margin: 0 0 2px 0;\r\n}\r\n\r\nimg {\r\n    max-width: 100%;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   LETTER HEAD / LOGO\r\n   ========================================================= */\r\n\r\n.letter-head {\r\n    width: 100%;\r\n    margin: 0 !important;\r\n    padding: 0 0 3px 0 !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   DOCUMENT INFORMATION\r\n   ========================================================= */\r\n\r\n.info-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin: 2px 0 4px 0;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.info-table td {\r\n    border: 1px solid #555;\r\n    padding: 3px 5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.info-label {\r\n    width: 15%;\r\n    font-weight: 700;\r\n    background: #f3f3f3;\r\n    font-size: 8.5px;\r\n    white-space: nowrap;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   BILINGUAL ENGLISH / ARABIC LABELS\r\n   ========================================================= */\r\n\r\n.bilingual-label {\r\n    line-height: 1.15;\r\n}\r\n\r\n.bilingual-label .english-label {\r\n    display: block;\r\n    font-size: inherit;\r\n    font-weight: 700;\r\n    color: #444;\r\n    line-height: 1.15;\r\n}\r\n\r\n.bilingual-label .arabic-label {\r\n    display: block;\r\n    direction: rtl;\r\n    unicode-bidi: embed;\r\n    font-size: inherit;\r\n    font-weight: 600;\r\n    color: #222;\r\n    margin-top: 1px;\r\n    line-height: 1.2;\r\n    font-family: Arial, Tahoma, sans-serif;\r\n}\r\n\r\n.info-value {\r\n    width: 35%;\r\n    font-size: 9px;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   INTRODUCTION\r\n   ========================================================= */\r\n\r\n.intro-text {\r\n    margin: 3px 0 4px 0;\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    line-height: 1.15;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   ITEMS\r\n   ========================================================= */\r\n\r\n.items-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin: 0;\r\n    page-break-inside: auto;\r\n}\r\n\r\n.items-table thead {\r\n    display: table-header-group;\r\n}\r\n\r\n.items-table tr {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.items-table th {\r\n    background: #f3f3f3;\r\n    border: 1px solid #555;\r\n    padding: 3px 4px;\r\n    font-size: 8.5px;\r\n    font-weight: 700;\r\n    line-height: 1.05;\r\n}\r\n\r\n.items-table td {\r\n    border: 1px solid #ccc;\r\n    padding: 3px 4px;\r\n    font-size: 9px;\r\n    line-height: 1.1;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   TOTALS\r\n   ========================================================= */\r\n\r\n.totals-wrapper {\r\n    margin-top: 3px;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.totals-table {\r\n    width: 42%;\r\n    margin-left: auto;\r\n    border-collapse: collapse;\r\n}\r\n\r\n.totals-table td {\r\n    padding: 2px 5px;\r\n    font-size: 9px;\r\n    line-height: 1.05;\r\n}\r\n\r\n.total-label {\r\n    text-align: right;\r\n    color: #555;\r\n}\r\n\r\n.grand-total {\r\n    font-weight: 700;\r\n    font-size: 10px !important;\r\n    border-top: 1px solid #555;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   AMOUNT IN WORDS\r\n   ========================================================= */\r\n\r\n.words-table {\r\n    margin-top: 3px;\r\n    border: 1px solid #ccc;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.words-table td {\r\n    padding: 3px 5px;\r\n    font-size: 9px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.words-label {\r\n    width: 15%;\r\n    font-weight: 700;\r\n    white-space: nowrap;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   EXCHANGE RATE\r\n   ========================================================= */\r\n\r\n.exchange-rate {\r\n    margin-top: 3px;\r\n    padding: 3px 4px;\r\n    border-top: 1px solid #555;\r\n    border-bottom: 1px solid #555;\r\n    font-size: 9px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.exchange-title {\r\n    font-weight: 700;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   ADDITIONAL INFORMATION\r\n   ========================================================= */\r\n\r\n.details-table {\r\n    margin-top: 3px;\r\n    border: 1px solid #ccc;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.details-table td {\r\n    border: 1px solid #ccc;\r\n    padding: 3px 5px;\r\n    font-size: 8.5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.details-label {\r\n    width: 18%;\r\n    font-weight: 700;\r\n    background: #f7f7f7;\r\n    font-size: 8px !important;\r\n}\r\n\r\n.details-value {\r\n    width: 32%;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   TERMS AND CONDITIONS\r\n   ========================================================= */\r\n\r\n.terms {\r\n    margin-top: 4px;\r\n\r\n    font-size: 8.5px;\r\n\r\n    line-height: 1.1;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.terms-title {\r\n    font-weight: 700;\r\n\r\n    font-size: 9px;\r\n\r\n    margin-bottom: 2px;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   APPROVAL / SIGNATURE\r\n   PDF-SAFE HORIZONTAL TABLE\r\n   ========================================================= */\r\n\r\n.approval {\r\n    width: 100%;\r\n\r\n    margin-top: 4px;\r\n\r\n    border-top: 1px solid #555;\r\n\r\n    padding-top: 3px;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n\r\n/*\r\n * IMPORTANT:\r\n * Do NOT use display:flex here.\r\n * wkhtmltopdf handles normal HTML tables much\r\n * more reliably than flexbox.\r\n */\r\n\r\n.approval-signatures {\r\n    width: 100% !important;\r\n\r\n    border-collapse: collapse !important;\r\n    border-spacing: 0 !important;\r\n\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n\r\n    table-layout: auto !important;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures tr {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures td {\r\n    text-align: center !important;\r\n\r\n    vertical-align: bottom !important;\r\n\r\n    border: none !important;\r\n\r\n    padding: 0 8px 0 8px !important;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   SIGNATURE IMAGE\r\n   ========================================================= */\r\n\r\n.approval-signature-image {\r\n    height: 32px;\r\n\r\n    width: 100%;\r\n\r\n    text-align: center;\r\n\r\n    vertical-align: bottom;\r\n\r\n    margin-bottom: 2px;\r\n\r\n    overflow: hidden;\r\n}\r\n\r\n.approval-signature-image img {\r\n    display: inline-block;\r\n\r\n    max-width: 105px !important;\r\n\r\n    max-height: 30px !important;\r\n\r\n    width: auto !important;\r\n\r\n    height: auto !important;\r\n\r\n    object-fit: contain;\r\n}\r\n.approval-signature-image,\r\n.approval-signature-image * {\r\n    overflow: hidden !important;\r\n    max-height: 30px !important;\r\n}\r\n\r\n.approval-signature-image {\r\n    scrollbar-width: none;       /* Firefox */\r\n    -ms-overflow-style: none;    /* old Edge/IE */\r\n}\r\n\r\n.approval-signature-image::-webkit-scrollbar {\r\n    display: none;               /* WebKit / wkhtmltopdf */\r\n}\r\n\r\n\r\n/* =========================================================\r\n   APPROVER NAME\r\n   ========================================================= */\r\n\r\n.approval-user-name {\r\n    font-size: 8.5px;\r\n\r\n    font-weight: 700;\r\n\r\n    color: #222;\r\n\r\n    border-top: 1px solid #777;\r\n\r\n    padding-top: 2px;\r\n\r\n    line-height: 1.05;\r\n\r\n    white-space: normal;\r\n\r\n    word-wrap: break-word;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   APPROVER EMAIL\r\n   ========================================================= */\r\n\r\n.approval-user-email {\r\n    font-size: 7.5px;\r\n\r\n    color: #666;\r\n\r\n    margin-top: 1px;\r\n\r\n    line-height: 1;\r\n\r\n    word-break: break-all;\r\n\r\n    white-space: normal;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   PRINT / PDF SAFETY\r\n   ========================================================= */\r\n\r\ntable,\r\ntr,\r\ntd,\r\nth {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.approval,\r\n.approval-signatures,\r\n.approval-signatures tr,\r\n.approval-signatures td,\r\n.details-table,\r\n.words-table,\r\n.totals-wrapper,\r\n.terms {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n</style>\r\n\r\n\r\n<!-- =======================================================\r\n     LETTER HEAD / LOGO\r\n     ======================================================= -->\r\n\r\n{% if letter_head and not no_letterhead %}\r\n\r\n<div class=\"letter-head\">\r\n    {{ letter_head }}\r\n</div>\r\n\r\n{% endif %}\r\n\r\n\r\n<!-- =======================================================\r\n     MAIN PURCHASE ORDER\r\n     ======================================================= -->\r\n\r\n<div class=\"po-page\">\r\n\r\n\r\n    <!-- ===================================================\r\n         STATUS\r\n         =================================================== -->\r\n\r\n    {% if doc.meta.is_submittable and doc.docstatus == 2 %}\r\n\r\n    <div class=\"text-center\">\r\n        <b>{{ doc.doctype }}</b>\r\n        <br>\r\n        <b>CANCELLED</b>\r\n    </div>\r\n\r\n    {% endif %}\r\n\r\n\r\n    {% if doc.meta.is_submittable\r\n        and doc.docstatus == 0\r\n        and (print_settings == None or print_settings.add_draft_heading) %}\r\n\r\n    <div class=\"text-center\">\r\n        <b>{{ doc.doctype }}</b>\r\n        <br>\r\n        <b>DRAFT</b>\r\n    </div>\r\n\r\n    {% endif %}\r\n\r\n\r\n    <!-- ===================================================\r\n         SUPPLIER / PO DETAILS\r\n         =================================================== -->\r\n\r\n    <table class=\"info-table\">\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Order To\") }}\r\n\r\n\r\n                </span>\r\n\r\n\r\n                <span class=\"arabic-label\">\r\n\r\n\r\n                    \u0625\u0644\u0649 \u0627\u0644\u0645\u0648\u0631\u062f\r\n\r\n\r\n                </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.supplier_name or '' }}\r\n            </td>\r\n\r\n            <td class=\"info-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Purchase Order\") }}\r\n\r\n\r\n                </span>\r\n\r\n\r\n                <span class=\"arabic-label\">\r\n\r\n\r\n                    \u0623\u0645\u0631 \u0627\u0644\u0634\u0631\u0627\u0621\r\n\r\n\r\n                </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.name or '' }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Attention To\") }}\r\n\r\n\r\n                </span>\r\n\r\n\r\n                <span class=\"arabic-label\">\r\n\r\n\r\n                    \u0639\u0646\u0627\u064a\u0629\r\n\r\n\r\n                </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.address_display or '' }}\r\n            </td>\r\n\r\n            <td class=\"info-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Purchase Order Date\") }}\r\n\r\n\r\n                </span>\r\n\r\n\r\n                <span class=\"arabic-label\">\r\n\r\n\r\n                    \u062a\u0627\u0631\u064a\u062e \u0623\u0645\u0631 \u0627\u0644\u0634\u0631\u0627\u0621\r\n\r\n\r\n                </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ frappe.utils.format_date(doc.transaction_date) }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Project Name\") }}\r\n\r\n\r\n                </span>\r\n\r\n\r\n                <span class=\"arabic-label\">\r\n\r\n\r\n                    \u0627\u0633\u0645 \u0627\u0644\u0645\u0634\u0631\u0648\u0639\r\n\r\n\r\n                </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {% set project_name = frappe.db.get_value(\r\n                    \"Project\",\r\n                    doc.project,\r\n                    \"project_name\"\r\n                ) %}\r\n                {{ doc.project or '' }}{% if doc.project and project_name %} - {{ project_name }}{% endif %}\r\n            </td>\r\n\r\n            <td class=\"info-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Purchase Type / Mode\") }}\r\n\r\n\r\n                </span>\r\n\r\n\r\n                <span class=\"arabic-label\">\r\n\r\n\r\n                    \u0646\u0648\u0639 / \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0634\u0631\u0627\u0621\r\n\r\n\r\n                </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.custom_purchase_type or '' }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Incoterms\") }}\r\n\r\n\r\n                </span>\r\n\r\n\r\n                <span class=\"arabic-label\">\r\n\r\n\r\n                    \u0634\u0631\u0648\u0637 \u0627\u0644\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u062f\u0648\u0644\u064a\u0629\r\n\r\n\r\n                </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ doc.incoterm or '' }}\r\n            </td>\r\n\r\n            <td class=\"info-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Required By\") }}\r\n\r\n\r\n                </span>\r\n\r\n\r\n                <span class=\"arabic-label\">\r\n\r\n\r\n                    \u0645\u0637\u0644\u0648\u0628 \u0628\u062d\u0644\u0648\u0644\r\n\r\n\r\n                </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n                {{ frappe.utils.format_date(doc.schedule_date)\r\n                   if doc.schedule_date else '' }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n    </table>\r\n\r\n\r\n    <!-- ===================================================\r\n         INTRODUCTION\r\n         =================================================== -->\r\n\r\n    <div class=\"intro-text\">\r\n\r\n        This Purchase Order is issued for you to proceed with the\r\n        supply, provision of documentation and delivery of the following.\r\n\r\n    </div>\r\n\r\n\r\n    <!-- ===================================================\r\n         ITEMS\r\n         =================================================== -->\r\n\r\n    <table class=\"items-table\">\r\n\r\n        <thead>\r\n\r\n            <tr>\r\n\r\n                <th style=\"width:6%;\" class=\"text-center bilingual-label\">\r\n\r\n\r\n                    <span class=\"english-label\">\r\n\r\n\r\n                        {{ _(\"No\") }}\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                    <span class=\"arabic-label\">\r\n\r\n\r\n                        \u0627\u0644\u0631\u0642\u0645\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                </th>\r\n\r\n                <th style=\"width:18%;\" class=\"text-left bilingual-label\">\r\n\r\n\r\n                    <span class=\"english-label\">\r\n\r\n\r\n                        {{ _(\"Item Code\") }}\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                    <span class=\"arabic-label\">\r\n\r\n\r\n                        \u0631\u0645\u0632 \u0627\u0644\u0635\u0646\u0641\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                </th>\r\n\r\n                <th style=\"width:32%;\" class=\"text-left bilingual-label\">\r\n\r\n\r\n                    <span class=\"english-label\">\r\n\r\n\r\n                        {{ _(\"Item Name\") }}\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                    <span class=\"arabic-label\">\r\n\r\n\r\n                        \u0627\u0633\u0645 \u0627\u0644\u0635\u0646\u0641\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                </th>\r\n\r\n                <th style=\"width:14%;\" class=\"text-right bilingual-label\">\r\n\r\n\r\n                    <span class=\"english-label\">\r\n\r\n\r\n                        {{ _(\"Quantity\") }}\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                    <span class=\"arabic-label\">\r\n\r\n\r\n                        \u0627\u0644\u0643\u0645\u064a\u0629\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                </th>\r\n\r\n                <th style=\"width:15%;\" class=\"text-right bilingual-label\">\r\n\r\n\r\n                    <span class=\"english-label\">\r\n\r\n\r\n                        {{ _(\"Rate\") }}\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                    <span class=\"arabic-label\">\r\n\r\n\r\n                        \u0627\u0644\u0633\u0639\u0631\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                </th>\r\n\r\n                <th style=\"width:15%;\" class=\"text-right bilingual-label\">\r\n\r\n\r\n                    <span class=\"english-label\">\r\n\r\n\r\n                        {{ _(\"Amount\") }}\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                    <span class=\"arabic-label\">\r\n\r\n\r\n                        \u0627\u0644\u0645\u0628\u0644\u063a\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                </th>\r\n\r\n            </tr>\r\n\r\n        </thead>\r\n\r\n\r\n        <tbody>\r\n\r\n            {% for item in doc.items %}\r\n\r\n            <tr>\r\n\r\n                <td class=\"text-center\">\r\n                    {{ loop.index }}\r\n                </td>\r\n\r\n                <td>\r\n                    {{ item.item_code or '' }}\r\n                </td>\r\n\r\n                <td>\r\n                    {{ item.item_name or '' }}\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n\r\n                    {{ item.get_formatted(\"qty\", 0) }}\r\n\r\n                    {{ item.uom or '' }}\r\n\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n\r\n                    {{ item.get_formatted(\"net_rate\", doc) }}\r\n\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n\r\n                    {{ item.get_formatted(\"net_amount\", doc) }}\r\n\r\n                </td>\r\n\r\n            </tr>\r\n\r\n            {% endfor %}\r\n\r\n        </tbody>\r\n\r\n    </table>\r\n\r\n\r\n    <!-- ===================================================\r\n         TOTALS\r\n         =================================================== -->\r\n\r\n    <div class=\"totals-wrapper\">\r\n\r\n        <table class=\"totals-table\">\r\n\r\n            <tr>\r\n\r\n                <td class=\"total-label bilingual-label\">\r\n\r\n\r\n                    <span class=\"english-label\">\r\n\r\n\r\n                        {{ _(\"Sub Total\") }}\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                    <span class=\"arabic-label\">\r\n\r\n\r\n                        \u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0641\u0631\u0639\u064a\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n                    {{ doc.get_formatted(\"total\", doc) }}\r\n                </td>\r\n\r\n            </tr>\r\n\r\n\r\n            {% if doc.apply_discount_on == \"Net Total\" %}\r\n\r\n            <tr>\r\n\r\n                <td class=\"total-label\">\r\n\r\n                    {{ _(\"Discount\") }}\r\n                    ({{ doc.additional_discount_percentage }}%)\r\n\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n\r\n                    {{ doc.get_formatted(\"discount_amount\", doc) }}\r\n\r\n                </td>\r\n\r\n            </tr>\r\n\r\n            {% endif %}\r\n\r\n\r\n            {% for tax in doc.taxes %}\r\n\r\n                {% if (tax.tax_amount or\r\n                       print_settings.print_taxes_with_zero_amount)\r\n                      and\r\n                      (not tax.included_in_print_rate or\r\n                       doc.flags.show_inclusive_tax_in_print) %}\r\n\r\n                <tr>\r\n\r\n                    <td class=\"total-label bilingual-label\">\r\n\r\n                        <span class=\"english-label\">\r\n                            {{ tax.get_formatted(\"description\") }}\r\n                            ({{ tax.get_formatted(\"rate\") }}%)\r\n                        </span>\r\n\r\n                        <span class=\"arabic-label\">\r\n                            \u0627\u0644\u0636\u0631\u064a\u0628\u0629\r\n                        </span>\r\n\r\n                    </td>\r\n\r\n                    <td class=\"text-right\">\r\n\r\n                        {{ tax.get_formatted(\"tax_amount\") }}\r\n\r\n                    </td>\r\n\r\n                </tr>\r\n\r\n                {% endif %}\r\n\r\n            {% endfor %}\r\n\r\n\r\n            {% if doc.apply_discount_on == \"Grand Total\" %}\r\n\r\n            <tr>\r\n\r\n                <td class=\"total-label bilingual-label\">\r\n\r\n                    <span class=\"english-label\">\r\n                        {{ _(\"Discount\") }}\r\n                        ({{ doc.additional_discount_percentage }}%)\r\n                    </span>\r\n\r\n                    <span class=\"arabic-label\">\r\n                        \u0627\u0644\u062e\u0635\u0645\r\n                    </span>\r\n\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n\r\n                    {{ doc.get_formatted(\"discount_amount\", doc) }}\r\n\r\n                </td>\r\n\r\n            </tr>\r\n\r\n            {% endif %}\r\n\r\n\r\n            <tr>\r\n\r\n                <td class=\"total-label grand-total bilingual-label\">\r\n\r\n\r\n                    <span class=\"english-label\">\r\n\r\n\r\n                        {{ _(\"Grand Total\") }}\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                    <span class=\"arabic-label\">\r\n\r\n\r\n                        \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0644\u064a\r\n\r\n\r\n                    </span>\r\n\r\n\r\n                </td>\r\n\r\n                <td class=\"text-right grand-total\">\r\n                    {{ doc.get_formatted(\"grand_total\", doc) }}\r\n                </td>\r\n\r\n            </tr>\r\n\r\n        </table>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- ===================================================\r\n         AMOUNT IN WORDS\r\n         =================================================== -->\r\n\r\n    <table class=\"words-table\">\r\n\r\n        <tr>\r\n\r\n            <td class=\"words-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Amount in Words\") }}\r\n\r\n\r\n                </span>\r\n\r\n\r\n                <span class=\"arabic-label\">\r\n\r\n\r\n                    \u0627\u0644\u0645\u0628\u0644\u063a \u0628\u0627\u0644\u0643\u0644\u0645\u0627\u062a\r\n\r\n\r\n                </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td>\r\n                {{ doc.in_words or '' }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n    </table>\r\n\r\n\r\n    <!-- ===================================================\r\n         EXCHANGE RATE\r\n         =================================================== -->\r\n\r\n    <div class=\"exchange-rate\">\r\n\r\n        <span class=\"exchange-title bilingual-label\">\r\n            <span class=\"english-label\">\r\n                {{ _(\"Applied Rates of Exchange\") }}:\r\n            </span>\r\n            <span class=\"arabic-label\">\r\n                \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0635\u0631\u0641 \u0627\u0644\u0645\u0637\u0628\u0642\u0629\r\n            </span>\r\n        </span>\r\n\r\n        <span>\r\n\r\n            {{ doc.currency }} @\r\n            {{ doc.conversion_rate or 1.0000 }}\r\n\r\n        </span>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- ===================================================\r\n         ADDITIONAL INFORMATION\r\n         =================================================== -->\r\n\r\n    <table class=\"details-table\">\r\n\r\n        <tr>\r\n\r\n            <td class=\"details-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Consignee\") }}\r\n\r\n\r\n                </span>\r\n\r\n\r\n                <span class=\"arabic-label\">\r\n\r\n\r\n                    \u0627\u0644\u0645\u0631\u0633\u0644 \u0625\u0644\u064a\u0647\r\n\r\n\r\n                </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.shipping_address or '' }}\r\n\r\n                <br>\r\n\r\n                {{ doc.shipping_address_display or '' }}\r\n\r\n            </td>\r\n\r\n            <td class=\"details-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Payment Terms\") }}\r\n\r\n\r\n                </span>\r\n\r\n\r\n                <span class=\"arabic-label\">\r\n\r\n\r\n                    \u0634\u0631\u0648\u0637 \u0627\u0644\u062f\u0641\u0639\r\n\r\n\r\n                </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.payment_terms_template or '' }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"details-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Origin Country