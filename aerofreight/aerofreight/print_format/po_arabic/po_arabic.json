          </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.custom_insurance or '' }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"details-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Country of Origin Documentation\") }}\r\n\r\n\r\n                </span>\r\n\r\n\r\n                <span class=\"arabic-label\">\r\n\r\n\r\n                    \u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0628\u0644\u062f \u0627\u0644\u0645\u0646\u0634\u0623\r\n\r\n\r\n                </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.custom_country_of_origin_documentation or '' }}\r\n\r\n            </td>\r\n\r\n            <td class=\"details-label bilingual-label\">\r\n\r\n\r\n                <span class=\"english-label\">\r\n\r\n\r\n                    {{ _(\"Shipping Marks\") }}\r\n\r\n\r\n                </span>\r\n\r\n\r\n                <span class=\"arabic-label\">\r\n\r\n\r\n                    \u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0634\u062d\u0646\r\n\r\n\r\n                </span>\r\n\r\n\r\n            </td>\r\n\r\n            <td class=\"details-value\">\r\n\r\n                {{ doc.custom_shipping_marks or '' }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n    </table>\r\n\r\n\r\n    <!-- ===================================================\r\n         TERMS AND CONDITIONS\r\n         =================================================== -->\r\n\r\n    {% if doc.terms %}\r\n\r\n    <div class=\"terms\">\r\n\r\n        <div class=\"terms-title bilingual-label\">\r\n            <span class=\"english-label\">\r\n                {{ _(\"Terms and Conditions\") }}\r\n            </span>\r\n            <span class=\"arabic-label\">\r\n                \u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645\r\n            </span>\r\n        </div>\r\n\r\n        <div>\r\n            {{ doc.terms }}\r\n        </div>\r\n\r\n    </div>\r\n\r\n    {% endif %}\r\n\r\n\r\n    <!-- ===================================================\r\n         APPROVAL / SIGNATURE\r\n         =================================================== -->\r\n\r\n    <div class=\"approval\">\r\n\r\n        {% set all_approval = frappe.get_all(\r\n            \"Comment\",\r\n            filters={\r\n                \"comment_type\": \"Workflow\",\r\n                \"reference_doctype\": \"Purchase Order\",\r\n                \"reference_name\": doc.name\r\n            },\r\n            fields=[\"comment_email\", \"creation\"],\r\n            order_by=\"creation asc\"\r\n        ) %}\r\n\r\n\r\n        <table class=\"approval-signatures\">\r\n\r\n            <tr>\r\n\r\n                {% for approval in all_approval %}\r\n\r\n                    {% if approval.comment_email %}\r\n\r\n                        {% set user_data = frappe.db.get_value(\r\n                            \"User\",\r\n                            approval.comment_email,\r\n                            [\r\n                                \"full_name\",\r\n                                \"email\",\r\n                                \"email_signature\"\r\n                            ],\r\n                            as_dict=True\r\n                        ) %}\r\n\r\n\r\n                        {% if user_data and user_data.email_signature %}\r\n\r\n                        <td>\r\n\r\n                            <div class=\"approval-signature-image\">\r\n                                {% if user_data.email_signature %}\r\n                                    {{ user_data.email_signature | safe }}\r\n                                {% endif %}\r\n                            </div>\r\n\r\n\r\n                            <div class=\"approval-user-name\">\r\n\r\n                                {{ user_data.full_name\r\n                                   or approval.comment_email }}\r\n\r\n                            </div>\r\n\r\n\r\n                            <div class=\"approval-user-email\">\r\n\r\n                                {{ user_data.email\r\n                                   or approval.comment_email }}\r\n\r\n                            </div>\r\n\r\n                        </td>\r\n\r\n                        {% endif %}\r\n\r\n                    {% endif %}\r\n\r\n                {% endfor %}\r\n\r\n            </tr>\r\n\r\n        </table>\r\n\r\n    </div>\r\n\r\n\r\n</div>",
