{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-10-14 19:53:47.567175",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Delivery Note",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<meta name=\"pdfkit-margin-top\" content=\"5mm\">\r\n<meta name=\"pdfkit-margin-bottom\" content=\"15mm\">\r\n<meta name=\"pdfkit-margin-left\" content=\"1mm\">\r\n<meta name=\"pdfkit-margin-right\" content=\"1mm\">\r\n<style>\r\n/* =========================================================\r\n   DELIVERY NOTE (A4 COMPACT)\r\n   ========================================================= */\r\n@page {\r\n    size: A4;\r\n    margin: 0;\r\n}\r\n\r\nhtml,\r\nbody {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    width: 100% !important;\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 9.5px;\r\n    color: #111;\r\n    line-height: 1.2;\r\n}\r\n\r\n.print-format {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    max-width: 100% !important;\r\n}\r\n\r\n.dn-page {\r\n    width: 100%;\r\n    margin: 0;\r\n}\r\n\r\n/* ONE place that controls the side space */\r\n.dn-page,\r\n#footer-html {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    padding-left: 20px !important;\r\n    padding-right: 20px !important;\r\n}\r\n/* =========================================================\r\n   GENERAL & TABLES\r\n   ========================================================= */\r\n\r\n.dn-page table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border-spacing: 0;\r\n}\r\n\r\n.dn-page td,\r\n.dn-page th {\r\n    vertical-align: top;\r\n}\r\n\r\n.text-left { text-align: left; }\r\n.text-center { text-align: center; }\r\n.text-right { text-align: right; }\r\n\r\np { margin: 0 0 2px 0; }\r\nimg { max-width: 100%; }\r\n\r\n/* =========================================================\r\n   LETTER HEAD & DOCUMENT TITLE\r\n   ========================================================= */\r\n.letter-head {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    width: 100% !important;\r\n    height: auto !important;\r\n    margin: 0 !important;\r\n    padding: 30px 20px 0 20px !important;   /* top | right | bottom | left */\r\n}\r\n\r\n.letter-head img {\r\n    display: block;\r\n    width: 100% !important;\r\n    height: 130px !important;   /* use \"auto\" to keep the original proportions */\r\n}\r\n.dn-title-wrapper {\r\n    width: 100%;\r\n    border-bottom: 1.5px solid #2855a6;\r\n    margin: 4px 0 6px 0;\r\n    text-align: center;\r\n    padding-bottom: 2px;\r\n}\r\n\r\n.dn-title {\r\n    font-size: 14px;\r\n    font-weight: 500;\r\n    letter-spacing: 0.8px;\r\n    text-transform: uppercase;\r\n}\r\n\r\n/* =========================================================\r\n   TOP HEADER TABLE\r\n   ========================================================= */\r\n\r\n.header-table {\r\n    width: 100%;\r\n    border: 1px solid #333;\r\n    margin-bottom: 6px;\r\n}\r\n\r\n.header-table td {\r\n    border: 1px solid #333;\r\n    padding: 3px 5px;\r\n    font-size: 9px;\r\n    line-height: 1.2;\r\n}\r\n\r\n.header-label {\r\n    font-weight: 600;\r\n    color: #111;\r\n    white-space: nowrap;\r\n}\r\n\r\n.header-val {\r\n    color: #000;\r\n}\r\n\r\n/* =========================================================\r\n   ITEMS TABLE (GROUPED BY WAREHOUSE)\r\n   ========================================================= */\r\n\r\n.items-table {\r\n    width: 100%;\r\n    border: 1px solid #333;\r\n    margin: 0;\r\n    page-break-inside: auto;\r\n}\r\n\r\n.items-table thead {\r\n    display: table-header-group;\r\n}\r\n\r\n.items-table tr {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.items-table th {\r\n    background-color: #abbcd4;\r\n    color: #111;\r\n    border: 1px solid #333;\r\n    padding: 3px 4px;\r\n    font-size: 8.5px;\r\n    font-weight: 700;\r\n    line-height: 1.05;\r\n}\r\n\r\n.warehouse-header-row td {\r\n    background-color: #fff;\r\n    font-weight: 700;\r\n    font-size: 9px;\r\n    padding: 3px 5px;\r\n    border: 1px solid #333;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.items-table td {\r\n    border: 1px solid #333;\r\n    padding: 3px 4px;\r\n    font-size: 8.5px;\r\n    line-height: 1.15;\r\n}\r\n\r\n/* =========================================================\r\n   TOTALS BAR\r\n   ========================================================= */\r\n\r\n.total-strip {\r\n    width: 100%;\r\n    border: 1px solid #333;\r\n    border-top: none;\r\n    background-color: #8daed9;\r\n    font-weight: 700;\r\n    font-size: 9px;\r\n}\r\n\r\n.total-strip td {\r\n    padding: 3px 5px;\r\n    border: 1px solid #333;\r\n}\r\n\r\n/* =========================================================\r\n   REMARKS & NOTICE\r\n   ========================================================= */\r\n\r\n.remarks-container {\r\n    margin-top: 10px;\r\n    font-size: 8.5px;\r\n    color: #111;\r\n    line-height: 1.35;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.remarks-title {\r\n    font-weight: 700;\r\n    margin-bottom: 4px;\r\n}\r\n\r\n/* =========================================================\r\n   GOODS CONDITION & SIGNATURE BOX\r\n   ========================================================= */\r\n\r\n.received-condition-text {\r\n    text-align: center;\r\n    font-size: 10.5px;\r\n    font-weight: 500;\r\n    margin-top: 45px;\r\n    margin-bottom: 8px;\r\n    color: #111;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.signature-box-table {\r\n    width: 100%;\r\n    border: 1px solid #333;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.signature-box-table td {\r\n    padding: 12px 14px;\r\n    vertical-align: top;\r\n    font-size: 9px;\r\n    line-height: 1.3;\r\n}\r\n\r\n.stamp-text {\r\n    font-size: 7.5px;\r\n    font-style: italic;\r\n    color: #555;\r\n    margin-top: 14px;\r\n    text-align: right;\r\n}\r\n\r\n/* =========================================================\r\n   PRINT / PDF SAFETY\r\n   ========================================================= */\r\n\r\ntable, tr, td, th {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.header-table,\r\n.items-table,\r\n.total-strip,\r\n.signature-box-table {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n</style>\r\n\r\n<!-- =======================================================\r\n     LETTER HEAD / LOGO\r\n     ======================================================= -->\r\n\r\n{% if letter_head and not no_letterhead %}\r\n<!--<div class=\"letter-head\">-->\r\n<div>\r\n    {{ letter_head }}\r\n</div>\r\n{% endif %}\r\n\r\n<div class=\"dn-page\">\r\n    <!-- ===================================================\r\n         TITLE: DELIVERY NOTE\r\n         =================================================== -->\r\n\r\n    <div class=\"dn-title-wrapper\">\r\n        <span class=\"dn-title\">DELIVERY NOTE<br>{{doc.status}}</span>\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         HEADER TABLE\r\n         =================================================== -->\r\n\r\n    {# Dynamic Address Resolution #}\r\n    {% set customer_addr = doc.address_display %}\r\n    {% if not customer_addr and doc.customer_address %}\r\n        {% set customer_addr = frappe.db.get_value(\"Address\", doc.customer_address, \"display\") %}\r\n    {% endif %}\r\n    {% if not customer_addr %}\r\n        {% set customer_addr = doc.shipping_address_display or doc.shipping_address or '' %}\r\n    {% endif %}\r\n\r\n    {# Fetch PO Date from linked Sales Order if missing on Delivery Note #}\r\n    {% set po_date = doc.po_date %}\r\n    {% if not po_date %}\r\n        {% for item in doc.items %}\r\n            {% if item.against_sales_order and not po_date %}\r\n                {% set po_date = frappe.db.get_value(\"Sales Order\", item.against_sales_order, \"po_date\") %}\r\n            {% endif %}\r\n        {% endfor %}\r\n    {% endif %}\r\n\r\n    <table class=\"header-table\">\r\n        <tr>\r\n            <td style=\"width: 16%;\" class=\"header-label\">Delivery Note No</td>\r\n            <td style=\"width: 48%;\" class=\"header-val\"><b>{{ doc.name }}</b></td>\r\n            <td style=\"width: 14%;\" class=\"header-label\">Date</td>\r\n            <td style=\"width: 22%;\" class=\"header-val\"><b>{{ frappe.utils.format_date(doc.posting_date) }}</b></td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"header-label\">Delivered To</td>\r\n            <td class=\"header-val\"><b>{{ doc.customer_name or '' }}</b></td>\r\n            <td class=\"header-label\">Ref / LPO No</td>\r\n            <td class=\"header-val\"><b>{{ doc.po_no or '' }}</b></td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"header-label\">Address</td>\r\n            <td class=\"header-val\">\r\n                {{ customer_addr | safe if customer_addr else '' }}\r\n            </td>\r\n            <td class=\"header-label\">Ref / LPO Date</td>\r\n            <td class=\"header-val\">\r\n                <b>{{ frappe.utils.format_date(po_date) if po_date else '' }}</b>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         ITEMS TABLE (WITH WAREHOUSE SEPARATORS)\r\n         =================================================== -->\r\n\r\n    <table class=\"items-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width: 5%;\" class=\"text-center\">Sl No</th>\r\n                <th style=\"width: 26%;\" class=\"text-left\">Code</th>\r\n                <th style=\"width: 47%;\" class=\"text-left\">Item Description</th>\r\n                <th style=\"width: 10%;\" class=\"text-center\">Item Unit</th>\r\n                <th style=\"width: 12%;\" class=\"text-right\">Qty</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {# Determine unique warehouses #}\r\n            {% set warehouses = [] %}\r\n            {% for itm in doc.items %}\r\n                {% set wh = itm.warehouse or doc.set_warehouse or 'WAREHOUSE' %}\r\n                {% if wh not in warehouses %}\r\n                    {% set _ = warehouses.append(wh) %}\r\n                {% endif %}\r\n            {% endfor %}\r\n\r\n            {% set counter = namespace(val=1) %}\r\n            {% for wh in warehouses %}\r\n                <tr class=\"warehouse-header-row\">\r\n                    <td colspan=\"5\">\r\n                        <b>{{ wh }}</b>\r\n                    </td>\r\n                </tr>\r\n\r\n                {% for item in doc.items %}\r\n                    {% if (item.warehouse or doc.set_warehouse or 'WAREHOUSE') == wh %}\r\n                    <tr>\r\n                        <td class=\"text-center\">{{ counter.val }}</td>\r\n                        <td><b>{{ item.item_code or '' }}</b></td>\r\n                        <td>\r\n                            {{ item.item_name or '' }}\r\n                            {% if item.description and item.description != item.item_name %}\r\n                                <div style=\"font-size: 7.5px; color: #444;\">{{ item.description | striptags }}</div>\r\n                            {% endif %}\r\n                            {% if item.batch_no %}\r\n                                <div style=\"font-size: 7px; color: #555;\">Batch: {{ item.batch_no }}</div>\r\n                            {% endif %}\r\n                        </td>\r\n                        <td class=\"text-center\">{{ item.uom or '' }}</td>\r\n                        <td class=\"text-right\">\r\n                            {{ \"%.3f\"|format(item.qty or 0) }}\r\n                        </td>\r\n                    </tr>\r\n                    {% set counter.val = counter.val + 1 %}\r\n                    {% endif %}\r\n                {% endfor %}\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         TOTALS STRIP\r\n         =================================================== -->\r\n    \r\n    <table class=\"total-strip\">\r\n        <tr>\r\n            <td style=\"width: 78%; border-right: none;\"></td>\r\n            <td style=\"width: 10%; text-align: center; border-left: none;\">\r\n                Total\r\n            </td>\r\n            <td style=\"width: 12%; text-align: right;\">\r\n                {{ \"%.3f\"|format(doc.total_qty or 0) }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         REMARKS & NOTICE\r\n         =================================================== -->\r\n\r\n    <div class=\"remarks-container\">\r\n        <div class=\"remarks-title\">Remarks</div>\r\n        {% if doc.remarks %}\r\n            <div>{{ doc.remarks }}</div>\r\n        {% endif %}\r\n        <div>\r\n            Any discrepancy in the supply related to this delivery note should be notified in writing within 7 days from the date of receipt. Goods returned after 7 days will not be accepted\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         GOODS CONDITION & SIGNATURE BOX\r\n         =================================================== -->\r\n\r\n    <div class=\"received-condition-text\">\r\n        Received the above goods in good order and condition\r\n    </div>\r\n\r\n    <table class=\"signature-box-table\">\r\n        <tr>\r\n            <td style=\"width: 50%;\">\r\n                <div style=\"margin-bottom: 30px;\">\r\n                    <b>Prepared By</b>\r\n                </div>\r\n                <div>\r\n                    <b>Checked By</b>\r\n                </div>\r\n            </td>\r\n\r\n            <td style=\"width: 50%; text-align: right;\">\r\n                <div style=\"margin-bottom: 22px;\">\r\n                    <b>Received By</b><br>\r\n                    <span>(Name)</span>\r\n                </div>\r\n                <div>\r\n                    <b>Signature</b>\r\n                </div>\r\n                <div class=\"stamp-text\">\r\n                    Stamp\r\n                </div>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</div>\r\n<div id=\"footer-html\" class=\"visible-pdf\">\r\n    <table style=\"width:100%; border-top:1px solid #999; border-collapse:collapse;\r\n                  font-family:Arial, Helvetica, sans-serif; font-size:9px; color:#111;\">\r\n        <tr>\r\n            <td style=\"width:50%; text-align:left; padding-top:3px;\">\r\n                Page <span class=\"page\"></span> of <span class=\"topage\"></span>\r\n            </td>\r\n            <td style=\"width:50%; text-align:right; padding-top:3px;\">\r\n                Generated By {{ doc.owner }}\r\n                &nbsp;&nbsp;\r\n                {{ frappe.utils.format_datetime(doc.creation, \"dd-mm-yyyy HH:mm:ss\") }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</div>",
