{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-10-14 19:53:07.254939",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Payment Entry",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<meta name=\"pdfkit-margin-top\" content=\"5mm\">\r\n<meta name=\"pdfkit-margin-bottom\" content=\"15mm\">\r\n<meta name=\"pdfkit-margin-left\" content=\"1mm\">\r\n<meta name=\"pdfkit-margin-right\" content=\"1mm\">\r\n<style>\r\n/* =========================================================\r\n   A4 COMPACT PAYMENT ENTRY (RECEIPT / PAYMENT VOUCHER)\r\n   ========================================================= */\r\n@page {\r\n    size: A4;\r\n    margin: 0;\r\n}\r\n\r\nhtml,\r\nbody {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    width: 100% !important;\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 11px;\r\n    line-height: 1.3;\r\n    color: #222;\r\n}\r\n\r\n.print-format {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    max-width: 100% !important;\r\n}\r\n\r\n.pe-page {\r\n    width: 100%;\r\n    margin: 0;\r\n}\r\n\r\n/* ONE place that controls the side space */\r\n.pe-page,\r\n#footer-html {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    padding-left: 20px !important;\r\n    padding-right: 20px !important;\r\n}\r\n/* =========================================================\r\n   GENERAL\r\n   ========================================================= */\r\n\r\n.pe-page table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border-spacing: 0;\r\n}\r\n\r\n.pe-page td,\r\n.pe-page th {\r\n    vertical-align: top;\r\n}\r\n\r\n.text-left { text-align: left; }\r\n.text-center { text-align: center; }\r\n.text-right { text-align: right; }\r\n\r\np { margin: 0 0 2px 0; }\r\nimg { max-width: 100%; }\r\n\r\n/* =========================================================\r\n   LETTER HEAD / LOGO\r\n   ========================================================= */\r\n\r\n.letter-head {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    width: 100% !important;\r\n    height: auto !important;\r\n    margin: 0 !important;\r\n    padding: 30px 20px 0 20px !important;   /* top | right | bottom | left */\r\n}\r\n\r\n.letter-head img {\r\n    display: block;\r\n    width: 100% !important;\r\n    height: 130px !important;   /* use \"auto\" to keep the original proportions */\r\n}\r\n/* =========================================================\r\n   DOCUMENT INFORMATION\r\n   ========================================================= */\r\n\r\n.info-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin: 2px 0 4px 0;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.info-table td {\r\n    border: 1px solid #555;\r\n    padding: 3px 5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.info-label {\r\n    width: 16%;\r\n    font-weight: 700;\r\n    background: #f3f3f3;\r\n    font-size: 10px;\r\n    white-space: nowrap;\r\n}\r\n\r\n.info-value {\r\n    width: 34%;\r\n    font-size: 10.5px;\r\n}\r\n\r\n/* =========================================================\r\n   INTRODUCTION / NOTICE\r\n   ========================================================= */\r\n\r\n.intro-text {\r\n    margin: 3px 0 4px 0;\r\n    font-size: 11px;\r\n    font-weight: 600;\r\n    line-height: 1.15;\r\n}\r\n\r\n/* =========================================================\r\n   ITEMS / REFERENCES TABLE\r\n   ========================================================= */\r\n\r\n.items-table {\r\n    width: 100%;\r\n    border: 1px solid #555;\r\n    margin: 0;\r\n    page-break-inside: auto;\r\n}\r\n\r\n.items-table thead {\r\n    display: table-header-group;\r\n}\r\n\r\n.items-table tr {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.items-table th {\r\n    background: #f3f3f3;\r\n    border: 1px solid #555;\r\n    padding: 3px 4px;\r\n    font-size: 10px;\r\n    font-weight: 700;\r\n    line-height: 1.05;\r\n    color:#000;\r\n}\r\n\r\n.items-table td {\r\n    border: 1px solid #000;\r\n    padding: 3px 4px;\r\n    font-size: 10.5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n/* =========================================================\r\n   TOTALS\r\n   ========================================================= */\r\n.totals-wrapper {\r\n    margin-top: 3px;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.pe-page .totals-table {\r\n    width: 44% !important;\r\n    margin-left: auto;\r\n    border-collapse: collapse;\r\n    table-layout: fixed;          /* same column widths in both tables */\r\n}\r\n\r\n.totals-table td {\r\n    padding: 1px 3px;\r\n    font-size: 10.5px;\r\n    line-height: 1.05;\r\n    white-space: nowrap;\r\n}\r\n\r\n/* label takes the extra space but is right-aligned, so it hugs the amount */\r\n.totals-table td.total-label {\r\n    text-align: right;\r\n    color: #555;\r\n    padding-right: 4px !important;\r\n}\r\n\r\n.totals-table td:last-child {\r\n    width: 110px;                 /* amount column; widen if amounts get long */\r\n    text-align: right;\r\n    padding-left: 0 !important;\r\n}\r\n\r\n.pe-page .totals-table td.total-divider {\r\n    width: auto !important;\r\n    padding: 0 !important;\r\n    height: 1px;\r\n    line-height: 1px;\r\n    font-size: 1px;\r\n    border-top: 1px solid #555 !important;\r\n}\r\n\r\n/* grand total text (no border needed any more) */\r\n.pe-page .totals-table td.grand-total {\r\n    font-weight: 700;\r\n    font-size: 12px !important;\r\n    padding-top: 2px;\r\n}\r\n\r\n.total-line {\r\n    width: 100%;\r\n    height: 0;\r\n    border-top: 1px solid #555;\r\n    margin: 2px 0;\r\n}\r\n/* =========================================================\r\n   AMOUNT IN WORDS\r\n   ========================================================= */\r\n\r\n.words-table {\r\n    margin-top: 3px;\r\n    border: 1px solid #ccc;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.words-table td {\r\n    padding: 3px 5px;\r\n    font-size: 10.5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.words-label {\r\n    width: 16%;\r\n    font-weight: 700;\r\n    white-space: nowrap;\r\n}\r\n\r\n/* =========================================================\r\n   EXCHANGE RATE\r\n   ========================================================= */\r\n\r\n.exchange-rate {\r\n    margin-top: 3px;\r\n    padding: 3px 4px;\r\n    border-top: 1px solid #555;\r\n    border-bottom: 1px solid #555;\r\n    font-size: 10.5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.exchange-title {\r\n    font-weight: 700;\r\n}\r\n\r\n/* =========================================================\r\n   ADDITIONAL INFORMATION / BANKING DETAILS\r\n   ========================================================= */\r\n\r\n.details-table {\r\n    margin-top: 3px;\r\n    border: 1px solid #ccc;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.details-table td {\r\n    border: 1px solid #ccc;\r\n    padding: 3px 5px;\r\n    font-size: 10px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.details-label {\r\n    width: 18%;\r\n    font-weight: 700;\r\n    background: #f7f7f7;\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n.details-value {\r\n    width: 32%;\r\n}\r\n\r\n/* =========================================================\r\n   TERMS / REMARKS\r\n   ========================================================= */\r\n\r\n.terms {\r\n    margin-top: 4px;\r\n    font-size: 10px;\r\n    line-height: 1.1;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.terms-title {\r\n    font-weight: 700;\r\n    font-size: 11px;\r\n    margin-bottom: 2px;\r\n}\r\n\r\n/* =========================================================\r\n   APPROVAL / SIGNATURE\r\n   ========================================================= */\r\n\r\n.approval {\r\n    width: 100%;\r\n    margin-top: 6px;\r\n    border-top: 1px solid #555;\r\n    padding-top: 3px;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures {\r\n    width: 100% !important;\r\n    border-collapse: collapse !important;\r\n    border-spacing: 0 !important;\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    table-layout: fixed !important;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures tr,\r\n.approval-signatures td {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures td {\r\n    text-align: center !important;\r\n    vertical-align: bottom !important;\r\n    border: none !important;\r\n    padding: 0 10px !important;\r\n}\r\n\r\n.approval-signature-image {\r\n    height: 35px;\r\n    min-height: 35px;\r\n    width: 100%;\r\n    text-align: center;\r\n    vertical-align: bottom;\r\n    margin-bottom: 2px;\r\n    overflow: hidden;\r\n}\r\n\r\n.approval-signature-image img {\r\n    display: inline-block;\r\n    max-width: 110px !important;\r\n    max-height: 32px !important;\r\n    width: auto !important;\r\n    height: auto !important;\r\n    object-fit: contain;\r\n}\r\n\r\n.approval-user-name {\r\n    font-size: 10px;\r\n    font-weight: 700;\r\n    color: #222;\r\n    border-top: 1px solid #777;\r\n    padding-top: 2px;\r\n    line-height: 1.05;\r\n    white-space: normal;\r\n    word-wrap: break-word;\r\n}\r\n\r\n.approval-user-role {\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    color: #555;\r\n    line-height: 1;\r\n    margin-top: 1px;\r\n}\r\n\r\n.approval-user-email {\r\n    font-size: 8.5px;\r\n    color: #777;\r\n    margin-top: 1px;\r\n    line-height: 1;\r\n    word-break: break-all;\r\n    white-space: normal;\r\n}\r\n\r\n/* =========================================================\r\n   PRINT / PDF SAFETY\r\n   ========================================================= */\r\n\r\ntable, tr, td, th {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.approval,\r\n.approval-signatures,\r\n.approval-signatures tr,\r\n.approval-signatures td,\r\n.details-table,\r\n.words-table,\r\n.totals-wrapper,\r\n.terms {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n</style>\r\n\r\n<!-- =======================================================\r\n     LETTER HEAD / LOGO\r\n     ======================================================= -->\r\n\r\n<div id=\"header-html\" class=\"hidden-pdf\">\r\n    {% if letter_head and not no_letterhead %}\r\n        {{ letter_head }}\r\n    {% endif %}\r\n</div>\r\n\r\n<!-- =======================================================\r\n     MAIN PAYMENT ENTRY\r\n     ======================================================= -->\r\n\r\n<div class=\"pe-page\">\r\n\r\n    <!-- ===================================================\r\n         STATUS\r\n         =================================================== -->\r\n\r\n  \r\n    <div class=\"text-center\">\r\n        <b>Payment Entry\r\n        <br>{{doc.workflow_state or doc.status}}\r\n        </b>\r\n    </div>\r\n \r\n\r\n\r\n    <!-- ===================================================\r\n         PARTY & VOUCHER DETAILS (CLEAN 3-ROW GRID)\r\n         =================================================== -->\r\n\r\n    <table class=\"info-table\">\r\n        <tr>\r\n            <td class=\"info-label\">{{ _(\"Party Name\") }} ({{ doc.party_type }})</td>\r\n            <td class=\"info-value\"><b>{{ doc.party_name or doc.party or '' }}</b></td>\r\n            <td class=\"info-label\">{{ _(\"Voucher No\") }}</td>\r\n            <td class=\"info-value\"><b>{{ doc.name or '' }}</b></td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"info-label\">{{ _(\"Payment Type / Mode\") }}</td>\r\n            <td class=\"info-value\"><b>{{ doc.payment_type or '' }}</b> - {{ doc.mode_of_payment or '' }}</td>\r\n            <td class=\"info-label\">{{ _(\"Posting Date\") }}</td>\r\n            <td class=\"info-value\">{{ frappe.utils.format_date(doc.posting_date) }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"info-label\">{{ _(\"Project Name\") }}</td>\r\n            <td class=\"info-value\">\r\n                {% set project_name = frappe.db.get_value(\"Project\", doc.project, \"project_name\") if doc.project else None %}\r\n                {{ doc.project or '' }}{% if doc.project and project_name %} - {{ project_name }}{% endif %}\r\n            </td>\r\n            <td class=\"info-label\">{{ _(\"Cheque / Ref Details\") }}</td>\r\n            <td class=\"info-value\">\r\n                {{ doc.reference_no or '' }}\r\n                {% if doc.reference_date %}\r\n                    {% if doc.reference_no %} (dt. {{ frappe.utils.format_date(doc.reference_date) }}){% else %}{{ frappe.utils.format_date(doc.reference_date) }}{% endif %}\r\n                {% endif %}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         INTRODUCTION\r\n         =================================================== -->\r\n    <br>\r\n    <div class=\"intro-text\">\r\n        {% if doc.payment_type == \"Receive\" %}\r\n            Receipt Voucher acknowledging payment collected against the invoices/documents specified below:\r\n        {% elif doc.payment_type == \"Pay\" %}\r\n            Payment Voucher acknowledging disbursement issued against the supplier bills/documents specified below:\r\n        {% else %}\r\n            Internal transfer/settlement voucher booked as detailed below:\r\n        {% endif %}\r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         REFERENCES / ALLOCATED INVOICES TABLE\r\n         =================================================== -->\r\n\r\n    <table class=\"items-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width:6%;\" class=\"text-center\">{{ _(\"No\") }}</th>\r\n                <th style=\"width:20%;\" class=\"text-left\">{{ _(\"Voucher Type\") }}</th>\r\n                <th style=\"width:24%;\" class=\"text-left\">{{ _(\"Voucher No\") }}</th>\r\n                <th style=\"width:16%;\" class=\"text-right\">{{ _(\"Invoice Total\") }}</th>\r\n                <th style=\"width:17%;\" class=\"text-right\">{{ _(\"Outstanding\") }}</th>\r\n                <th style=\"width:17%;\" class=\"text-right\">{{ _(\"Allocated Amount\") }}</th>\r\n            </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n            {% if doc.references and doc.references | length > 0 %}\r\n                {% for ref in doc.references %}\r\n                <tr>\r\n                    <td class=\"text-center\">{{ loop.index }}</td>\r\n                    <td>{{ ref.reference_doctype }}</td>\r\n                    <td>\r\n                        {{ ref.reference_name }}\r\n                        {% if ref.bill_no %}\r\n                            <div style=\"font-size: 7.5px; color: #555;\">Bill: {{ ref.bill_no }}</div>\r\n                        {% endif %}\r\n                    </td>\r\n                    <td class=\"text-right\">{{ ref.get_formatted(\"total_amount\", doc) }}</td>\r\n                    <td class=\"text-right\">{{ ref.get_formatted(\"outstanding_amount\", doc) }}</td>\r\n                    <td class=\"text-right\"><b>{{ ref.get_formatted(\"allocated_amount\", doc) }}</b></td>\r\n                </tr>\r\n                {% endfor %}\r\n            {% else %}\r\n                <tr>\r\n                    <td class=\"text-center\">1</td>\r\n                    <td colspan=\"4\">{{ _(\"Direct / Advance Payment without against reference\") }}</td>\r\n                    <td class=\"text-right\"><b>{{ doc.get_formatted(\"paid_amount\" if doc.payment_type == \"Pay\" else \"received_amount\", doc) }}</b></td>\r\n                </tr>\r\n            {% endif %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         TOTALS\r\n         =================================================== -->\r\n\r\n        <div class=\"totals-wrapper\">\r\n    \r\n        <!-- Part 1: allocated + deductions -->\r\n        <table class=\"totals-table\">\r\n            <tr>\r\n                <td class=\"total-label\">{{ _(\"Total Allocated\") }}</td>\r\n                <td class=\"text-right\">{{ doc.get_formatted(\"total_allocated_amount\", doc) }}</td>\r\n            </tr>\r\n    \r\n            {% if doc.unallocated_amount and doc.unallocated_amount > 0 %}\r\n            <tr>\r\n                <td class=\"total-label\">{{ _(\"Unallocated / Advance\") }}</td>\r\n                <td class=\"text-right\">{{ doc.get_formatted(\"unallocated_amount\", doc) }}</td>\r\n            </tr>\r\n            {% endif %}\r\n    \r\n            {% for ded in doc.deductions %}\r\n                {% if ded.amount %}\r\n                <tr>\r\n                    <td class=\"total-label\">{{ ded.description or ded.account }}</td>\r\n                    <td class=\"text-right\">{{ ded.get_formatted(\"amount\", doc) }}</td>\r\n                </tr>\r\n                {% endif %}\r\n            {% endfor %}\r\n        </table>\r\n    \r\n        <!-- full-width line (spans the whole page content width) -->\r\n        <div class=\"total-line\"></div>\r\n    \r\n        <!-- Part 2: grand total -->\r\n        <table class=\"totals-table\">\r\n            <tr>\r\n                <td class=\"total-label grand-total\">\r\n                    {{ _(\"Total Paid\") if doc.payment_type == \"Pay\" else _(\"Total Received\") }}\r\n                </td>\r\n                <td class=\"text-right grand-total\">\r\n                    {{ doc.get_formatted(\"paid_amount\" if doc.payment_type == \"Pay\" else \"received_amount\", doc) }}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    \r\n    </div>\r\n\r\n    <!-- ===================================================\r\n         AMOUNT IN WORDS\r\n         =================================================== -->\r\n\r\n    <table class=\"words-table\">\r\n        <tr>\r\n            <td class=\"words-label\">{{ _(\"Amount in Words\") }}</td>\r\n            <td>\r\n                {% set target_amount = doc.paid_amount if doc.payment_type == \"Pay\" else doc.received_amount %}\r\n                {% set target_curr = doc.paid_from_account_currency if doc.payment_type == \"Pay\" else doc.paid_to_account_currency %}\r\n                {{ doc.base_in_words or frappe.utils.money_in_words(target_amount, target_curr) }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n    \r\n    <table class=\"words-table\">\r\n        <td style=\"width: 48%; vertical-align: top; font-size: 12px; page-break-inside: avoid;\">\r\n    \r\n            {% set ledger_entries = frappe.db.sql(\"\"\"\r\n                SELECT\r\n                    COALESCE(SUM(debit), 0) - COALESCE(SUM(credit), 0) AS balance\r\n                FROM `tabGL Entry`\r\n                WHERE party_type = 'Customer'\r\n                  AND party = %s\r\n                  AND is_cancelled = 0\r\n            \"\"\", (doc.customer,), as_dict=True) %}\r\n    \r\n            {% if ledger_entries %}\r\n                <p>\r\n                    <b>Current Balance:</b> &nbsp;&nbsp;&nbsp;&nbsp;{{ ledger_entries[0].balance }}\r\n                </p>\r\n            {% endif %}\r\n    \r\n        </td>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         EXCHANGE RATE\r\n         =================================================== -->\r\n\r\n    {% set comp_currency = frappe.db.get_value('Company', doc.company, 'default_currency') %}\r\n    {% set txn_currency = doc.paid_from_account_currency if doc.payment_type == \"Pay\" else doc.paid_to_account_currency %}\r\n    {% if txn_currency != comp_currency %}\r\n    <div class=\"exchange-rate\">\r\n        <span class=\"exchange-title\">{{ _(\"Applied Rates of Exchange\") }}:</span>\r\n        <span>{{ txn_currency }} @ {{ doc.source_exchange_rate or doc.target_exchange_rate or 1.0000 }}</span>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ===================================================\r\n         ADDITIONAL INFORMATION / BANK ACCOUNTS\r\n         =================================================== -->\r\n\r\n    <table class=\"details-table\">\r\n        <tr>\r\n            <td class=\"details-label\">{{ _(\"Paid From (Account)\") }}</td>\r\n            <td class=\"details-value\">{{ doc.paid_from or '' }}</td>\r\n            <td class=\"details-label\">{{ _(\"Bank / Account Name\") }}</td>\r\n            <td class=\"details-value\">{{ doc.bank or doc.party_bank_account or 'N/A' }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"details-label\">{{ _(\"Paid To (Account)\") }}</td>\r\n            <td class=\"details-value\">{{ doc.paid_to or '' }}</td>\r\n            <td class=\"details-label\">{{ _(\"Cost Center\") }}</td>\r\n            <td class=\"details-value\">{{ doc.cost_center or '' }}</td>\r\n        </tr>\r\n\r\n        {% if doc.custom_origin_country or doc.custom_shipping_marks %}\r\n        <tr>\r\n            <td class=\"details-label\">{{ _(\"Origin Country\") }}</td>\r\n            <td class=\"details-value\">{{ doc.custom_origin_country or '' }}</td>\r\n            <td class=\"details-label\">{{ _(\"Shipping Marks\") }}</td>\r\n            <td class=\"details-value\">{{ doc.custom_shipping_marks or '' }}</td>\r\n        </tr>\r\n        {% endif %}\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         TERMS / REMARKS\r\n         =================================================== -->\r\n\r\n    {% if doc.remarks %}\r\n    <div class=\"terms\">\r\n        <div class=\"terms-title\">{{ _(\"Remarks / Notes\") }}</div>\r\n        <div>{{ doc.remarks }}</div>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ===================================================\r\n         APPROVAL / SIGNATURE / ACKNOWLEDGEMENT SECTION\r\n         =================================================== -->\r\n\r\n    <div class=\"approval\">\r\n\r\n        {# Check for Workflow log comments #}\r\n        {% set all_approval = frappe.get_all(\r\n            \"Comment\",\r\n            filters={\r\n                \"comment_type\": \"Workflow\",\r\n                \"reference_doctype\": \"Payment Entry\",\r\n                \"reference_name\": doc.name\r\n            },\r\n            fields=[\"comment_email\", \"creation\"],\r\n            order_by=\"creation asc\"\r\n        ) %}\r\n\r\n        <table class=\"approval-signatures\">\r\n            <tr>\r\n                {% if all_approval and all_approval | length > 0 %}\r\n                    {# Workflow history approvals #}\r\n                    {% for approval in all_approval %}\r\n                        {% if approval.comment_email %}\r\n                            {% set user_data = frappe.db.get_value(\r\n                                \"User\",\r\n                                approval.comment_email,\r\n                                [\"full_name\", \"email\", \"email_signature\"],\r\n                                as_dict=True\r\n                            ) %}\r\n                            <td>\r\n                                <div class=\"approval-signature-image\">\r\n                                    {% if user_data and user_data.email_signature %}\r\n                                        {{ user_data.email_signature | safe }}\r\n                                    {% endif %}\r\n                                </div>\r\n                                <div class=\"approval-user-name\">\r\n                                    {{ (user_data.full_name if user_data else '') or approval.comment_email }}\r\n                                </div>\r\n                                <div class=\"approval-user-role\">{{ _(\"Authorized Signatory\") }}</div>\r\n                                <div class=\"approval-user-email\">\r\n                                    {{ (user_data.email if user_data else '') or approval.comment_email }}\r\n                                </div>\r\n                            </td>\r\n                        {% endif %}\r\n                    {% endfor %}\r\n\r\n                {% else %}\r\n                    {# Fallback: Prepared By & Verified / Approved By #}\r\n                    {% set creator_data = frappe.db.get_value(\"User\", doc.owner, [\"full_name\", \"email\", \"email_signature\"], as_dict=True) %}\r\n                    {% set approver_data = frappe.db.get_value(\"User\", doc.modified_by, [\"full_name\", \"email\", \"email_signature\"], as_dict=True) if doc.docstatus >= 1 else None %}\r\n\r\n                    <td>\r\n                        <div class=\"approval-signature-image\">\r\n                            {% if creator_data and creator_data.email_signature %}\r\n                                {{ creator_data.email_signature | safe }}\r\n                            {% endif %}\r\n                        </div>\r\n                        <div class=\"approval-user-name\">\r\n                            {{ creator_data.full_name if creator_data else doc.owner }}\r\n                        </div>\r\n                        <div class=\"approval-user-role\">{{ _(\"Prepared By\") }}</div>\r\n                        <div class=\"approval-user-email\">\r\n                            {{ creator_data.email if creator_data else doc.owner }}\r\n                        </div>\r\n                    </td>\r\n\r\n                    {% if approver_data and doc.docstatus >= 1 %}\r\n                    <td>\r\n                        <div class=\"approval-signature-image\">\r\n                            {% if approver_data.email_signature %}\r\n                                {{ approver_data.email_signature | safe }}\r\n                            {% endif %}\r\n                        </div>\r\n                        <div class=\"approval-user-name\">\r\n                            {{ approver_data.full_name or doc.modified_by }}\r\n                        </div>\r\n                        <div class=\"approval-user-role\">{{ _(\"Checked / Approved By\") }}</div>\r\n                        <div class=\"approval-user-email\">\r\n                            {{ approver_data.email or doc.modified_by }}\r\n                        </div>\r\n                    </td>\r\n                    {% endif %}\r\n                {% endif %}\r\n\r\n                {# Third Party / Receiver's Acknowledgment Column #}\r\n                <td>\r\n                    <div class=\"approval-signature-image\"></div>\r\n                    <div class=\"approval-user-name\">&nbsp;</div>\r\n                    <div class=\"approval-user-role\">\r\n                    Received By \r\n                    </div>\r\n                    <div class=\"approval-user-email\">{{ _(\"Date: _______\") }}</div>\r\n                </td>\r\n            </tr>\r\n        </table>\r\n        <br><br>\r\n        <!-- Chairman and Managing Director Signatures -->\r\n        <table style=\"width: 100%; margin-left: auto; border-collapse: collapse;\r\n                      table-layout: fixed; page-break-inside: avoid;\">\r\n            <tr>\r\n                <td style=\"width: 50%; height: 100px; border: 1px solid #999;\r\n                           text-align: center !important; vertical-align: middle !important;\">\r\n                    <span style=\"display: block; width: 100%; text-align: center; color: #ccc;\">\r\n                        (signature)\r\n                    </span>\r\n                </td>\r\n                <td style=\"width: 50%; height: 100px; border: 1px solid #999;\r\n                           text-align: center !important; vertical-align: middle !important;\">\r\n                    <span style=\"display: block; width: 100%; text-align: center; color: #ccc;\">\r\n                        (signature)\r\n                    </span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"border: 1px solid #999; text-align: center;\r\n                           vertical-align: middle; padding: 3px;\">\r\n                    Chairman\r\n                </td>\r\n                <td style=\"border: 1px solid #999; text-align: center;\r\n                           vertical-align: middle; padding: 3px;\">\r\n                    Managing Director\r\n                </td>\r\n            </tr>\r\n        </table>\r\n\r\n    </div>\r\n</div>\r\n    <div id=\"footer-html\" class=\"visible-pdf\">\r\n        <table style=\"width:100%; border-top:1px solid #999; border-collapse:collapse;\r\n                      font-family:Arial, Helvetica, sans-serif; font-size:9px; color:#111;\">\r\n            <tr>\r\n                <td style=\"width:50%; text-align:left; padding-top:3px;\">\r\n                    Page <span class=\"page\"></span> of <span class=\"topage\"></span>\r\n                </td>\r\n                <td style=\"width:50%; text-align:right; padding-top:3px;\">\r\n                    Generated By {{ doc.owner }}\r\n                    &nbsp;&nbsp;\r\n                    {{ frappe.utils.format_datetime(doc.creation, \"dd-mm-yyyy HH:mm:ss\") }}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n",
