 "html": "<meta name=\"pdfkit-margin-top\" content=\"5mm\">\r\n<meta name=\"pdfkit-margin-bottom\" content=\"20mm\">\r\n<meta name=\"pdfkit-margin-left\" content=\"10mm\">\r\n<meta name=\"pdfkit-margin-right\" content=\"10mm\">\r\n<style>\r\n    html,\r\n    body {\r\n        font-weight: 500;\r\n        line-height: 1.2;\r\n    }\r\n\r\n    /*.print-format {*/\r\n    /*    font-size: 9.5px;*/\r\n    /*    color: #000;*/\r\n    /*    max-width: 100% !important;*/\r\n    /*}*/\r\n\r\n  /* ---------- Header ---------- */\r\n  .kp-head { position: relative; height: 130px; margin-bottom: 8px; }\r\n  .kp-swoosh { position: absolute; left: 0; top: 40px; width: 62%; height: 80px; background: linear-gradient(90deg, #ececec 0%, #f6f6f6 60%, #fff 100%); border-radius: 100px 0 0 0; border-bottom: 1px solid #999; }\r\n  .kp-brand { font-family: Arial, sans-serif; font-size: 34px; letter-spacing: 1px; color: #1e7b34; line-height: 1; margin-top: -2px; }\r\n  .kp-brand-sub { font-family: Arial, sans-serif; font-size: 6.5px; color: #aaa; background: #1e7b34; color: #fff; display: inline-block; padding: 0 3px; letter-spacing: .5px; }\r\n  .kp-ar { font-size: 28px; font-weight: 700; color: #111; line-height: 1.1; direction: rtl; }\r\n  .kp-contact { font-size: 7.5px; font-weight: 700; line-height: 1.35; color: #111; }\r\n  .kp-title { text-align: right; font-family: \"Times New Roman\", serif; font-weight: 700; font-size: 26px; padding-right: 26px; margin: 4px 0 6px; }\r\n\r\n  /* ---------- Main grid ---------- */\r\n  table.kp { width: 100%; border-collapse: collapse; table-layout: fixed; border: 1px solid #c8c8c8; }\r\n  table.kp td { border: 1px solid #c8c8c8; padding: 4px 6px; vertical-align: middle; font-size: 12px; height: 26px; }\r\n  table.kp th {\r\n      font-weight: 700 !important;\r\n      color: #000 !important;\r\n      font-size: 10.5px;\r\n      padding: 4px 3px;\r\n      white-space: nowrap;\r\n    }\r\n  /*.blue { background: #1e90ff; color: #fff; font-weight: 400; }*/\r\n  /*th.blue { text-align: left; font-size: 11.5px; height: 24px; }*/\r\n  .grey { background: #bfbfbf; }\r\n  .r { text-align: right; } .c { text-align: center; } .b { font-weight: 700; }\r\n  .lbl { font-size: 12.5px; padding-left: 14px !important; }\r\n  .val { font-weight: 700; font-size: 11.5px; padding-left: 10px !important; }\r\n  .val.n { font-weight: 400; }\r\n  .addr { font-size: 12.5px; padding-left: 8px !important; line-height: 1.25; vertical-align: top; }\r\n  .nb-t { border-top: none !important; } .nb-b { border-bottom: none !important; }\r\n  .noline td { border-top: none; border-bottom: none; }\r\n  .items td { font-size: 11px; height: 24px; }\r\n  .words td { font-size: 11px; font-weight: 700; height: 24px; }\r\n\r\n  /* ---------- Footer ---------- */\r\n  .kp-note { font-size: 12px; margin-top: 0; line-height: 1.35; }\r\n  .kp-terms { font-size: 10.5px; margin-top: 10px; }\r\n  .kp-sign { display: flex; justify-content: space-between; width: 80%; margin: 18px 0 0 0; font-family: \"Times New Roman\", serif; font-weight: 700; font-size: 13px; padding: 0 70px 0 85px; }\r\n    .kp-foot { position: absolute; left: 10mm; right: 10mm; bottom: 0; display: flex; justify-content: space-between; font-size: 11px; }\r\n  .kp-foot b { font-family: \"Times New Roman\", serif; font-size: 10px; }\r\n  .kp-body { height: 400px; }\r\n  .kp-spacer { height: 100px; }\r\n</style>\r\n\r\n<div>\r\n    {{letter_head}}\r\n  <div class=\"kp-title\">INVOICE</div>\r\n\r\n  <!-- ================= INFO BLOCK + ITEMS ================= -->\r\n  <table class=\"kp\">\r\n    <colgroup>\r\n      <col style=\"width:6%\">   <!-- SR NO -->\r\n      <col style=\"width:17%\">  <!-- CODE -->\r\n      <col style=\"width:28%\">  <!-- DESCRIPTION -->\r\n      <col style=\"width:10.5%\"> <!-- QUANTITY -->\r\n      <col style=\"width:10.5%\"> <!-- UNIT PRICE -->\r\n      <col style=\"width:6.5%\">  <!-- UOM -->\r\n      <col style=\"width:11.5%\">  <!-- DISCOUNT -->\r\n      <col style=\"width:11.5%\"> <!-- TOTAL -->\r\n    </colgroup>\r\n\r\n    <!-- Row 1 -->\r\n    <tr>\r\n      <td colspan=\"3\" class=\"grey\" style=\"font-size:12px\"><b>BILL TO :</b></td>\r\n      <td colspan=\"2\" class=\"lbl\">Invoice Number</td>\r\n      <td colspan=\"3\" class=\"val\" style=\"font-size:12.5px\">{{doc.name}}</td>\r\n    </tr>\r\n    <!-- Row 2 -->\r\n    <tr>\r\n      <td colspan=\"3\" class=\"addr\" style=\"font-size:13px\">{{ doc.customer_name or '' }}</td>\r\n      <td colspan=\"2\" class=\"lbl\">Date</td>\r\n      <td colspan=\"3\" class=\"val\">{{ frappe.utils.formatdate(doc.posting_date, \"dd-mm-yyyy\") }}</td>\r\n    </tr>\r\n    <!-- Row 3-4 -->\r\n    <tr>\r\n      <td colspan=\"3\" rowspan=\"3\" class=\"addr\" style=\"font-size:13px\">\r\n        {{doc.address_display or ''}}\r\n      </td>\r\n      <td colspan=\"2\" class=\"lbl\">Delivery Note</td>\r\n      <td colspan=\"3\" class=\"val\">{{doc.items[0].delivery_note or ''}}</td>\r\n    </tr>\r\n    <tr>\r\n      <td colspan=\"2\" class=\"lbl\">Ref / LPO No</td>\r\n      <td colspan=\"3\" class=\"val\"></td>\r\n    </tr>\r\n    <!-- Row 5 -->\r\n    <tr>\r\n     \r\n      <td colspan=\"2\" class=\"lbl\">Order Ref. No..</td>\r\n      <td colspan=\"3\" class=\"val n\"></td>\r\n    </tr>\r\n\r\n    <!-- Sales executive / project / payment days -->\r\n    <tr>\r\n      <td colspan=\"2\" class=\"c\" style=\"font-size:11.5px\"><b>SALES EXECUTIVE</b></td>\r\n      <td style=\"font-size:11.5px; padding-left:14px\"><b>PROJECT NAME</b></td>\r\n      <td colspan=\"4\" style=\"border-top:1px solid #c8c8c8\"></td>\r\n      <td class=\"r\" style=\"font-size:11px\"><b>PAYMENT DAYS</b></td>\r\n    </tr>\r\n\r\n    <tr>\r\n      <td colspan=\"2\"> {{doc.sales_partner or ''}}</td>\r\n      <td>{{doc.project or ''}}</td>\r\n      <td colspan=\"4\"></td>\r\n      <td>{{ frappe.utils.date_diff(doc.due_date, doc.posting_date) }}</td>\r\n    </tr>\r\n\r\n    <!-- Items header -->\r\n    <tr>\r\n      <th class=\"grey\">SR</th>\r\n      <th class=\"grey\">CODE</th>\r\n      <th class=\"grey\">DESCRIPTION</th>\r\n      <th class=\"grey\">QUANTITY</th>\r\n      <th class=\"grey\">UNIT PRICE</th>\r\n      <th class=\"grey\">UOM</th>\r\n      <th class=\"grey\">DISCOUNT</th>\r\n      <th class=\"grey\">TOTAL</th>\r\n    </tr>\r\n    <!-- Items -->\r\n    {% for i in doc.items %}\r\n    <tr class=\"items\">\r\n      <td class=\"r\">{{i.idx}}</td>\r\n      <td>{{i.item_code}}</td>\r\n      <td>{{i.description}}</td>\r\n      <td class=\"r\">{{i.qty}}</td>\r\n      <td class=\"r\" >{{i.rate}}</td>\r\n      <td >{{i.uom}}</td>\r\n      <td class=\"r\">{{i.discount_amount or ''}}</td>\r\n      <td class=\"r\">{{i.amount}}</td>\r\n    </tr>\r\n    {% endfor %}\r\n    \r\n    <!-- Total in QAR -->\r\n    <tr class=\"grey items\">\r\n      <td colspan=\"2\" style=\"font-size:11.5px\">Total In QAR</td>\r\n      <td style=\"font-size:11.5px\">ROE : {{doc.conversion_rate or ''}}</td>\r\n      <td colspan=\"3\"></td>\r\n      <td class=\"r\">-</td>\r\n      <td class=\"r b\">{{doc.net_total}}</td>\r\n    </tr>\r\n\r\n    <!-- Blank rows -->\r\n    <tr><td colspan=\"8\" style=\"height:26px\"></td></tr>\r\n    <tr>\r\n      <td colspan=\"7\" style=\"height:26px\"></td>\r\n      <td class=\"r\">-</td>\r\n    </tr>\r\n\r\n    <!-- Amount in words -->\r\n    <tr class=\"words\">\r\n      <td colspan=\"7\">{{doc.base_in_words}}</td>\r\n      <td class=\"r\">{{doc.net_total}}</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!--<div class=\"kp-spacer\"></div>-->\r\n    <br><br>\r\n  <!-- ================= FOOTER ================= -->\r\n  <div class=\"kp-note\">\r\n    Any discrepancy in the supply related to this invoice should be notified in writing within 7 days from the date of receipt . Failing which , the amount specified will be considered payable.\r\n  </div>\r\n  <div class=\"kp-terms\">Payment Terms : {{doc.payment_terms_template or ''}}</div>\r\n\r\n  <!--<div class=\"kp-spacer\"></div>-->\r\n  <br><br><br>\r\n    \r\n  <div class=\"kp-sign\">\r\n    <span>Accountant</span>\r\n    <span>Approved By</span>\r\n    <span>Received By</span>\r\n  </div>\r\n\r\n <div id=\"footer-html\" class=\"visible-pdf\">\r\n        <table style=\"width:100%; border-top:1px solid #999; border-collapse:collapse;\r\n                      font-family:Arial, Helvetica, sans-serif; font-size:9px; color:#111;\">\r\n            <tr>\r\n                <td style=\"width:50%; text-align:left; padding-top:3px;\">\r\n                    Page <span class=\"page\"></span> of <span class=\"topage\"></span>\r\n                </td>\r\n                <td style=\"width:50%; text-align:right; padding-top:3px;\">\r\n                    Generated By {{ doc.owner }}\r\n                    &nbsp;&nbsp;\r\n                    {{ frappe.utils.format_datetime(doc.creation, \"dd-mm-yyyy HH:mm:ss\") }}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n</div>",
