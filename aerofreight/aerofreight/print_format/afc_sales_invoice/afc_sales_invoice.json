{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-10-14 19:51:10.717261",
 "css": "",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<meta name=\"pdfkit-margin-top\" content=\"5mm\">\r\n<meta name=\"pdfkit-margin-bottom\" content=\"15mm\">\r\n<meta name=\"pdfkit-margin-left\" content=\"1mm\">\r\n<meta name=\"pdfkit-margin-right\" content=\"1mm\">\r\n<style>\r\n/* =========================================================\r\n   KOMPASS EXACT BLUE A4 SALES INVOICE\r\n   ========================================================= */\r\n@page {\r\n    size: A4;\r\n    margin: 0;\r\n}\r\n\r\nhtml, body {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    width: 100% !important;\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 9.5px;\r\n    color: #111;\r\n    line-height: 1.2;\r\n}\r\n\r\n.print-format {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    max-width: 100% !important;\r\n}\r\n\r\n.si-page,\r\n#footer-html {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    padding-left: 20px !important;\r\n    padding-right: 20px !important;\r\n}\r\n/* =========================================================\r\n   GENERAL\r\n   ========================================================= */\r\n\r\n.si-page table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border-spacing: 0;\r\n}\r\n\r\n.si-page td,\r\n.si-page th {\r\n    vertical-align: top;\r\n}\r\n\r\n.text-left { text-align: left; }\r\n.text-center { text-align: center; }\r\n.text-right { text-align: right; }\r\n\r\np { margin: 0 0 2px 0; }\r\nimg { max-width: 100%; }\r\n\r\n/* =========================================================\r\n   LETTER HEAD / LOGO / TITLE\r\n   ========================================================= */\r\n\r\n/* Top space + side space for letterhead */\r\n.letter-head {\r\n    -webkit-box-sizing: border-box !important;\r\n    box-sizing: border-box !important;\r\n    width: 100% !important;\r\n    height: auto !important;\r\n    margin: 0 !important;\r\n    padding: 30px 20px 0 20px !important;   /* top | right | bottom | left */\r\n}\r\n\r\n.letter-head img {\r\n    display: block;\r\n    width: 100% !important;\r\n    height: 130px !important;\r\n}\r\n\r\n.invoice-title {\r\n    text-align: center;\r\n    font-size: 14px;\r\n    font-weight: 500;\r\n    letter-spacing: 0.5px;\r\n    margin: 4px 0 3px 0;\r\n    color: #000;\r\n}\r\n\r\n/* =========================================================\r\n   TOP HEADER TABLE (BILL TO & INVOICE DETAILS)\r\n   ========================================================= */\r\n\r\n.top-table {\r\n    width: 100%;\r\n    border: 1px solid #999;\r\n    margin-bottom: 0px;\r\n}\r\n\r\n.top-table td {\r\n    padding: 0;\r\n}\r\n\r\n.bill-to-col {\r\n    width: 60%;\r\n    border-right: 1px solid #999;\r\n}\r\n\r\n.bill-to-title {\r\n    background-color: #1a8cff;\r\n    color: #fff;\r\n    font-weight: 700;\r\n    font-size: 9.5px;\r\n    padding: 3px 6px;\r\n}\r\n\r\n.bill-to-body {\r\n    padding: 5px 6px;\r\n    font-size: 9px;\r\n    line-height: 1.25;\r\n}\r\n\r\n.meta-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n}\r\n\r\n.meta-table td {\r\n    border-bottom: 1px solid #bbb;\r\n    padding: 2.5px 6px;\r\n    font-size: 8.5px;\r\n    line-height: 1.15;\r\n}\r\n\r\n.meta-table tr:last-child td {\r\n    border-bottom: none;\r\n}\r\n\r\n.meta-lbl {\r\n    width: 38%;\r\n    font-weight: 600;\r\n    color: #222;\r\n    border-right: 1px solid #bbb;\r\n}\r\n\r\n.meta-val {\r\n    width: 62%;\r\n    font-weight: 700;\r\n    color: #000;\r\n}\r\n\r\n/* =========================================================\r\n   SUB-META TABLE (SALES EXEC / PROJECT / PAYMENT DAYS)\r\n   ========================================================= */\r\n\r\n.sub-meta-table {\r\n    width: 100%;\r\n    border: 1px solid #999;\r\n    border-top: none;\r\n    margin-bottom: 0px;\r\n}\r\n\r\n.sub-meta-table th {\r\n    border-bottom: 1px solid #999;\r\n    border-right: 1px solid #999;\r\n    padding: 2.5px 5px;\r\n    font-size: 8px;\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    background: #fff;\r\n}\r\n\r\n.sub-meta-table td {\r\n    border-right: 1px solid #999;\r\n    padding: 3px 5px;\r\n    font-size: 8.5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.sub-meta-table th:last-child,\r\n.sub-meta-table td:last-child {\r\n    border-right: none;\r\n}\r\n\r\n/* =========================================================\r\n   ITEMS TABLE (KOMPASS BLUE HEADER)\r\n   ========================================================= */\r\n\r\n.items-table {\r\n    width: 100%;\r\n    border: 1px solid #999;\r\n    border-top: none;\r\n    margin: 0;\r\n    page-break-inside: auto;\r\n}\r\n\r\n.items-table thead {\r\n    display: table-header-group;\r\n}\r\n\r\n.items-table tr {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.items-table th {\r\n    background-color: #1a8cff;\r\n    color: #fff;\r\n    border: 1px solid #1a8cff;\r\n    border-right: 1px solid #66b3ff;\r\n    padding: 3px 4px;\r\n    font-size: 8px;\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    line-height: 1.05;\r\n}\r\n\r\n.items-table th:last-child {\r\n    border-right: 1px solid #1a8cff;\r\n}\r\n\r\n.items-table td {\r\n    border: 1px solid #ccc;\r\n    padding: 3px 4px;\r\n    font-size: 8.5px;\r\n    line-height: 1.1;\r\n}\r\n\r\n/* =========================================================\r\n   GENERATED / PREPARED BY\r\n   ========================================================= */\r\n\r\n.si-page > div[style*=\"margin-top: 15px\"] {\r\n    font-size: 9.5px !important;\r\n    line-height: 1.3;\r\n}\r\n\r\n.si-page > div[style*=\"margin-top: 15px\"] b {\r\n    font-weight: 700 !important;\r\n}\r\n/* Generated / Prepared */\r\n.si-page > div[style*=\"margin-top: 15px\"] {\r\n    font-size: 9.5px !important;\r\n}\r\n\r\n/* =========================================================\r\n   TOTALS & WORDS STRIP\r\n   ========================================================= */\r\n\r\n.totals-strip {\r\n    width: 100%;\r\n    border: 1px solid #999;\r\n    border-top: none;\r\n    background-color: #c7ccd1;\r\n    font-weight: 700;\r\n    font-size: 8.5px;\r\n}\r\n\r\n.totals-strip td {\r\n    padding: 3px 5px;\r\n    vertical-align: middle;\r\n}\r\n\r\n.blank-subtotal-row {\r\n    width: 100%;\r\n    border: 1px solid #999;\r\n    border-top: none;\r\n    height: 14px;\r\n}\r\n\r\n.blank-subtotal-row td {\r\n    padding: 2px 5px;\r\n    font-size: 8.5px;\r\n}\r\n\r\n.words-row-table {\r\n    width: 100%;\r\n    border: 1px solid #999;\r\n    border-top: none;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.words-row-table td {\r\n    padding: 3px 5px;\r\n    font-size: 8.5px;\r\n    line-height: 1.15;\r\n}\r\n\r\n/* =========================================================\r\n   BANK ACCOUNT DETAILS TABLE\r\n   ========================================================= */\r\n\r\n.bank-details-table {\r\n    width: 100%;\r\n    border: 1px solid #999;\r\n    margin-top: 6px;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.bank-details-header {\r\n    background-color: #1a8cff;\r\n    color: #fff;\r\n    font-weight: 700;\r\n    font-size: 8.5px;\r\n    padding: 2.5px 6px;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.bank-details-table td {\r\n    border: 1px solid #ccc;\r\n    padding: 2.5px 5px;\r\n    font-size: 8px;\r\n    line-height: 1.15;\r\n}\r\n\r\n.bank-lbl {\r\n    width: 15%;\r\n    font-weight: 700;\r\n    background-color: #f7f7f7;\r\n    color: #222;\r\n}\r\n\r\n.bank-val {\r\n    width: 35%;\r\n    color: #000;\r\n}\r\n\r\n/* =========================================================\r\n   BOTTOM NOTICE, PAYMENT TERMS & SIGNATURE BLOCK\r\n   ========================================================= */\r\n\r\n.bottom-container {\r\n    margin-top: 15px;\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.discrepancy-notice {\r\n    font-size: 8px;\r\n    color: #111;\r\n    margin-bottom: 8px;\r\n    line-height: 1.25;\r\n}\r\n\r\n.payment-terms-line {\r\n    font-size: 8.5px;\r\n    font-weight: 700;\r\n    margin-bottom: 35px;\r\n    color: #111;\r\n}\r\n\r\n.bottom-signatures {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n}\r\n\r\n.bottom-signatures td {\r\n    text-align: center;\r\n    vertical-align: bottom;\r\n    padding: 0 10px;\r\n}\r\n\r\n.signature-space {\r\n    height: 25px;\r\n    margin-bottom: 4px;\r\n}\r\n\r\n.signature-label {\r\n    font-size: 9px;\r\n    font-weight: 700;\r\n    color: #111;\r\n}\r\n\r\n/* =========================================================\r\n   PRINT / PDF SAFETY\r\n   ========================================================= */\r\n\r\ntable, tr, td, th {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.top-table,\r\n.sub-meta-table,\r\n.items-table,\r\n.totals-strip,\r\n.words-row-table,\r\n.bank-details-table,\r\n.bottom-container {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n/* =========================================================\r\n   APPROVAL / SIGNATURE\r\n   PDF-SAFE HORIZONTAL TABLE\r\n   ========================================================= */\r\n\r\n.approval {\r\n    width: 100%;\r\n\r\n    margin-top: 4px;\r\n\r\n    border-top: 1px solid #555;\r\n\r\n    padding-top: 3px;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures {\r\n    width: 100% !important;\r\n\r\n    border-collapse: collapse !important;\r\n    border-spacing: 0 !important;\r\n\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n\r\n    table-layout: auto !important;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures tr {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n.approval-signatures td {\r\n    text-align: center !important;\r\n\r\n    vertical-align: bottom !important;\r\n\r\n    border: none !important;\r\n\r\n    padding: 0 8px 0 8px !important;\r\n\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   SIGNATURE IMAGE\r\n   ========================================================= */\r\n\r\n.approval-signature-image {\r\n    height: 32px;\r\n\r\n    width: 100%;\r\n\r\n    text-align: center;\r\n\r\n    vertical-align: bottom;\r\n\r\n    margin-bottom: 2px;\r\n\r\n    overflow: hidden;\r\n}\r\n\r\n.approval-signature-image img {\r\n    display: inline-block;\r\n\r\n    max-width: 105px !important;\r\n\r\n    max-height: 30px !important;\r\n\r\n    width: auto !important;\r\n\r\n    height: auto !important;\r\n\r\n    object-fit: contain;\r\n}\r\n.approval-signature-image,\r\n.approval-signature-image * {\r\n    overflow: hidden !important;\r\n    max-height: 30px !important;\r\n}\r\n\r\n.approval-signature-image {\r\n    scrollbar-width: none;       /* Firefox */\r\n    -ms-overflow-style: none;    /* old Edge/IE */\r\n}\r\n\r\n.approval-signature-image::-webkit-scrollbar {\r\n    display: none;               /* WebKit / wkhtmltopdf */\r\n}\r\n\r\n\r\n/* =========================================================\r\n   APPROVER NAME\r\n   ========================================================= */\r\n\r\n.approval-user-name {\r\n    font-size: 8.5px;\r\n\r\n    font-weight: 700;\r\n\r\n    color: #222;\r\n\r\n    border-top: 1px solid #777;\r\n\r\n    padding-top: 2px;\r\n\r\n    line-height: 1.05;\r\n\r\n    white-space: normal;\r\n\r\n    word-wrap: break-word;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   APPROVER EMAIL\r\n   ========================================================= */\r\n\r\n.approval-user-email {\r\n    font-size: 7.5px;\r\n\r\n    color: #666;\r\n\r\n    margin-top: 1px;\r\n\r\n    line-height: 1;\r\n\r\n    word-break: break-all;\r\n\r\n    white-space: normal;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   PRINT / PDF SAFETY\r\n   ========================================================= */\r\n\r\ntable,\r\ntr,\r\ntd,\r\nth {\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.approval,\r\n.approval-signatures,\r\n.approval-signatures tr,\r\n.approval-signatures td,\r\n.details-table,\r\n.words-table,\r\n.totals-wrapper,\r\n.terms {\r\n    page-break-inside: avoid !important;\r\n    break-inside: avoid !important;\r\n}\r\n\r\n\r\n</style>\r\n\r\n<!-- =======================================================\r\n     LETTER HEAD / LOGO\r\n     ======================================================= -->\r\n\r\n{% if letter_head and not no_letterhead %}\r\n<!--<div class=\"letter-head\">-->\r\n<div>\r\n    {{ letter_head }}\r\n</div>\r\n{% endif %}\r\n\r\n<div class=\"si-page\">\r\n\r\n    <!-- ===================================================\r\n         STATUS DRAFT / CANCELLED\r\n         =================================================== -->\r\n\r\n    <div class=\"invoice-title\">SALES INVOICE<br>{{doc.status}}</div>\r\n\r\n    <!-- ===================================================\r\n         TOP TABLE: BILL TO & INVOICE DETAILS\r\n         =================================================== -->\r\n\r\n    {# Dynamic Address Resolution #}\r\n    {% set customer_addr = doc.address_display %}\r\n    {% if not customer_addr and doc.customer_address %}\r\n        {% set customer_addr = frappe.db.get_value(\"Address\", doc.customer_address, \"display\") %}\r\n    {% endif %}\r\n\r\n    {# Aggregate linked Delivery Notes #}\r\n    {% set dn_list = [] %}\r\n    {% for item in doc.items %}\r\n        {% if item.delivery_note and item.delivery_note not in dn_list %}\r\n            {% set _ = dn_list.append(item.delivery_note) %}\r\n        {% endif %}\r\n    {% endfor %}\r\n\r\n    {# Aggregate linked Sales Orders #}\r\n    {% set so_list = [] %}\r\n    {% for item in doc.items %}\r\n        {% if item.sales_order and item.sales_order not in so_list %}\r\n            {% set _ = so_list.append(item.sales_order) %}\r\n        {% endif %}\r\n    {% endfor %}\r\n\r\n    <table class=\"top-table\">\r\n        <tr>\r\n            <td class=\"bill-to-col\">\r\n                <div class=\"bill-to-title\">BILL TO :</div>\r\n                <div class=\"bill-to-body\">\r\n                    <b>{{ doc.customer_name or '' }}</b><br>\r\n                    {% if customer_addr %}\r\n                        {{ customer_addr | safe }}\r\n                    {% elif doc.customer %}\r\n                        {{ doc.customer }}\r\n                    {% endif %}\r\n                </div>\r\n            </td>\r\n\r\n            <td style=\"width: 40%;\">\r\n                <table class=\"meta-table\">\r\n                    <tr>\r\n                        <td class=\"meta-lbl\">Invoice Number</td>\r\n                        <td class=\"meta-val\">{{ doc.name }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td class=\"meta-lbl\">Date</td>\r\n                        <td class=\"meta-val\">{{ frappe.utils.format_date(doc.posting_date) }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td class=\"meta-lbl\">Delivery Note</td>\r\n                        <td class=\"meta-val\">\r\n                            {{ dn_list | join(', ') if dn_list else (doc.delivery_note or '') }}\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td class=\"meta-lbl\">Ref / LPO No</td>\r\n                        <td class=\"meta-val\">{{ doc.po_no or '' }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td class=\"meta-lbl\">Order Ref. No..</td>\r\n                        <td class=\"meta-val\">\r\n                            {% if so_list %}\r\n                                {{ so_list | join(', ') }}{% if doc.po_no %},{% endif %}\r\n                            {% elif doc.po_no %}\r\n                                {{ doc.po_no }}\r\n                            {% endif %}\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         SUB-META TABLE: SALES EXEC, PROJECT & PAYMENT DAYS\r\n         =================================================== -->\r\n\r\n    {# Calculate credit period / payment days #}\r\n    {% set payment_days = '' %}\r\n    {% if doc.due_date and doc.posting_date %}\r\n        {% set payment_days = frappe.utils.date_diff(doc.due_date, doc.posting_date) %}\r\n    {% endif %}\r\n\r\n    {# Sales Person resolution #}\r\n    {% set sales_person_name = '' %}\r\n    {% if doc.sales_team and doc.sales_team | length > 0 %}\r\n        {% set sales_person_name = doc.sales_team[0].sales_person %}\r\n    {% elif doc.custom_sales_executive %}\r\n        {% set sales_person_name = doc.custom_sales_executive %}\r\n    {% endif %}\r\n\r\n    <table class=\"sub-meta-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width: 25%;\" class=\"text-left\">SALES EXECUTIVE</th>\r\n                <th style=\"width: 55%;\" class=\"text-left\">PROJECT NAME</th>\r\n                <th style=\"width: 20%;\" class=\"text-right\">PAYMENT DAYS</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            <tr>\r\n                <td>{{ sales_person_name or '' }}</td>\r\n                <td>\r\n                    {% set project_name = frappe.db.get_value(\"Project\", doc.project, \"project_name\") if doc.project else None %}\r\n                    {{ doc.project or '' }}{% if doc.project and project_name %} - {{ project_name }}{% endif %}\r\n                </td>\r\n                <td class=\"text-right\"><b>{{ payment_days if payment_days != '' else '' }}</b></td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         ITEMS TABLE\r\n         =================================================== -->\r\n\r\n    <table class=\"items-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width: 5%;\" class=\"text-center\">SR NO</th>\r\n                <th style=\"width: 14%;\" class=\"text-left\">CODE</th>\r\n                <th style=\"width: 37%;\" class=\"text-left\">DESCRIPTION</th>\r\n                <th style=\"width: 10%;\" class=\"text-right\">QUANTITY</th>\r\n                <th style=\"width: 11%;\" class=\"text-right\">UNIT PRICE</th>\r\n                <th style=\"width: 6%;\" class=\"text-center\">UOM</th>\r\n                <th style=\"width: 8%;\" class=\"text-right\">DISCOUNT</th>\r\n                <th style=\"width: 9%;\" class=\"text-right\">TOTAL</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for item in doc.items %}\r\n            <tr>\r\n                <td class=\"text-center\">{{ loop.index }}</td>\r\n                <td><b>{{ item.item_code or '' }}</b></td>\r\n                <td>\r\n                    {{ item.item_name or '' }}\r\n                    {% if item.description and item.description != item.item_name %}\r\n                        <div style=\"font-size: 7.5px; color: #444;\">{{ item.description | striptags }}</div>\r\n                    {% endif %}\r\n                </td>\r\n                <td class=\"text-right\">{{ item.get_formatted(\"qty\", 0) }}</td>\r\n                <td class=\"text-right\">{{ item.get_formatted(\"rate\", doc) }}</td>\r\n                <td class=\"text-center\">{{ item.uom or '' }}</td>\r\n                <td class=\"text-right\">\r\n                    {% if item.discount_amount and item.discount_amount > 0 %}\r\n                        {{ item.get_formatted(\"discount_amount\", doc) }}\r\n                    {% elif item.discount_percentage and item.discount_percentage > 0 %}\r\n                        {{ item.discount_percentage }}%\r\n                    {% else %}\r\n                        -\r\n                    {% endif %}\r\n                </td>\r\n                <td class=\"text-right\"><b>{{ item.get_formatted(\"amount\", doc) }}</b></td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         TOTAL IN CURRENCY / ROE BAR\r\n         =================================================== -->\r\n\r\n    <table class=\"totals-strip\">\r\n        <tr>\r\n            <td style=\"width: 25%;\" class=\"text-left\">\r\n                Total In {{ doc.currency }}\r\n            </td>\r\n            <td style=\"width: 45%;\" class=\"text-left\">\r\n                ROE : {{ doc.conversion_rate or 1.0000 }}\r\n            </td>\r\n            <td style=\"width: 15%;\" class=\"text-right\">\r\n                {% if doc.discount_amount and doc.discount_amount > 0 %}\r\n                    -{{ doc.get_formatted(\"discount_amount\", doc) }}\r\n                {% else %}\r\n                    -\r\n                {% endif %}\r\n            </td>\r\n            <td style=\"width: 15%;\" class=\"text-right\">\r\n                {{ doc.get_formatted(\"net_total\", doc) or doc.get_formatted(\"total\", doc) }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         BLANK SUMMARY LINE\r\n         =================================================== -->\r\n\r\n    <table class=\"blank-subtotal-row\">\r\n        <tr>\r\n            <td style=\"width: 85%;\"></td>\r\n            <td style=\"width: 15%; text-align: right;\">-</td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         AMOUNT IN WORDS & GRAND TOTAL\r\n         =================================================== -->\r\n\r\n    <table class=\"words-row-table\">\r\n        <tr>\r\n            <td style=\"width: 82%;\">\r\n                <b>{{ doc.in_words or '' }}</b>\r\n            </td>\r\n            <td style=\"width: 18%; text-align: right;\">\r\n                <b style=\"font-size: 9.5px;\">{{ doc.get_formatted(\"grand_total\", doc) }}</b>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n    <!-- ===================================================\r\n         BANK DETAILS TABLE\r\n         =================================================== -->\r\n\r\n    {# Dynamic Resolution: Uses Company Bank Account / Custom Fields #}\r\n    {% set bank_account_name = doc.company_bank_account or frappe.db.get_value(\"Company\", doc.company, \"default_bank_account\") %}\r\n    {% set bank_data = frappe.db.get_value(\"Bank Account\", bank_account_name, [\"bank\", \"bank_account_no\", \"iban\", \"branch_code\"], as_dict=True) if bank_account_name else None %}\r\n    {% set swift_code = frappe.db.get_value(\"Bank\", bank_data.bank, \"swift_number\") if (bank_data and bank_data.bank) else '' %}\r\n\r\n    <table class=\"bank-details-table\">\r\n        <tr>\r\n            <td colspan=\"4\" class=\"bank-details-header\">\r\n                Bank Account Details\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"bank-lbl\">Bank Name:</td>\r\n            <td class=\"bank-val\"><b>{{ doc.custom_bank_name or (bank_data.bank if bank_data else 'Commercial Bank of Qatar') }}</b></td>\r\n            <td class=\"bank-lbl\">Swift Code:</td>\r\n            <td class=\"bank-val\"><b>{{ doc.custom_swift_code or swift_code or 'CBQAQAQA' }}</b></td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"bank-lbl\">Account No:</td>\r\n            <td class=\"bank-val\"><b>{{ doc.custom_account_no or (bank_data.bank_account_no if bank_data else '4010-117784-001') }}</b></td>\r\n            <td class=\"bank-lbl\">IBAN:</td>\r\n            <td class=\"bank-val\"><b>{{ doc.custom_iban or (bank_data.iban if bank_data else 'QA48CBQA000000004010117784001') }}</b></td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================================================\r\n         BOTTOM LEGAL NOTICE, PAYMENT TERMS & SIGNATURES\r\n         =================================================== -->\r\n\r\n    <div class=\"bottom-container\">\r\n        \r\n        <div class=\"discrepancy-notice\">\r\n            Any discrepancy in the supply related to this invoice should be notified in writing within 7 days from the date of receipt . Failing which , the amount specified will be considered payable.\r\n        </div>\r\n\r\n        <div class=\"payment-terms-line\">\r\n            Payment Terms : {{ doc.payment_terms_template or (payment_days ~ ' DAYS CREDIT FROM THE DATE OF INVOICE' if payment_days else '') }}\r\n        </div>\r\n     <!-- ===================================================\r\n         APPROVAL / SIGNATURE\r\n         =================================================== -->\r\n\r\n    <div class=\"approval\">\r\n\r\n        {% set all_approval = frappe.get_all(\r\n            \"Comment\",\r\n            filters={\r\n                \"comment_type\": \"Workflow\",\r\n                \"reference_doctype\": \"Sales Invoice\",\r\n                \"reference_name\": doc.name\r\n            },\r\n            fields=[\"comment_email\", \"creation\"],\r\n            order_by=\"creation asc\"\r\n        ) %}\r\n\r\n\r\n        <table class=\"approval-signatures\">\r\n\r\n            <tr>\r\n\r\n                {% for approval in all_approval %}\r\n\r\n                    {% if approval.comment_email %}\r\n\r\n                        {% set user_data = frappe.db.get_value(\r\n                            \"User\",\r\n                            approval.comment_email,\r\n                            [\r\n                                \"full_name\",\r\n                                \"email\",\r\n                                \"email_signature\"\r\n                            ],\r\n                            as_dict=True\r\n                        ) %}\r\n\r\n\r\n                        {% if user_data and user_data.email_signature %}\r\n\r\n                        <td>\r\n\r\n                            <div class=\"approval-signature-image\">\r\n                                {% if user_data.email_signature %}\r\n                                    {{ user_data.email_signature | safe }}\r\n                                {% endif %}\r\n                            </div>\r\n\r\n\r\n                            <div class=\"approval-user-name\">\r\n\r\n                                {{ user_data.full_name\r\n                                   or approval.comment_email }}\r\n\r\n                            </div>\r\n\r\n\r\n                            <div class=\"approval-user-email\">\r\n\r\n                                {{ user_data.email\r\n                                   or approval.comment_email }}\r\n\r\n                            </div>\r\n\r\n                        </td>\r\n\r\n                        {% endif %}\r\n\r\n                    {% endif %}\r\n\r\n                {% endfor %}\r\n\r\n            </tr>\r\n\r\n        </table>\r\n\r\n    </div>\r\n\r\n    </div>\r\n    </div>\r\n    <div id=\"footer-html\" class=\"visible-pdf\">\r\n        <table style=\"width:100%; border-top:1px solid #999; border-collapse:collapse;\r\n                      font-family:Arial, Helvetica, sans-serif; font-size:9px; color:#111;\">\r\n            <tr>\r\n                <td style=\"width:50%; text-align:left; padding-top:3px;\">\r\n                    Page <span class=\"page\"></span> of <span class=\"topage\"></span>\r\n                </td>\r\n                <td style=\"width:50%; text-align:right; padding-top:3px;\">\r\n                    Generated By {{ doc.owner }}\r\n                    &nbsp;&nbsp;\r\n                    {{ frappe.utils.format_datetime(doc.creation, \"dd-mm-yyyy HH:mm:ss\") }}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n",
